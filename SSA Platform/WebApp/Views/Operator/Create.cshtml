@using App.Domain.Entities.Enums
@model App.Application.DTO.AddOperatorRequest

@{
    ViewData["Title"] = "Add Operator";
}

<link rel="stylesheet" href="~/css/dashboard-ssa.css" asp-append-version="true" />

<div class="ssa-container">

    <div class="system-bar">
        <span class="status-dot"></span>
        OPERATOR REGISTRY | NEW OPERATOR
    </div>

    <div class="header">
        <div>
            <h3>Add Operator</h3>
            <small>Register a new space operator organisation</small>
        </div>
    </div>

    <div class="card admin-form">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Country" class="control-label"></label>
                <input id="country-search" type="text" class="form-control mb-1"
                       placeholder="Search country…" autocomplete="off" />
                <select asp-for="Country" id="country-select" class="form-select"
                        asp-items="@(ViewBag.Countries as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)">
                </select>
                <span asp-validation-for="Country" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="OperatorType" class="control-label"></label>
                <select asp-for="OperatorType" class="form-select"
                        asp-items="Html.GetEnumSelectList<EOperatorType>()">
                </select>
                <span asp-validation-for="OperatorType" class="text-danger"></span>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Create Operator</button>
            </div>
        </form>
    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            const search = document.getElementById('country-search');
            const select = document.getElementById('country-select');
            const allOptions = Array.from(select.options);

            search.addEventListener('input', function () {
                const q = this.value.toLowerCase();
                select.innerHTML = '';
                allOptions
                    .filter(o => o.text.toLowerCase().includes(q))
                    .forEach(o => select.appendChild(o));
            });
        })();
    </script>
}

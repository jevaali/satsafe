@model App.Application.DTO.MainListDTO

@{
    ViewData["Title"] = "Space Object Catalogue";
}

<link rel="stylesheet" href="~/css/dashboard-ssa.css" asp-append-version="true" />

<div class="ssa-container">

    <div class="system-bar">
        <span class="status-dot"></span>
        SPACE OBJECT CATALOGUE |
        @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss") UTC |
        @(Model.Satellites.Count + Model.Debris.Count) OBJECTS
    </div>

    <div class="header">
        <div>
            <h3>Space Object Catalogue</h3>
            <small>All tracked satellites and debris objects in the registry</small>
        </div>
        <div class="header-right">
            <span class="badge bg-primary">@Model.Satellites.Count Satellites</span>
            <span class="badge warning">@Model.Debris.Count Debris</span>
        </div>
    </div>

    <!-- Filter bar -->
    <div class="card mb-3 p-3">
        <div class="d-flex gap-3 align-items-center flex-wrap">
            <input type="text" id="searchBox" class="form-control w-auto"
                   placeholder="Search by name or NORAD ID..." />
            <select id="typeFilter" class="form-select w-auto">
                <option value="">All Types</option>
                <option value="Satellite">Satellite</option>
                <option value="Debris">Debris</option>
            </select>
        </div>
    </div>

    <!-- Table -->
    <div class="card">
        <table class="table table-hover mb-0" id="catalogueTable">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Name / NORAD ID</th>
                    <th>Operator / Size</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sat in Model.Satellites)
                {
                    <tr data-type="Satellite" data-name="@sat.Name.ToLower()">
                        <td><span class="badge bg-primary">Satellite</span></td>
                        <td><strong>@sat.Name</strong></td>
                        <td class="text-muted">@sat.Operator</td>
                    </tr>
                }
                @foreach (var debris in Model.Debris)
                {
                    <tr data-type="Debris" data-name="@debris.NoradId">
                        <td><span class="badge warning">Debris</span></td>
                        <td><span class="font-monospace">NORAD @debris.NoradId</span></td>
                        <td class="text-muted">@debris.SizeEstimate.ToString("F1") m</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!Model.Satellites.Any() && !Model.Debris.Any())
        {
            <div class="empty-state">
                <p>No objects in the catalogue.</p>
            </div>
        }
    </div>

</div>

@section Scripts {
    <script>
        const searchBox  = document.getElementById('searchBox');
        const typeFilter = document.getElementById('typeFilter');
        const rows       = document.querySelectorAll('#catalogueTable tbody tr');

        function filterObjects() {
            const search = searchBox.value.toLowerCase();
            const type   = typeFilter.value;

            rows.forEach(row => {
                const matchSearch = !search || row.dataset.name.includes(search);
                const matchType   = !type   || row.dataset.type === type;
                row.style.display = matchSearch && matchType ? '' : 'none';
            });
        }

        searchBox.addEventListener('input', filterObjects);
        typeFilter.addEventListener('change', filterObjects);
    </script>
}

@model App.Application.DTO.AddSatelliteRequest

<form asp-action="Create" method="post">
    <div>
        <label>Name</label>
        <input asp-for="Name" />
    </div>

    <div>
        <label>Launch Date</label>
        <input asp-for="LaunchDate" type="date" />
    </div>

    <div>
        <label>Operator Id</label>
        <input asp-for="OperatorId" />
    </div>

    <div>
        <label>Semi Major Axis</label>
        <input asp-for="SemiMajorAxis" />
    </div>

    <div>
        <label>Eccentricity</label>
        <input asp-for="Eccentricity" />
    </div>

    <div>
        <label>Inclination</label>
        <input asp-for="Inclination" />
    </div>

    <button type="submit">Create</button>
</form>
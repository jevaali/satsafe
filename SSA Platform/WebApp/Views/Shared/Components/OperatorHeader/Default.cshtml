@model OperatorHeaderViewModel

<li class="nav-item dropdown">
    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">My Satellites</a>
    <ul class="dropdown-menu">
        @foreach (var sat in Model.Satellites)
        {
            <li>
                <a class="dropdown-item" asp-area="Operator" asp-controller="Dashboard" asp-action="Satellites" asp-route-id="@sat.Id">
                    @sat.Name
                </a>
            </li>
        }
    </ul>
</li>
<li class="nav-item">
    <a class="nav-link text-dark" asp-area="Operator" asp-controller="Dashboard" asp-action="Conjunctions">Conjunction Events</a>
</li>
<li class="nav-item">
    <a class="nav-link text-dark" asp-area="Operator" asp-controller="Dashboard" asp-action="Alerts">Alerts</a>
</li>
<li class="nav-item">
    <a class="nav-link text-dark" asp-area="Operator" asp-controller="Settings" asp-action="Index">Operator Settings</a>
</li>
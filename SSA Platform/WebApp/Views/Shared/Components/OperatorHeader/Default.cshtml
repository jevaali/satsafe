@model OperatorHeaderViewModel

<li class="nav-item dropdown">
    <a class="nav-link" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">My Satellites</a>
    <ul class="dropdown-menu">
        <a class="dropdown-item" asp-area="Operator" asp-controller="Satellite" asp-action="Index">All My Satellites</a>
        @foreach (var sat in Model.Satellites)
        {
            <li>
                <a class="dropdown-item" asp-area="Operator" asp-controller="Satellite" asp-action="Details" asp-route-id="@sat.Id">
                    @sat.Name
                </a>
            </li>
        }
    </ul>
</li>
<li class="nav-item">
    <a class="nav-link text-dark" asp-area="" asp-controller="MainList" asp-action="Index">All Space Objects</a>
</li>
<li class="nav-item">
    <a class="nav-link text-dark" asp-area="Operator" asp-controller="Conjunctions" asp-action="Index">Conjunction Events</a>
</li>
<li class="nav-item">
    <a class="nav-link text-dark" asp-area="Operator" asp-controller="Alerts" asp-action="Index">
        Alerts
        @if (Model.UnacknowledgedAlertCount > 0)
        {
            <span class="badge bg-danger rounded-pill ms-1">@Model.UnacknowledgedAlertCount</span>
        }
    </a>
</li>
<li class="nav-item">
    <a class="nav-link text-dark" asp-area="Operator" asp-controller="Settings" asp-action="Index">Operator Settings</a>
</li><li class="nav-item">
    <a class="nav-link text-dark" asp-area="Sandbox" asp-controller="Sandbox" asp-action="Index">Sandbox</a>
</li>
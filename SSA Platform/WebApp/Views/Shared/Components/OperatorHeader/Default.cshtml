@model OperatorHeaderViewModel

<li class="nav-item dropdown">
    <a class="nav-link" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
        @App.Resources.Views.Header.MySatellites
    </a>
    <ul class="dropdown-menu">
        <a class="dropdown-item" asp-area="Operator" asp-controller="Satellite" asp-action="Index">
            @App.Resources.Views.Header.AllMySatellites
        </a>
        @foreach (var sat in Model.Satellites)
        {
            <li>
                <a class="dropdown-item" asp-area="Operator" asp-controller="Satellite" asp-action="Details" asp-route-id="@sat.Id">
                    @sat.Name
                </a>
            </li>
        }
    </ul>
</li>
<li class="nav-item">
    <a class="nav-link" asp-area="" asp-controller="MainList" asp-action="Index">
        @App.Resources.Views.Header.AllSpaceObjects
    </a>
</li>
<li class="nav-item">
    <a class="nav-link" asp-area="Operator" asp-controller="Conjunctions" asp-action="Index">
        @App.Resources.Views.Header.ConjunctionEvents
    </a>
</li>
<li class="nav-item">
    <a class="nav-link" asp-area="Operator" asp-controller="Alerts" asp-action="Index">
        @App.Resources.Views.Header.Alerts
        @if (Model.UnacknowledgedAlertCount > 0)
        {
            <span class="badge bg-danger rounded-pill ms-1">@Model.UnacknowledgedAlertCount</span>
        }
    </a>
</li>
<li class="nav-item">
    <a class="nav-link" asp-area="Operator" asp-controller="Settings" asp-action="Index">
        @App.Resources.Views.Header.OperatorSettings
    </a>
</li><li class="nav-item">
    <a class="nav-link" asp-area="" asp-controller="Sandbox" asp-action="Index">
        @App.Resources.Views.Header.Sandbox
    </a>
</li>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - SSA Platform</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/WebApp.styles.css" asp-append-version="true"/>
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">SSA Platform</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false">
                            Admin
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-area="Admin" asp-controller="Alert" asp-action="Index">Alert</a>
                            </li>
                            <li><a class="dropdown-item" asp-area="Admin" asp-controller="ConjunctionEvent" asp-action="Index">ConjunctionEvent</a>
                            </li>
                            <li><a class="dropdown-item" asp-area="Admin" asp-controller="NotificationSetting" asp-action="Index">NotificationSetting</a>
                            </li>
                            <li><a class="dropdown-item" asp-area="Admin" asp-controller="Operator" asp-action="Index">Operator</a>
                            </li>
                            <li><a class="dropdown-item" asp-area="Admin" asp-controller="Orbit" asp-action="Index">Orbit</a>
                            </li>
                            <li><a class="dropdown-item" asp-area="Admin" asp-controller="RiskAssessment" asp-action="Index">RiskAssessment</a>
                            </li>
                            <li><a class="dropdown-item" asp-area="Admin" asp-controller="Satellite" asp-action="Index">Satellite</a>
                            </li>
                            <li><a class="dropdown-item" asp-area="Admin" asp-controller="TleRecord" asp-action="Index">TleRecord</a>
                            </li>
                            <li><a class="dropdown-item" asp-area="Admin" asp-controller="UserOperator" asp-action="Index">UserOperator</a>
                            </li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false">
                            Operator
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-area="Operator" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                            </li>
                            <li><a class="dropdown-item" asp-area="Operator" asp-controller="Dashboard" asp-action="Satellites">Satellites</a>
                            </li>
                            <li><a class="dropdown-item" asp-area="Operator" asp-controller="Dashboard" asp-action="Conjunctions">Conjunctions</a>
                            </li>
                            <li><a class="dropdown-item" asp-area="Operator" asp-controller="Dashboard" asp-action="Alerts">Alerts</a>
                            </li>
                        </ul>
                    </li>
                </ul>
                <partial name="_LoginPartial"/>
            </div>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2026 - SSA Platform - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
    </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
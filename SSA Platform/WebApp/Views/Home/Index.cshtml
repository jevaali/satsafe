@model App.Application.DTO.HomeStatsDto
@{
    ViewData["Title"] = "Space Situational Awareness Platform";
}

<link rel="stylesheet" href="~/css/dashboard-ssa.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />

<div class="ssa-container">

    <div class="system-bar">
        <span class="status-dot"></span>
        @App.Resources.Views.Home.Home.SSAPLATFORM | @App.Resources.Views.Home.Home.SystemBar_Status |
        @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss") UTC |
        @Model.TotalSpaceObjects.ToString("N0") @App.Resources.Views.Home.Home.SystemBar_ObjectsTracked
    </div>

    <!-- Hero -->
    <div class="row align-items-center py-4 mb-2">
        <div class="col-lg-6">
            <p class="mb-2" style="font-family:'Share Tech Mono',monospace;font-size:0.72rem;letter-spacing:0.15em;color:#8a9bb0;text-transform:uppercase;">
                @App.Resources.Views.Home.Home.PageTitle
            </p>
            <h1 style="font-family:'Share Tech Mono',monospace;font-size:2.2rem;font-weight:700;color:#1a2332;line-height:1.2;margin-bottom:1rem;">
                @App.Resources.Views.Home.Home.Monitor. 
                @App.Resources.Views.Home.Home.Track.<br />
                @App.Resources.Views.Home.Home.StaySafe.
            </h1>
            <p class="mb-4" style="color:#5a6a7a;font-size:1rem;line-height:1.6;max-width:480px;">
                @App.Resources.Views.Home.Home.Section_PlatformCapabilities
            </p>
            <div class="d-flex gap-3 flex-wrap">
                <a asp-controller="Register" asp-action="User" class="btn-add">
                    <i class="bi bi-person-plus"></i>
                    @App.Resources.Views.Home.Home.Btn_GetStarted
                </a>
                <a asp-controller="Login" asp-action="Index" class="btn btn-outline-secondary">
                    @App.Resources.Views.Home.Home.Btn_SignIn
                </a>
            </div>
        </div>

        <div class="col-lg-6 mt-4 mt-lg-0">
            <div class="hero-orbit-wrap">
                <canvas id="heroOrbitCanvas"></canvas>
                <div class="hero-orbit-labels">
                    <div class="hero-orbit-label">
                        <div class="hero-orbit-dot" style="background:#4fc3f7;"></div>
                        @App.Resources.Views.Home.Home.ISSTYPELEO
                    </div>
                    <div class="hero-orbit-label">
                        <div class="hero-orbit-dot" style="background:#81c784;"></div>
                        @App.Resources.Views.Home.Home.SUN_SYNCSSO
                    </div>
                    <div class="hero-orbit-label">
                        <div class="hero-orbit-dot" style="background:#ffb74d;"></div>
                        @App.Resources.Views.Home.Home.POLARORBIT
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- KPI Strip -->
    <div class="kpi-bar mb-4">
        <div>
            <div style="font-size:0.68rem;letter-spacing:0.1em;color:#8a9bb0;text-transform:uppercase;margin-bottom:4px;">
                @App.Resources.Views.Home.Home.Kpi_TotalObjects
            </div>
            <strong style="font-family:'Share Tech Mono',monospace;font-size:1.5rem;color:#1a2332;">@Model.TotalSpaceObjects.ToString("N0")</strong>
        </div>
        <div>
            <div style="font-size:0.68rem;letter-spacing:0.1em;color:#8a9bb0;text-transform:uppercase;margin-bottom:4px;">
                @App.Resources.Views.Home.Home.Kpi_ActiveSatellites
            </div>
            <strong style="font-family:'Share Tech Mono',monospace;font-size:1.5rem;" class="green">@Model.ActiveSatellites.ToString("N0")</strong>
        </div>
        <div>
            <div style="font-size:0.68rem;letter-spacing:0.1em;color:#8a9bb0;text-transform:uppercase;margin-bottom:4px;">
                @App.Resources.Views.Home.Home.Kpi_DebrisObjects
            </div>
            <strong style="font-family:'Share Tech Mono',monospace;font-size:1.5rem;" class="yellow">@Model.DebrisObjects.ToString("N0")</strong>
        </div>
    </div>

    <!-- Top Satellites -->
    @if (Model.Satellites.Any())
    {
        <div class="header mt-2">
            <div><h3>
                @App.Resources.Views.Home.Home.Section_TopSatellites
            </h3></div>
            <div class="header-right">
                <a asp-controller="MainList" asp-action="Index" class="btn btn-outline-secondary btn-sm">@App.Resources.Views.Home.Home.Btn_ViewFullCatalogue</a>
            </div>
        </div>
        <div class="sat-grid mb-4">
            @foreach (var sat in Model.Satellites)
            {
                <div class="sat-tile">
                    <div>
                        <div class="sat-name" style="font-size:0.85rem;">@sat.Name</div>
                        <div class="sat-norad">@sat.Operator</div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Features -->
    <div class="header mt-2">
        <div><h3>
            @App.Resources.Views.Home.Home.PlatformCapabilities
        </h3></div>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card h-100">
                <h5><i class="bi bi-broadcast me-2 text-primary"></i>
                    @App.Resources.Views.Home.Home.RealTimeTracking</h5>
                <p class="text-muted small mb-0">
                    @App.Resources.Views.Home.Home.RealTimeTrackingText
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <h5><i class="bi bi-exclamation-triangle me-2 text-warning"></i>
                    @App.Resources.Views.Home.Home.ConjunctionAlerts</h5>
                <p class="text-muted small mb-0">
                    @App.Resources.Views.Home.Home.ConjunctionAlertsText
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <h5><i class="bi bi-building me-2 text-success"></i>
                    @App.Resources.Views.Home.Home.OperatorManagement</h5>
                <p class="text-muted small mb-0">
                    @App.Resources.Views.Home.Home.OperatorManagementText
                </p>
            </div>
        </div>
    </div>

    <!-- Registration -->
    <div class="header mt-2">
        <div><h3>@App.Resources.Views.Home.Home.JoinPlatform</h3></div>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card h-100">
                <h5>@App.Resources.Views.Home.Home.RegularUser</h5>
                <ul class="list-unstyled small mt-2 mb-3">
                    <li class="mb-1"><i class="bi bi-check-circle text-success me-2"></i>
                        @App.Resources.Views.Home.Home.ReguralUser1</li>
                    <li class="mb-1"><i class="bi bi-check-circle text-success me-2"></i>
                        @App.Resources.Views.Home.Home.ReguralUser2</li>
                    <li class="mb-1"><i class="bi bi-check-circle text-success me-2"></i>
                        @App.Resources.Views.Home.Home.ReguralUser3</li>
                </ul>
                <a asp-controller="Register" asp-action="User" class="btn btn-outline-primary w-100">
                    @App.Resources.Views.Home.Home.RegisterUser
                </a>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100">
                <h5>@App.Resources.Views.Home.Home.SpaceOperator</h5>
                <ul class="list-unstyled small mt-2 mb-3">
                    <li class="mb-1"><i class="bi bi-check-circle text-success me-2"></i>
                        @App.Resources.Views.Home.Home.SpaceOperator1</li>
                    <li class="mb-1"><i class="bi bi-check-circle text-success me-2"></i>
                        @App.Resources.Views.Home.Home.SpaceOperator2</li>
                    <li class="mb-1"><i class="bi bi-check-circle text-success me-2"></i>
                        @App.Resources.Views.Home.Home.SpaceOperator3</li>
                    <li class="mb-1"><i class="bi bi-check-circle text-success me-2"></i>
                        @App.Resources.Views.Home.Home.SpaceOperator4</li>
                </ul>
                <a asp-controller="Register" asp-action="Operator" class="btn-add w-100 justify-content-center">
                    <i class="bi bi-building"></i>
                    @App.Resources.Views.Home.Home.RegisterOperator
                </a>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/orbitalMechanics.js"></script>
    <script src="~/js/orbitRenderer.js"></script>
    <script src="~/js/orbits.js"></script>
}

@{
    ViewData["Title"] = "Privacy Policy";
}

<link rel="stylesheet" href="~/css/dashboard-ssa.css" asp-append-version="true" />

<div class="ssa-container">

    <div class="system-bar">
        <span class="status-dot"></span>
        @App.Resources.Views.Home.Privacy.SystemBar | @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss") UTC
    </div>

    <div class="header">
        <div>
            <h3>@App.Resources.Views.Home.Privacy.PageTitle</h3>
            <small>@App.Resources.Views.Home.Privacy.Subtitle</small>
        </div>
    </div>

    <div class="card">
        <p class="text-muted">@App.Resources.Views.Home.Privacy.Body</p>
    </div>

</div>

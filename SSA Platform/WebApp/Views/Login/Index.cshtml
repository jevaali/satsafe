@model WebApp.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = null;
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Sign In — SatSafe</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap"/>
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true"/>
</head>
<body>

<div class="auth-page">

    <!-- Left branding panel -->
    <div class="auth-brand-panel">
        <div>
            <a asp-controller="Home" asp-action="Index" class="auth-brand-logo">
                <i class="bi bi-broadcast-pin"></i> SatSafe
            </a>
            <div class="auth-brand-tagline">Space Situational Awareness Platform</div>
        </div>

        <div class="auth-brand-middle">
            <div class="auth-brand-headline">
                Monitor.<br/>Track.<br/><span>Stay Safe.</span>
            </div>
            <p class="auth-brand-desc">
                Real-time orbital tracking and conjunction analysis for satellite operators and space professionals.
            </p>
        </div>

        <div class="auth-brand-stats">
            <div class="auth-stat-row">
                <div class="auth-stat-dot green"></div>
                <span class="auth-stat-label">System operational</span>
            </div>
            <div class="auth-stat-row">
                <div class="auth-stat-dot blue"></div>
                <span class="auth-stat-label">Tracking active objects</span>
            </div>
            <div class="auth-stat-row">
                <div class="auth-stat-dot yellow"></div>
                <span class="auth-stat-label">24 / 7 conjunction screening</span>
            </div>
        </div>
    </div>

    <!-- Right form panel -->
    <div class="auth-form-panel">
        <div class="auth-form-wrap">

            <a asp-controller="Home" asp-action="Index" class="auth-back">
                <i class="bi bi-arrow-left"></i> Back to home
            </a>

            <div class="auth-card">
                <div class="auth-card-header">
                    <i class="bi bi-shield-lock"></i>
                    <h1 class="auth-card-title">Sign In</h1>
                </div>

                <div class="auth-card-body">
                    <form asp-controller="Login" asp-action="Index"
                          asp-route-returnUrl="@returnUrl" method="post">

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="auth-field">
                            <label asp-for="Email"></label>
                            <input asp-for="Email" class="form-control" autocomplete="username"
                                   placeholder="your@email.com"/>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="auth-field">
                            <label asp-for="Password"></label>
                            <input asp-for="Password" class="form-control" autocomplete="current-password"
                                   placeholder="••••••••"/>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="auth-check-row">
                            <input asp-for="RememberMe" class="form-check-input mt-0"/>
                            <label asp-for="RememberMe" class="mb-0">Remember me</label>
                        </div>

                        <button type="submit" class="auth-submit-btn">
                            <i class="bi bi-box-arrow-in-right"></i> Sign In
                        </button>
                    </form>
                </div>

                <div class="auth-card-footer">
                    Don't have an account?
                    <a asp-controller="Register" asp-action="User">Register as User</a>
                    &nbsp;or&nbsp;
                    <a asp-controller="Register" asp-action="Operator">Register as Operator</a>
                </div>
            </div>

        </div>
    </div>

</div>

<partial name="_ValidationScriptsPartial"/>
</body>
</html>

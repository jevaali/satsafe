@model WebApp.Areas.Operator.Models.SettingsViewModel
@using App.Domain.Entities.Enums

@{
    ViewData["Title"] = "Settings";
    var activeTab = TempData["ActiveTab"]?.ToString()
        ?? Context.Request.Query["activeTab"].FirstOrDefault()
        ?? (Model.ActivityFilterUserId.HasValue ? "activity" : "profile");
    var logs = Model.ActionLogs.ToList();
    var teamMembers = Model.Settings.Helpers.ToList();
    var op = Model.Settings.Operator;
    var helpers = Model.Settings.Helpers.ToList();
    var satellites = Model.Settings.Satellites.ToList();
}

<link rel="stylesheet" href="~/css/dashboard-ssa.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/settings.css" asp-append-version="true" />

<div class="ssa-container">

    <div class="system-bar">
        <span class="status-dot"></span>
        @App.Resources.Views.Operator.Settings.Index.SystemBar_Label | @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss") UTC
    </div>

    <div class="header">
        <div>
            <h3><i class="bi bi-gear-fill me-2"></i>@App.Resources.Views.Operator.Settings.Index.Header</h3>
            <small>@App.Resources.Views.Operator.Settings.Index.Header_Subtitle</small>
        </div>
        <div class="header-right">
            <span class="op-badge resolved"><i class="bi bi-circle-fill" style="font-size:0.45rem;"></i>@satellites.Count(s => s.Status == ESatelliteStatus.Active) @App.Resources.Views.Operator.Settings.Index.Badge_Active</span>
            <span class="op-badge low"><i class="bi bi-people-fill"></i>@helpers.Count @App.Resources.Views.Operator.Settings.Index.Badge_Team</span>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    }

    <!-- Tab navigation -->
    <ul class="nav nav-tabs settings-tabs mb-3" id="settingsTabs">
        <li class="nav-item">
            <a class="nav-link @(activeTab == "profile" ? "active" : "")"
               data-bs-toggle="tab" data-bs-target="#panel-profile" role="tab">
                <i class="bi bi-building me-1"></i> @App.Resources.Views.Operator.Settings.Index.Tab_Profile
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(activeTab == "satellites" ? "active" : "")"
               data-bs-toggle="tab" data-bs-target="#panel-satellites" role="tab">
                <i class="bi bi-rocket-takeoff me-1"></i> @App.Resources.Views.Operator.Settings.Index.Tab_Satellites
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(activeTab == "team" ? "active" : "")"
               data-bs-toggle="tab" data-bs-target="#panel-team" role="tab">
                <i class="bi bi-people-fill me-1"></i> @App.Resources.Views.Operator.Settings.Index.Tab_Team
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(activeTab == "notifications" ? "active" : "")"
               data-bs-toggle="tab" data-bs-target="#panel-notifications" role="tab">
                <i class="bi bi-bell-fill me-1"></i> @App.Resources.Views.Operator.Settings.Index.Tab_Notifications
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(activeTab == "activity" ? "active" : "")"
               data-bs-toggle="tab" data-bs-target="#panel-activity" role="tab">
                <i class="bi bi-clock-history me-1"></i> @App.Resources.Views.Operator.Settings.Index.Tab_Activity
                @if (logs.Any())
                {
                    <span class="badge bg-secondary ms-1" style="font-size:0.65rem;">@logs.Count</span>
                }
            </a>
        </li>
    </ul>

    <div class="tab-content">

        <!-- ── Operator Profile ── -->
        <div class="tab-pane fade @(activeTab == "profile" ? "show active" : "")" id="panel-profile" role="tabpanel">

            <div class="card mb-3">
                <div class="card-header">
                    <span><i class="bi bi-info-circle me-1"></i> @App.Resources.Views.Operator.Settings.Index.Profile_CurrentProfile</span>
                </div>
                <div class="info-grid p-2">
                    <div>
                        <div class="info-label">@App.Resources.Views.Operator.Settings.Index.Profile_OperatorName</div>
                        <div class="info-value">@op.Name</div>
                    </div>
                    <div>
                        <div class="info-label">@App.Resources.Views.Operator.Settings.Index.Profile_Country</div>
                        <div class="info-value">@op.CountryCode</div>
                    </div>
                    <div>
                        <div class="info-label">@App.Resources.Views.Operator.Settings.Index.Profile_Type</div>
                        <div class="info-value">@(op.OperatorType?.ToString() ?? "—")</div>
                    </div>
                    <div>
                        <div class="info-label">@App.Resources.Views.Operator.Settings.Index.Profile_OperatorId</div>
                        <div class="info-value mono">@op.Id</div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <span><i class="bi bi-pencil-square me-1"></i> @App.Resources.Views.Operator.Settings.Index.Profile_EditProfile</span>
                </div>
                <form asp-area="Operator" asp-controller="Settings" asp-action="UpdateOperator" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3 p-2">
                        <div class="col-md-6">
                            <label class="form-label" asp-for="OperatorForm.Name">@App.Resources.Views.Operator.Settings.Index.Profile_OperatorName</label>
                            <input asp-for="OperatorForm.Name" class="form-control" placeholder="e.g. National Space Agency" />
                            <span asp-validation-for="OperatorForm.Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" asp-for="OperatorForm.Country">@App.Resources.Views.Operator.Settings.Index.Profile_Country</label>
                            <input asp-for="OperatorForm.Country" class="form-control" placeholder="e.g. Estonia" />
                            <span asp-validation-for="OperatorForm.Country" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" asp-for="OperatorForm.OperatorType">@App.Resources.Views.Operator.Settings.Index.Profile_Type</label>
                            <select asp-for="OperatorForm.OperatorType" class="form-select"
                                    asp-items="Html.GetEnumSelectList<EOperatorType>()">
                                <option value="">— Select type —</option>
                            </select>
                        </div>
                    </div>
                    <div class="p-2 pt-0">
                        <button type="submit" class="btn-ssa-primary">
                            <i class="bi bi-floppy me-1"></i> @App.Resources.Views.Operator.Settings.Index.Profile_Btn_Save
                        </button>
                    </div>
                </form>
            </div>

        </div>

        <!-- ── Satellites ── -->
        <div class="tab-pane fade @(activeTab == "satellites" ? "show active" : "")" id="panel-satellites" role="tabpanel">

            <div class="card">
                <div class="card-header">
                    <span><i class="bi bi-rocket-takeoff me-1"></i> Registered Satellites (@satellites.Count)</span>
                    <a asp-area="Operator" asp-controller="Satellite" asp-action="Create" class="btn-add">
                        <i class="bi bi-plus-lg"></i> @App.Resources.Views.Operator.Settings.Index.Satellites_Btn_Add
                    </a>
                </div>

                @if (satellites.Any())
                {
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@App.Resources.Views.Operator.Settings.Index.Satellites_Col_Name</th>
                                <th>@App.Resources.Views.Operator.Settings.Index.Satellites_Col_Norad</th>
                                <th>@App.Resources.Views.Operator.Settings.Index.Satellites_Col_LaunchDate</th>
                                <th>@App.Resources.Views.Operator.Settings.Index.Satellites_Col_Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var sat in satellites.OrderBy(s => s.Name.ToString()))
                        {
                            <tr>
                                <td class="fw-semibold">@sat.Name</td>
                                <td class="font-monospace text-muted">#@sat.NoradId</td>
                                <td>@sat.LaunchDate.ToString("yyyy-MM-dd")</td>
                                <td><span class="badge-status @sat.Status.ToString().ToLower()">@sat.Status</span></td>
                                <td class="text-end">
                                    <a asp-area="Operator" asp-controller="Satellite" asp-action="Edit" asp-route-id="@sat.Id"
                                       class="btn-sat btn-sat-edit">
                                        <i class="bi bi-pencil"></i> @App.Resources.Views.Operator.Settings.Index.Satellites_Btn_Edit
                                    </a>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                else
                {
                <div class="empty-state">
                    <p>@App.Resources.Views.Operator.Settings.Index.Satellites_Empty</p>
                </div>
                }
            </div>

        </div>

        <!-- ── Team Access ── -->
        <div class="tab-pane fade @(activeTab == "team" ? "show active" : "")" id="panel-team" role="tabpanel">

            <div class="card mb-3">
                <div class="card-header">
                    <span><i class="bi bi-people me-1"></i> Team Members (@helpers.Count)</span>
                </div>

                @if (helpers.Any())
                {
                    <div class="px-3">
                    @foreach (var member in helpers)
                    {
                        <div class="helper-row">
                            <div class="d-flex align-items-center gap-3">
                                <div class="helper-avatar">@member.Initials</div>
                                <div>
                                    <div class="fw-semibold" style="font-size:0.88rem">
                                        @(string.IsNullOrWhiteSpace(member.FullName) ? member.Email : member.FullName)
                                    </div>
                                    <div class="text-muted" style="font-size:0.75rem">@(string.IsNullOrWhiteSpace(member.Email) ? "—" : member.Email)</div>
                                </div>
                            </div>
                            <form asp-area="Operator" asp-controller="Settings" asp-action="RemoveHelper"
                                  asp-route-id="@member.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-sat btn-sat-delete"
                                        onclick="return confirm('@App.Resources.Views.Operator.Settings.Index.Team_Confirm_Remove')">
                                    <i class="bi bi-person-x"></i> @App.Resources.Views.Operator.Settings.Index.Team_Btn_Remove
                                </button>
                            </form>
                        </div>
                    }
                    </div>
                }
                else
                {
                <div class="empty-state" style="padding:2rem">
                    <p>@App.Resources.Views.Operator.Settings.Index.Team_Empty</p>
                </div>
                }
            </div>

            <div class="card">
                <div class="card-header">
                    <span><i class="bi bi-person-plus me-1"></i> @App.Resources.Views.Operator.Settings.Index.Team_AddMember</span>
                </div>
                <p class="text-muted small px-3 pt-2 mb-2">
                    @App.Resources.Views.Operator.Settings.Index.Team_Desc
                </p>
                <form asp-area="Operator" asp-controller="Settings" asp-action="AddHelper" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-2 align-items-end px-3 pb-3">
                        <div class="col-md-7">
                            <label class="form-label" asp-for="HelperForm.Email">@App.Resources.Views.Operator.Settings.Index.Team_UserEmail</label>
                            <input asp-for="HelperForm.Email" type="email" class="form-control"
                                   placeholder="user@example.com" />
                            <span asp-validation-for="HelperForm.Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-5">
                            <button type="submit" class="btn btn-dark btn-sm w-100">
                                <i class="bi bi-person-plus me-1"></i> @App.Resources.Views.Operator.Settings.Index.Team_Btn_Grant
                            </button>
                        </div>
                    </div>
                </form>
            </div>

        </div>

        <!-- ── Activity Log ── -->
        <div class="tab-pane fade @(activeTab == "activity" ? "show active" : "")" id="panel-activity" role="tabpanel">

            <div class="card">
                <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <span><i class="bi bi-clock-history me-1"></i> Team Activity (@logs.Count)</span>
                    <form method="get" asp-area="Operator" asp-controller="Settings" asp-action="Index"
                          class="d-flex align-items-center gap-2">
                        <input type="hidden" name="activeTab" value="activity" />
                        <select name="filterUserId" class="form-select form-select-sm" style="width:auto;"
                                onchange="this.form.submit()">
                            <option value="">@App.Resources.Views.Operator.Settings.Index.Activity_AllMembers</option>
                            @foreach (var member in teamMembers)
                            {
                                if (Model.ActivityFilterUserId == member.Id)
                                {
                                    <option value="@member.Id" selected>
                                        @(string.IsNullOrWhiteSpace(member.FullName) ? member.Email : member.FullName)
                                    </option>
                                }
                                else
                                {
                                    <option value="@member.Id">
                                        @(string.IsNullOrWhiteSpace(member.FullName) ? member.Email : member.FullName)
                                    </option>
                                }
                            }
                        </select>
                        @if (Model.ActivityFilterUserId.HasValue)
                        {
                            <a asp-area="Operator" asp-controller="Settings" asp-action="Index"
                               class="btn btn-outline-secondary btn-sm">@App.Resources.Views.Operator.Settings.Index.Activity_Btn_Clear</a>
                        }
                    </form>
                </div>

                @if (logs.Any())
                {
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@App.Resources.Views.Operator.Settings.Index.Activity_Col_User</th>
                                <th>@App.Resources.Views.Operator.Settings.Index.Activity_Col_Action</th>
                                <th>@App.Resources.Views.Operator.Settings.Index.Activity_Col_DateTime</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var log in logs)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold" style="font-size:0.85rem;">
                                        @(string.IsNullOrWhiteSpace(log.UserName) ? log.UserEmail : log.UserName)
                                    </div>
                                    <div class="text-muted" style="font-size:0.72rem;">@log.UserEmail</div>
                                </td>
                                <td><span class="badge bg-dark">@log.Action</span></td>
                                <td class="font-monospace text-muted" style="font-size:0.8rem;">
                                    @log.OccurredAt.ToString("yyyy-MM-dd HH:mm:ss")
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty-state" style="padding:2rem">
                        <p>@App.Resources.Views.Operator.Settings.Index.Activity_Empty</p>
                    </div>
                }
            </div>

        </div>

        <!-- ── Notifications ── -->
        <div class="tab-pane fade @(activeTab == "notifications" ? "show active" : "")" id="panel-notifications" role="tabpanel">

            <div class="card">
                <div class="card-header">
                    <span><i class="bi bi-bell me-1"></i> @App.Resources.Views.Operator.Settings.Index.Tab_Notifications</span>
                </div>
                <form asp-area="Operator" asp-controller="Settings" asp-action="SaveNotifications" method="post">
                    @Html.AntiForgeryToken()
                    <div class="px-3 py-2">

                        <div class="mb-4">
                            <label class="form-label fw-semibold" asp-for="NotificationForm.ConjunctionThresholdKm">
                                @App.Resources.Views.Operator.Settings.Index.Notifications_ConjThreshold
                            </label>
                            <p class="text-muted small mb-2">
                                @App.Resources.Views.Operator.Settings.Index.Notifications_ConjThreshold_Desc
                            </p>
                            <div class="d-flex align-items-center gap-3" style="max-width:420px">
                                <input type="range" min="1" max="500" step="1"
                                       class="form-range flex-grow-1" id="conjunctionRange"
                                       value="@Model.NotificationForm.ConjunctionThresholdKm" />
                                <input asp-for="NotificationForm.ConjunctionThresholdKm"
                                       type="number" min="0.1" max="10000" step="0.1"
                                       class="form-control" style="width:110px" id="conjunctionNumber" />
                                <span class="text-muted small">km</span>
                            </div>
                            <span asp-validation-for="NotificationForm.ConjunctionThresholdKm" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold" asp-for="NotificationForm.AlertThresholdKm">
                                @App.Resources.Views.Operator.Settings.Index.Notifications_AlertThreshold
                            </label>
                            <p class="text-muted small mb-2">
                                @App.Resources.Views.Operator.Settings.Index.Notifications_AlertThreshold_Desc
                            </p>
                            <div class="d-flex align-items-center gap-3" style="max-width:420px">
                                <input type="range" min="0.1" max="100" step="0.1"
                                       class="form-range flex-grow-1" id="alertRange"
                                       value="@Model.NotificationForm.AlertThresholdKm" />
                                <input asp-for="NotificationForm.AlertThresholdKm"
                                       type="number" min="0.1" max="10000" step="0.1"
                                       class="form-control" style="width:110px" id="alertNumber" />
                                <span class="text-muted small">km</span>
                            </div>
                            <span asp-validation-for="NotificationForm.AlertThresholdKm" class="text-danger small"></span>
                        </div>

                        <div class="toggle-row">
                            <div>
                                <div class="fw-semibold"><i class="bi bi-envelope me-2"></i>@App.Resources.Views.Operator.Settings.Index.Notifications_Email</div>
                                <div class="text-muted small">@App.Resources.Views.Operator.Settings.Index.Notifications_Email_Desc</div>
                            </div>
                            <div class="form-check form-switch mb-0">
                                <input asp-for="NotificationForm.EmailEnabled"
                                       class="form-check-input" type="checkbox" role="switch" id="emailSwitch" />
                            </div>
                        </div>

                        <div class="toggle-row">
                            <div>
                                <div class="fw-semibold"><i class="bi bi-phone me-2"></i>@App.Resources.Views.Operator.Settings.Index.Notifications_Sms</div>
                                <div class="text-muted small">@App.Resources.Views.Operator.Settings.Index.Notifications_Sms_Desc</div>
                            </div>
                            <div class="form-check form-switch mb-0">
                                <input asp-for="NotificationForm.SmsEnabled"
                                       class="form-check-input" type="checkbox" role="switch" id="smsSwitch" />
                            </div>
                        </div>

                    </div>
                    <div class="px-3 pb-3">
                        <button type="submit" class="btn-ssa-primary">
                            <i class="bi bi-floppy me-1"></i> @App.Resources.Views.Operator.Settings.Index.Notifications_Btn_Save
                        </button>
                    </div>
                </form>
            </div>

        </div>

    </div>

</div>

<script>
    (function () {
        function syncSlider(rangeId, numberId) {
            var range = document.getElementById(rangeId);
            var num   = document.getElementById(numberId);
            if (!range || !num) return;
            range.addEventListener('input', function () { num.value  = this.value; });
            num.addEventListener('input',   function () { range.value = this.value; });
        }
        syncSlider('conjunctionRange', 'conjunctionNumber');
        syncSlider('alertRange',       'alertNumber');
    })();
</script>

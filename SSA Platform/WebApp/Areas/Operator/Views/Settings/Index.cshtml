@{
    ViewData["Title"] = "Settings";
}

<link rel="stylesheet" href="~/css/dashboard-ssa.css" asp-append-version="true" />

<div class="ssa-container">

    <div class="system-bar">
        <span class="status-dot"></span>
        OPERATOR SETTINGS | @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss") UTC
    </div>

    <div class="header">
        <div>
            <h3>Operator Settings</h3>
            <small>Manage your account, notifications, and preferences</small>
        </div>
    </div>

    <div class="card">
        <div class="empty-state">
            <p>Settings management is coming soon.</p>
        </div>
    </div>

</div>
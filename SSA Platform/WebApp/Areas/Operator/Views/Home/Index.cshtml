@using App.Domain.Entities
@using App.Domain.Entities.Enums
@model App.Application.DTO.OperatorDashboardDto

@{
    ViewData["Title"] = App.Resources.Views.Operator.Index.PageTitle;
}

<link rel="stylesheet" href="~/css/dashboard-ssa.css" asp-append-version="true" />

<script src="~/js/orbitalMechanics.js"></script>
<script src="~/js/orbitRenderer.js"></script>

<div class="ssa-container">

    <!-- SYSTEM STATUS BAR -->
    <div class="system-bar">
        <span class="status-dot"></span>
        SYSTEM: NOMINAL |
        @App.Resources.Views.Operator.Index.LASTUPDATE: @DateTime.UtcNow.ToString("HH:mm:ss") UTC |
        OPERATOR: @Model.OperatorName
    </div>

    <!-- HEADER -->
    <div class="header">
        <div>
            <h3>@Model.OperatorName</h3>
            <small>@App.Resources.Views.Operator.Index.Header_Subtitle</small>
        </div>

        <div class="header-right">
            <span class="badge danger">@Model.HighRiskConjunctions @App.Resources.Views.Operator.Index.Badge_HighRisk</span>
            <span class="badge warning">@Model.UnacknowledgedAlerts @App.Resources.Views.Operator.Index.Badge_Alerts</span>
        </div>
    </div>
    
    <!-- MAIN GRID -->
    <div class="grid">

        <!-- ORBIT VISUALIZATION -->
        <div class="card orbit-card">
            <h5>@App.Resources.Views.Operator.Index.Section_OrbitalView</h5>
            <div class="orbit-visualization">
                <canvas id="orbitCanvas"></canvas>
                <script>
                    OrbitRenderer.init({
                        canvasId: 'orbitCanvas',
                        satellites: @Html.Raw(Json.Serialize(Model.Satellites
                                        .Where(s => s.Orbit != null)
                                        .Select(s => new {
                                            id   = s.Id,
                                            name = s.Name.ToString(),
                                            orbit = new {
                                                semiMajorAxis     = s.Orbit!.Parameters.SemiMajorAxis,
                                                eccentricity      = s.Orbit!.Parameters.Eccentricity,
                                                inclination       = s.Orbit!.Parameters.Inclination,
                                                raan              = s.Orbit!.Parameters.RAAN,
                                                argumentOfPerigee = s.Orbit!.Parameters.ArgumentOfPerigee,
                                                meanAnomaly       = s.Orbit!.Parameters.MeanAnomaly
                                            }
                                        }))),
                    });
                </script>
            </div>
        </div>

        <!-- ALERT FEED -->
        <div class="card alert-card">
            <h5>@App.Resources.Views.Operator.Index.Section_LiveAlerts</h5>

            <div class="alert-feed">
                @foreach (var alert in Model.Alerts
                              .OrderBy(a => a.IsAcknowledged)
                              .ThenByDescending(a => a.CreatedAt)
                              .Take(6))
                {
                    <a asp-area="Operator" asp-controller="Alerts" asp-action="Details"
                       asp-route-id="@alert.Id"
                       class="alert-item @(alert.IsAcknowledged ? "ack" : "pending") text-decoration-none">
                        <div>
                            <strong>@alert.Severity</strong> - @alert.Message
                        </div>
                        <small>@alert.CreatedAt.ToString("HH:mm:ss")</small>
                    </a>
                }
            </div>
        </div>

        <!-- SATELLITES -->
        <div class="card satellites-card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@App.Resources.Views.Operator.Index.Section_Satellites</h5>
                <form asp-controller="Satellite" asp-action="Index" method="get" class="m-0">
                    <button type="submit" class="btn btn-primary btn-sm view-all-btn">
                        @App.Resources.Views.Operator.Index.Btn_ViewAll
                    </button>
                </form>
            </div>

            <div class="sat-grid">
                @foreach (var sat in Model.Satellites.Take(6))
                {
                    <a class="sat-tile" asp-action="Details" asp-controller="Satellite" asp-route-id="@sat.Id">
                        <div class="tile-header">
                            <h6 class="sat-name">@sat.Name</h6>
                            <small class="norad-id">@App.Resources.Views.Operator.Index.Label_Norad @sat.NoradId</small>
                        </div>

                        <span class="status @(sat.Status == ESatelliteStatus.Active ? "active" : "inactive")">
                            @sat.Status
                        </span>
                    </a>
                }
            </div>
        </div>

        <!-- CONJUNCTION TIMELINE -->
        <div class="card">
            <div class="card-header">
                <h5>@App.Resources.Views.Operator.Index.Section_ConjunctionTimeline</h5>
                <form asp-controller="Conjunctions" asp-action="Index" method="get" class="m-0">
                    <button type="submit" class="btn btn-primary btn-sm view-all-btn">
                        @App.Resources.Views.Operator.Index.Btn_ViewAll
                    </button>
                </form>
            </div>

            <div class="timeline">
                @foreach (var conj in Model.Conjunctions
                              .OrderByDescending(c => c.IsHighRisk())
                              .ThenBy(c => c.TimeOfClosestApproach)
                              .Take(6))
                {
                    <a asp-area="Operator" asp-controller="Conjunctions" asp-action="Details"
                       asp-route-id="@conj.Id"
                       class="timeline-item @(conj.IsHighRisk() ? "high" : "") text-decoration-none">
                        <div class="time">
                            @conj.TimeOfClosestApproach.ToString("HH:mm")
                        </div>
                        <div class="content">
                            @(conj.PrimaryObject switch {
                                Satellite s => s.Name.ToString(),
                                DebrisObject d => $"DEBRIS-{d.NoradId}",
                                _ => conj.PrimaryObjectId.ToString()
                            })
                            ↔
                            @(conj.SecondaryObject switch {
                                Satellite s => s.Name.ToString(),
                                DebrisObject d => $"DEBRIS-{d.NoradId}",
                                _ => conj.SecondaryObjectId.ToString()
                            })
                            <div class="meta">
                                @App.Resources.Views.Operator.Index.Label_Miss: @conj.MissDistance.ToString("N0") m |
                                @((conj.CollisionProbability * 100).ToString("F3"))%
                            </div>
                        </div>
                    </a>
                }
            </div>
        </div>

    </div>
    
    <!-- KPI STRIP -->
    <div class="kpi-bar">
        <div class="kpi-item kpi-blue">
            <div class="kpi-icon"><i class="bi bi-rocket-takeoff-fill"></i></div>
            <div>
                <div class="kpi-label">@App.Resources.Views.Operator.Index.Kpi_Total</div>
                <div class="kpi-value">@Model.TotalSatellites</div>
            </div>
        </div>
        <div class="kpi-item kpi-green">
            <div class="kpi-icon"><i class="bi bi-broadcast-pin"></i></div>
            <div>
                <div class="kpi-label">@App.Resources.Views.Operator.Index.Kpi_Active</div>
                <div class="kpi-value">@Model.ActiveSatellites</div>
            </div>
        </div>
        <div class="kpi-item kpi-yellow">
            <div class="kpi-icon"><i class="bi bi-arrow-left-right"></i></div>
            <div>
                <div class="kpi-label">@App.Resources.Views.Operator.Index.Kpi_Conjunctions</div>
                <div class="kpi-value">@Model.PendingConjunctions</div>
            </div>
        </div>
        <div class="kpi-item kpi-red">
            <div class="kpi-icon"><i class="bi bi-exclamation-triangle-fill"></i></div>
            <div>
                <div class="kpi-label">@App.Resources.Views.Operator.Index.Kpi_HighRisk</div>
                <div class="kpi-value">@Model.HighRiskConjunctions</div>
            </div>
        </div>
        <div class="kpi-item kpi-red">
            <div class="kpi-icon"><i class="bi bi-bell-fill"></i></div>
            <div>
                <div class="kpi-label">@App.Resources.Views.Operator.Index.Kpi_Alerts</div>
                <div class="kpi-value">@Model.UnacknowledgedAlerts</div>
            </div>
        </div>
    </div>
</div>

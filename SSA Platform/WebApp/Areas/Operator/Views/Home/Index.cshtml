@using App.Domain.Entities
@using App.Domain.Entities.Enums
@model App.Application.DTO.OperatorDashboardDto

@{
    ViewData["Title"] = "Operator Dashboard";
}

<link rel="stylesheet" href="~/css/dashboard-ssa.css" asp-append-version="true" />
<script src="~/js/orbitalMechanics.js"></script>
<script src="~/js/orbitRenderer.js"></script>

<div class="ssa-container">

    <!-- SYSTEM STATUS BAR -->
    <div class="system-bar">
        <span class="status-dot"></span>
        SYSTEM: NOMINAL |
        LAST UPDATE: @DateTime.UtcNow.ToString("HH:mm:ss") UTC |
        OPERATOR: @Model.OperatorName
    </div>

    <!-- HEADER -->
    <div class="header">
        <div>
            <h3>@Model.OperatorName</h3>
            <small>Space Situational Awareness</small>
        </div>

        <div class="header-right">
            <span class="badge danger">@Model.HighRiskConjunctions HIGH RISK</span>
            <span class="badge warning">@Model.UnacknowledgedAlerts ALERTS</span>
        </div>
    </div>
    
    <!-- MAIN GRID -->
    <div class="grid">

        <!-- ORBIT VISUALIZATION -->
        <div class="card orbit-card">
            <h5>Orbital View</h5>
            <div class="orbit-visualization">
                <canvas id="orbitCanvas"></canvas>
                <script>
                    OrbitRenderer.init({
                        canvasId: 'orbitCanvas',
                        satellites: @Html.Raw(Json.Serialize(Model.Satellites
                                        .Where(s => s.Orbit != null)
                                        .Select(s => new {
                                            id   = s.Id,
                                            name = s.Name.ToString(),
                                            orbit = new {
                                                semiMajorAxis     = s.Orbit!.Parameters.SemiMajorAxis,
                                                eccentricity      = s.Orbit!.Parameters.Eccentricity,
                                                inclination       = s.Orbit!.Parameters.Inclination,
                                                raan              = s.Orbit!.Parameters.RAAN,
                                                argumentOfPerigee = s.Orbit!.Parameters.ArgumentOfPerigee,
                                                meanAnomaly       = s.Orbit!.Parameters.MeanAnomaly
                                            }
                                        }))),
                    });
                </script>
            </div>
        </div>

        <!-- ALERT FEED -->
        <div class="card alert-card">
            <h5>Live Alerts</h5>

            <div class="alert-feed">
                @foreach (var alert in Model.Alerts
                              .OrderBy(a => a.IsAcknowledged)
                              .ThenByDescending(a => a.CreatedAt)
                              .Take(6))
                {
                    <div class="alert-item @(alert.IsAcknowledged ? "ack" : "pending")">
                        <div>
                            <strong>@alert.Severity</strong> - @alert.Message
                        </div>
                        <small>@alert.CreatedAt.ToString("HH:mm:ss")</small>
                    </div>
                }
            </div>
        </div>

        <!-- SATELLITES -->
        <div class="card satellites-card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Satellites</h5>
                <form asp-controller="Satellite" asp-action="Index" method="get" class="m-0">
                    <button type="submit" class="btn btn-primary btn-sm view-all-btn">
                        View All
                    </button>
                </form>
            </div>

            <div class="sat-grid">
                @foreach (var sat in Model.Satellites.Take(6))
                {
                    <a class="sat-tile" asp-action="Details" asp-controller="Satellite" asp-route-id="@sat.Id">
                        <div class="tile-header">
                            <h6 class="sat-name">@sat.Name</h6>
                            <small class="norad-id">NORAD @sat.NoradId</small>
                        </div>

                        <span class="status @(sat.Status == ESatelliteStatus.Active ? "active" : "inactive")">
                            @sat.Status
                        </span>
                    </a>
                }
            </div>
        </div>

        <!-- CONJUNCTION TIMELINE -->
        <div class="card">
            <div class="card-header">
                <h5>Conjunction Timeline</h5>
                <form asp-controller="Conjunctions" asp-action="Index" method="get" class="m-0">
                    <button type="submit" class="btn btn-primary btn-sm view-all-btn">
                        View All
                    </button>
                </form>
            </div>

            <div class="timeline">
                @foreach (var conj in Model.Conjunctions
                              .OrderByDescending(c => c.IsHighRisk())
                              .ThenBy(c => c.TimeOfClosestApproach)
                              .Take(6))
                {
                    <div class="timeline-item @(conj.IsHighRisk() ? "high" : "")">
                        <div class="time">
                            @DateTime.UtcNow.AddSeconds(conj.TimeOfClosestApproach).ToString("HH:mm")
                        </div>
                        <div class="content">
                            @(conj.PrimaryObject switch {
                                Satellite s => s.Name.ToString(),
                                DebrisObject d => $"DEBRIS-{d.NoradId}",
                                _ => conj.PrimaryObjectId.ToString()
                            })
                            ↔
                            @(conj.SecondaryObject switch {
                                Satellite s => s.Name.ToString(),
                                DebrisObject d => $"DEBRIS-{d.NoradId}",
                                _ => conj.SecondaryObjectId.ToString()
                            })
                            <div class="meta">
                                Miss: @conj.MissDistance.ToString("N0") m |
                                @((conj.CollisionProbability * 100).ToString("F3"))%
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

    </div>
    
    <!-- KPI STRIP -->
    <div class="kpi-bar">
        <div>
            <span>Total</span>
            <strong>@Model.TotalSatellites</strong>
        </div>
        <div>
            <span>Active</span>
            <strong class="green">@Model.ActiveSatellites</strong>
        </div>
        <div>
            <span>Conjunctions</span>
            <strong class="yellow">@Model.PendingConjunctions</strong>
        </div>
        <div>
            <span>High Risk</span>
            <strong class="red">@Model.HighRiskConjunctions</strong>
        </div>
        <div>
            <span>Alerts</span>
            <strong class="red">@Model.UnacknowledgedAlerts</strong>
        </div>
    </div>
</div>
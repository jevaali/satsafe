@model IEnumerable<App.Application.Features.Conjunctions.DTOs.ConjunctionSummaryDto>
@using App.Domain.Entities.Enums

@{
    ViewData["Title"] = "Conjunction Management";
}

<link rel="stylesheet" href="~/css/dashboard-ssa.css" asp-append-version="true" />

<div class="ssa-container">

    <div class="system-bar">
        <span class="status-dot"></span>
        @App.Resources.Views.Operator.Conjunctions.Index.SystemBar_Label |
        @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss") UTC |
        @Model.Count() @App.Resources.Views.Operator.Conjunctions.Index.SystemBar_Loaded
    </div>

    <div class="header">
        <div>
            <h3>@App.Resources.Views.Operator.Conjunctions.Index.Header</h3>
            <small>@App.Resources.Views.Operator.Conjunctions.Index.Header_Subtitle</small>
        </div>
        <div class="header-right">
            <span class="op-badge high-risk"><i class="bi bi-exclamation-triangle-fill"></i>@Model.Count(c => c.IsHighRisk) @App.Resources.Views.Operator.Conjunctions.Index.Badge_HighRisk</span>
            <span class="op-badge pending">@Model.Count(c => c.Status == EConjunctionEventStatus.Pending) @App.Resources.Views.Operator.Conjunctions.Index.Badge_Pending</span>
        </div>
    </div>

    <!-- FILTER BAR -->
    <div class="op-filter-card">
        <div class="op-filter-bar">
            <div class="op-filter-search">
                <i class="bi bi-search"></i>
                <input type="text" id="searchInput" placeholder="@App.Resources.Views.Operator.Conjunctions.Index.Filter_SearchPlaceholder" />
            </div>
            <select id="statusFilter">
                <option value="">@App.Resources.Views.Operator.Conjunctions.Index.Filter_AllStatuses</option>
                @foreach (var status in Enum.GetValues<EConjunctionEventStatus>())
                {
                    <option value="@status">@status</option>
                }
            </select>
            <select id="riskFilter">
                <option value="">@App.Resources.Views.Operator.Conjunctions.Index.Filter_AllRiskLevels</option>
                <option value="high">@App.Resources.Views.Operator.Conjunctions.Index.Filter_HighRisk</option>
                <option value="normal">@App.Resources.Views.Operator.Conjunctions.Index.Filter_Normal</option>
            </select>
        </div>

        <table class="op-table" id="conjunctionTable">
            <thead>
                <tr>
                    <th>@App.Resources.Views.Operator.Conjunctions.Index.Col_PrimaryObject</th>
                    <th>@App.Resources.Views.Operator.Conjunctions.Index.Col_SecondaryObject</th>
                    <th>@App.Resources.Views.Operator.Conjunctions.Index.Col_TCA</th>
                    <th>@App.Resources.Views.Operator.Conjunctions.Index.Col_MissDistance</th>
                    <th>@App.Resources.Views.Operator.Conjunctions.Index.Col_CollisionProb</th>
                    <th>@App.Resources.Views.Operator.Conjunctions.Index.Col_Status</th>
                    <th>@App.Resources.Views.Operator.Conjunctions.Index.Col_Risk</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.OrderByDescending(c => c.IsHighRisk).ThenBy(c => c.TimeOfClosestApproach))
                {
                    var statusBadge = c.Status switch {
                        EConjunctionEventStatus.Resolved        => "resolved",
                        EConjunctionEventStatus.Imminent        => "imminent",
                        EConjunctionEventStatus.Potential       => "potential",
                        EConjunctionEventStatus.Pending         => "pending",
                        EConjunctionEventStatus.AlreadyOccurred => "occurred",
                        _                                       => "low"
                    };

                    <tr class="conjunction-row @(c.IsHighRisk ? "row-high-risk" : "")"
                        data-primary="@c.PrimaryObjectName.ToLower()"
                        data-secondary="@c.SecondaryObjectName.ToLower()"
                        data-status="@c.Status"
                        data-risk="@(c.IsHighRisk ? "high" : "normal")">
                        <td><span style="font-family:'Share Tech Mono',monospace;font-size:0.85rem;font-weight:700;color:#1a2332;">@c.PrimaryObjectName</span></td>
                        <td><span style="font-family:'Share Tech Mono',monospace;font-size:0.85rem;color:#5a6a7a;">@c.SecondaryObjectName</span></td>
                        <td style="font-family:'Share Tech Mono',monospace;font-size:0.8rem;color:#8a9bb0;">@c.TimeOfClosestApproach.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <span class="op-badge @(c.MissDistance < 1000 ? "critical" : c.MissDistance < 5000 ? "high" : "low")">
                                @(c.MissDistance < 1000 ? $"{c.MissDistance:N0} m" : $"{c.MissDistance / 1000:F2} km")
                            </span>
                        </td>
                        <td style="font-family:'Share Tech Mono',monospace;font-size:0.8rem;">@((c.CollisionProbability * 100).ToString("F4"))%</td>
                        <td><span class="op-badge @statusBadge">@c.Status</span></td>
                        <td><span class="op-badge @(c.IsHighRisk ? "high-risk" : "normal")">@(c.IsHighRisk ? @App.Resources.Views.Operator.Conjunctions.Index.Risk_High : @App.Resources.Views.Operator.Conjunctions.Index.Risk_Normal)</span></td>
                        <td>
                            <a asp-action="Details" asp-route-id="@c.Id" class="btn-sat btn-sat-view">
                                <i class="bi bi-eye"></i> @App.Resources.Views.Operator.Conjunctions.Index.Btn_Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <p>@App.Resources.Views.Operator.Conjunctions.Index.Empty_NoEvents</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        const searchInput  = document.getElementById('searchInput');
        const statusFilter = document.getElementById('statusFilter');
        const riskFilter   = document.getElementById('riskFilter');
        const rows         = document.querySelectorAll('.conjunction-row');

        function applyFilters() {
            const search = searchInput.value.toLowerCase();
            const status = statusFilter.value.toLowerCase();
            const risk   = riskFilter.value.toLowerCase();

            rows.forEach(row => {
                const matchSearch = !search ||
                    row.dataset.primary.includes(search) ||
                    row.dataset.secondary.includes(search);
                const matchStatus = !status || row.dataset.status.toLowerCase() === status;
                const matchRisk   = !risk   || row.dataset.risk === risk;

                row.style.display = matchSearch && matchStatus && matchRisk ? '' : 'none';
            });
        }

        searchInput.addEventListener('input', applyFilters);
        statusFilter.addEventListener('change', applyFilters);
        riskFilter.addEventListener('change', applyFilters);
    </script>
}

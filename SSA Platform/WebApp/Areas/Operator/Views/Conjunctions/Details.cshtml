@model App.Domain.Entities.ConjunctionEvent
@using App.Domain.Entities
@using App.Domain.Entities.Enums

@functions {
    static string AckBadge(EOperatorAcknowledgement a) => a switch {
        EOperatorAcknowledgement.Noticed   => "bg-info text-dark",
        EOperatorAcknowledgement.Confirmed => "warning",
        EOperatorAcknowledgement.Resolved  => "bg-success",
        _                                  => "bg-secondary"
    };
}

@{
    ViewData["Title"] = "Conjunction Details";
    var primaryName = Model.PrimaryObject switch {
        Satellite s    => s.Name.ToString(),
        DebrisObject d => $"DEBRIS-{d.NoradId}",
        _              => Model.PrimaryObjectId.ToString()
    };
    var secondaryName = Model.SecondaryObject switch {
        Satellite s    => s.Name.ToString(),
        DebrisObject d => $"DEBRIS-{d.NoradId}",
        _              => Model.SecondaryObjectId.ToString()
    };
    var tca = Model.TimeOfClosestApproach;
}

<link rel="stylesheet" href="~/css/dashboard-ssa.css" asp-append-version="true" />

<div class="ssa-container">

    <div class="system-bar">
        <span class="status-dot"></span>
        CONJUNCTION DETAIL |
        @tca.ToString("yyyy-MM-dd HH:mm:ss") UTC TCA
    </div>

    <div class="header">
        <div>
            <h3>@primaryName ↔ @secondaryName</h3>
            <small>Conjunction Event — @Model.Id</small>
        </div>
        <div class="header-right">
            @if (Model.IsHighRisk())
            {
                <span class="badge danger">HIGH RISK</span>
            }
            <span class="badge @(Model.Status switch {
                EConjunctionEventStatus.Resolved        => "bg-success",
                EConjunctionEventStatus.Imminent        => "bg-danger",
                EConjunctionEventStatus.Potential       => "warning",
                EConjunctionEventStatus.AlreadyOccurred => "bg-secondary",
                _                                       => "bg-info text-dark"
            })">@Model.Status</span>
        </div>
    </div>

    <div class="grid">

        <!-- METRICS -->
        <div class="card">
            <h5>Orbital Metrics</h5>
            <table class="table mb-0">
                <tr>
                    <td class="text-muted">Miss Distance</td>
                    <td class="fw-bold @(Model.MissDistance < 1000 ? "text-danger" : Model.MissDistance < 5000 ? "text-warning" : "")">
                        @(Model.MissDistance < 1000
                            ? $"{Model.MissDistance:N0} m"
                            : $"{Model.MissDistance / 1000:F3} km")
                    </td>
                </tr>
                <tr>
                    <td class="text-muted">Collision Probability</td>
                    <td class="fw-bold">@((Model.CollisionProbability * 100).ToString("F4"))%</td>
                </tr>
                <tr>
                    <td class="text-muted">Time of Closest Approach</td>
                    <td>@tca.ToString("yyyy-MM-dd HH:mm:ss") UTC</td>
                </tr>
                <tr>
                    <td class="text-muted">Time Until TCA</td>
                    <td>@((Model.TimeOfClosestApproach - DateTime.UtcNow).ToString(@"hh\:mm\:ss"))</td>
                </tr>
                <tr>
                    <td class="text-muted">Threshold</td>
                    <td>50 km</td>
                </tr>
            </table>
        </div>

        <!-- OBJECTS -->
        <div class="card">
            <h5>Involved Objects</h5>
            <table class="table mb-0">
                <tr>
                    <td class="text-muted">Primary</td>
                    <td>
                        <strong>@primaryName</strong>
                        @if (Model.PrimaryObject is Satellite ps)
                        {
                            <div><small>NORAD @ps.NoradId | @ps.Status</small></div>
                        }
                        else if (Model.PrimaryObject is DebrisObject pd)
                        {
                            <div><small>NORAD @pd.NoradId | Debris</small></div>
                        }
                        <span class="badge @AckBadge(Model.PrimaryAcknowledgement) mt-1">@Model.PrimaryAcknowledgement</span>
                    </td>
                </tr>
                <tr>
                    <td class="text-muted">Secondary</td>
                    <td>
                        <strong>@secondaryName</strong>
                        @if (Model.SecondaryObject is Satellite ss)
                        {
                            <div><small>NORAD @ss.NoradId | @ss.Status</small></div>
                        }
                        else if (Model.SecondaryObject is DebrisObject sd)
                        {
                            <div><small>NORAD @sd.NoradId | Debris</small></div>
                        }
                        <span class="badge @AckBadge(Model.SecondaryAcknowledgement) mt-1">@Model.SecondaryAcknowledgement</span>
                    </td>
                </tr>
            </table>
        </div>

    </div>
    
    @await Html.PartialAsync("_ConjunctionOrbit", Model)

    <!-- ALERTS PANEL -->
    @if (Model.Alerts.Any())
    {
        <div class="card mt-3">
            <div class="d-flex justify-content-between align-items-center px-3 pt-3 pb-2">
                <h5 class="mb-0">Related Alerts</h5>
                <div>
                    <span class="badge bg-danger me-1">@Model.Alerts.Count(a => !a.IsAcknowledged) unacknowledged</span>
                    <span class="badge bg-secondary">@Model.Alerts.Count total</span>
                </div>
            </div>
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Severity</th>
                        <th>Message</th>
                        <th>Created</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var alert in Model.Alerts.OrderByDescending(a => !a.IsAcknowledged).ThenByDescending(a => a.Severity))
                    {
                        var severityBadge = alert.Severity switch {
                            App.Domain.Entities.Enums.EAlertSeverity.Critical => "bg-danger",
                            App.Domain.Entities.Enums.EAlertSeverity.High     => "bg-warning text-dark",
                            App.Domain.Entities.Enums.EAlertSeverity.Medium   => "bg-info text-dark",
                            _                                                  => "bg-secondary"
                        };
                        <tr class="@(alert.IsAcknowledged ? "opacity-50" : "")">
                            <td><span class="badge @severityBadge">@alert.Severity</span></td>
                            <td>@(alert.Message?.ToString() ?? "—")</td>
                            <td>@alert.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                @if (alert.IsAcknowledged)
                                {
                                    <span class="badge bg-success">Acknowledged</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                            </td>
                            <td>
                                <a asp-area="Operator" asp-controller="Alerts" asp-action="Details"
                                   asp-route-id="@alert.Id" class="btn btn-sm btn-outline-primary">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- ACTIONS -->
    @{
        var operatorSide = (string?)ViewBag.OperatorSide ?? "None";
        var myAck = operatorSide == "Primary"   ? Model.PrimaryAcknowledgement
                  : operatorSide == "Secondary" ? Model.SecondaryAcknowledgement
                  : EOperatorAcknowledgement.Resolved; // "None" side — no buttons
        var isFullyResolved = Model.Status == EConjunctionEventStatus.Resolved ||
                              Model.Status == EConjunctionEventStatus.AlreadyOccurred;
    }
    <div class="card mt-3 p-3">
        <h6 class="mb-3" style="font-size:0.8rem;letter-spacing:0.06em;text-transform:uppercase;color:#6b7c93;">
            Your Response @(operatorSide != "None" ? $"({operatorSide} object)" : "")
        </h6>
        <div class="d-flex gap-2 align-items-center flex-wrap">
            @if (operatorSide != "None" && !isFullyResolved)
            {
                @if (myAck < EOperatorAcknowledgement.Noticed)
                {
                    <form asp-action="Acknowledge" asp-route-id="@Model.Id" asp-route-state="@EOperatorAcknowledgement.Noticed" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-info btn-sm">Mark as Noticed</button>
                    </form>
                }
                @if (myAck < EOperatorAcknowledgement.Confirmed)
                {
                    <form asp-action="Acknowledge" asp-route-id="@Model.Id" asp-route-state="@EOperatorAcknowledgement.Confirmed" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-warning btn-sm">Confirm Risk</button>
                    </form>
                }
                @if (myAck < EOperatorAcknowledgement.Resolved)
                {
                    var unackedCount = Model.Alerts.Count(a => !a.IsAcknowledged);
                    <form asp-action="Acknowledge" asp-route-id="@Model.Id" asp-route-state="@EOperatorAcknowledgement.Resolved" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success btn-sm">
                            @if (unackedCount > 0)
                            {
                                <text>Resolve &amp; Acknowledge @unackedCount Alert@(unackedCount != 1 ? "s" : "")</text>
                            }
                            else
                            {
                                <text>Resolve My Side</text>
                            }
                        </button>
                    </form>
                }
            }
            @if (myAck == EOperatorAcknowledgement.Resolved || isFullyResolved)
            {
                <span class="badge bg-success">Your side resolved</span>
            }
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm ms-auto">Back to List</a>
        </div>
    </div>

</div>
@model App.Application.Features.Conjunctions.DTOs.ConjunctionDetailDto
@using App.Domain.Entities.Enums

@functions {
    static string AckBadge(EOperatorAcknowledgement a) => a switch {
        EOperatorAcknowledgement.Noticed   => "bg-info text-dark",
        EOperatorAcknowledgement.Confirmed => "warning",
        EOperatorAcknowledgement.Resolved  => "bg-success",
        _                                  => "bg-secondary"
    };
}

@{
    ViewData["Title"] = "Conjunction Details";
    var tca = Model.TimeOfClosestApproach;
}

<link rel="stylesheet" href="~/css/dashboard-ssa.css" asp-append-version="true" />

<div class="ssa-container">

    <div class="system-bar">
        <span class="status-dot"></span>
        @App.Resources.Views.Operator.Conjunctions.Details.SystemBar_Label |
        @tca.ToString("yyyy-MM-dd HH:mm:ss") UTC TCA
    </div>

    <div class="header">
        <div>
            <h3>@Model.PrimaryObjectName ↔ @Model.SecondaryObjectName</h3>
            <small>@App.Resources.Views.Operator.Conjunctions.Details.PageTitle — @Model.Id</small>
        </div>
        <div class="header-right">
            @if (Model.IsHighRisk)
            {
                <span class="badge danger">@App.Resources.Views.Operator.Conjunctions.Details.Risk_High</span>
            }
            <span class="badge @(Model.Status switch {
                EConjunctionEventStatus.Resolved        => "bg-success",
                EConjunctionEventStatus.Imminent        => "bg-danger",
                EConjunctionEventStatus.Potential       => "warning",
                EConjunctionEventStatus.AlreadyOccurred => "bg-secondary",
                _                                       => "bg-info text-dark"
            })">@Model.Status</span>
        </div>
    </div>

    <div class="grid">

        <!-- METRICS -->
        <div class="card">
            <h5>@App.Resources.Views.Operator.Conjunctions.Details.Section_Metrics</h5>
            <table class="table mb-0">
                <tr>
                    <td class="text-muted">@App.Resources.Views.Operator.Conjunctions.Details.Label_MissDistance</td>
                    <td class="fw-bold @(Model.MissDistance < 1000 ? "text-danger" : Model.MissDistance < 5000 ? "text-warning" : "")">
                        @(Model.MissDistance < 1000
                            ? $"{Model.MissDistance:N0} m"
                            : $"{Model.MissDistance / 1000:F3} km")
                    </td>
                </tr>
                <tr>
                    <td class="text-muted">@App.Resources.Views.Operator.Conjunctions.Details.Label_CollisionProb</td>
                    <td class="fw-bold">@((Model.CollisionProbability * 100).ToString("F4"))%</td>
                </tr>
                <tr>
                    <td class="text-muted">@App.Resources.Views.Operator.Conjunctions.Details.Label_TCA</td>
                    <td>@tca.ToString("yyyy-MM-dd HH:mm:ss") UTC</td>
                </tr>
                <tr>
                    <td class="text-muted">@App.Resources.Views.Operator.Conjunctions.Details.Label_TimeUntilTca</td>
                    <td>@((Model.TimeOfClosestApproach - DateTime.UtcNow).ToString(@"hh\:mm\:ss"))</td>
                </tr>
                <tr>
                    <td class="text-muted">@App.Resources.Views.Operator.Conjunctions.Details.Label_Threshold</td>
                    <td>50 km</td>
                </tr>
            </table>
        </div>

        <!-- OBJECTS -->
        <div class="card">
            <h5>@App.Resources.Views.Operator.Conjunctions.Details.Section_Objects</h5>
            <table class="table mb-0">
                <tr>
                    <td class="text-muted">@App.Resources.Views.Operator.Conjunctions.Details.Label_Primary</td>
                    <td>
                        <strong>@Model.PrimaryObjectName</strong>
                        @if (Model.PrimaryNoradId.HasValue)
                        {
                            <div>
                                <small>
                                    NORAD @Model.PrimaryNoradId |
                                    @(Model.PrimaryIsSatellite ? Model.PrimaryObjectStatus?.ToString() ?? "" : "Debris")
                                </small>
                            </div>
                        }
                        <span class="badge @AckBadge(Model.PrimaryAcknowledgement) mt-1">@Model.PrimaryAcknowledgement</span>
                    </td>
                </tr>
                <tr>
                    <td class="text-muted">@App.Resources.Views.Operator.Conjunctions.Details.Label_Secondary</td>
                    <td>
                        <strong>@Model.SecondaryObjectName</strong>
                        @if (Model.SecondaryNoradId.HasValue)
                        {
                            <div>
                                <small>
                                    NORAD @Model.SecondaryNoradId |
                                    @(Model.SecondaryIsSatellite ? Model.SecondaryObjectStatus?.ToString() ?? "" : "Debris")
                                </small>
                            </div>
                        }
                        <span class="badge @AckBadge(Model.SecondaryAcknowledgement) mt-1">@Model.SecondaryAcknowledgement</span>
                    </td>
                </tr>
            </table>
        </div>

    </div>

    @await Html.PartialAsync("_ConjunctionOrbit", Model)

    <!-- ALERTS PANEL -->
    @if (Model.Alerts.Any())
    {
        <div class="card mt-3">
            <div class="d-flex justify-content-between align-items-center px-3 pt-3 pb-2">
                <h5 class="mb-0">@App.Resources.Views.Operator.Conjunctions.Details.Section_Alerts</h5>
                <div>
                    <span class="badge bg-danger me-1">@Model.Alerts.Count(a => !a.IsAcknowledged) @App.Resources.Views.Operator.Conjunctions.Details.Badge_Unacknowledged</span>
                    <span class="badge bg-secondary">@Model.Alerts.Count @App.Resources.Views.Operator.Conjunctions.Details.Badge_Total</span>
                </div>
            </div>
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>@App.Resources.Views.Operator.Conjunctions.Details.Col_Severity</th>
                        <th>@App.Resources.Views.Operator.Conjunctions.Details.Col_Message</th>
                        <th>@App.Resources.Views.Operator.Conjunctions.Details.Col_Created</th>
                        <th>@App.Resources.Views.Operator.Conjunctions.Details.Col_Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var alert in Model.Alerts)
                    {
                        var severityBadge = alert.Severity switch {
                            EAlertSeverity.Critical => "bg-danger",
                            EAlertSeverity.High     => "bg-warning text-dark",
                            EAlertSeverity.Medium   => "bg-info text-dark",
                            _                       => "bg-secondary"
                        };
                        <tr class="@(alert.IsAcknowledged ? "opacity-50" : "")">
                            <td><span class="badge @severityBadge">@alert.Severity</span></td>
                            <td>@(alert.Message ?? "—")</td>
                            <td>@alert.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                @if (alert.IsAcknowledged)
                                {
                                    <span class="badge bg-success">@App.Resources.Views.Operator.Conjunctions.Details.Status_Acknowledged</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">@App.Resources.Views.Operator.Conjunctions.Details.Status_Pending</span>
                                }
                            </td>
                            <td>
                                <a asp-area="Operator" asp-controller="Alerts" asp-action="Details"
                                   asp-route-id="@alert.Id" class="btn btn-sm btn-outline-primary">@App.Resources.Views.Operator.Conjunctions.Details.Btn_ViewAlert</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- ACTIONS -->
    @{
        var operatorSide = Model.OperatorSide;
        var myAck = operatorSide == "Primary"   ? Model.PrimaryAcknowledgement
                  : operatorSide == "Secondary" ? Model.SecondaryAcknowledgement
                  : EOperatorAcknowledgement.Resolved; // "None" side — no buttons
        var isFullyResolved = Model.Status == EConjunctionEventStatus.Resolved ||
                              Model.Status == EConjunctionEventStatus.AlreadyOccurred;
        var unackedCount = Model.Alerts.Count(a => !a.IsAcknowledged);
    }
    <div class="card mt-3 p-3">
        <h6 class="mb-3" style="font-size:0.8rem;letter-spacing:0.06em;text-transform:uppercase;color:#6b7c93;">
            @App.Resources.Views.Operator.Conjunctions.Details.Response_Label @(operatorSide != "None" ? $"({operatorSide} object)" : "")
        </h6>
        <div class="d-flex gap-2 align-items-center flex-wrap">
            @if (operatorSide != "None" && !isFullyResolved)
            {
                @if (myAck < EOperatorAcknowledgement.Noticed)
                {
                    <form asp-action="Acknowledge" asp-route-id="@Model.Id" asp-route-state="@EOperatorAcknowledgement.Noticed" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-info btn-sm">@App.Resources.Views.Operator.Conjunctions.Details.Btn_MarkNoticed</button>
                    </form>
                }
                @if (myAck < EOperatorAcknowledgement.Confirmed)
                {
                    <form asp-action="Acknowledge" asp-route-id="@Model.Id" asp-route-state="@EOperatorAcknowledgement.Confirmed" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-warning btn-sm">@App.Resources.Views.Operator.Conjunctions.Details.Btn_ConfirmRisk</button>
                    </form>
                }
                @if (myAck < EOperatorAcknowledgement.Resolved)
                {
                    <form asp-action="Acknowledge" asp-route-id="@Model.Id" asp-route-state="@EOperatorAcknowledgement.Resolved" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success btn-sm">
                            @if (unackedCount > 0)
                            {
                                <text>@App.Resources.Views.Operator.Conjunctions.Details.Btn_ResolveAndAck @unackedCount @App.Resources.Views.Operator.Conjunctions.Details.Label_Alert@(unackedCount != 1 ? "s" : "")</text>
                            }
                            else
                            {
                                <text>@App.Resources.Views.Operator.Conjunctions.Details.Btn_ResolveMySide</text>
                            }
                        </button>
                    </form>
                }
            }
            @if (myAck == EOperatorAcknowledgement.Resolved)
            {
                <span class="badge bg-success">@App.Resources.Views.Operator.Conjunctions.Details.Status_YourSideResolved</span>
            }
            else if (Model.Status == EConjunctionEventStatus.AlreadyOccurred)
            {
                <span class="badge bg-secondary">@App.Resources.Views.Operator.Conjunctions.Details.Status_EventOccurred</span>
            }
            else if (Model.Status == EConjunctionEventStatus.Resolved)
            {
                <span class="badge bg-success">@App.Resources.Views.Operator.Conjunctions.Details.Status_FullyResolved</span>
            }
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm ms-auto">@App.Resources.Views.Operator.Conjunctions.Details.Btn_BackToList</a>
        </div>
    </div>

</div>

@model IEnumerable<App.Domain.Entities.Satellite>

@{
    ViewData["Title"] = "My Satellites";
}

<div class="container">
    <div class="row py-4">
        <div class="col-12">
            <h1 class="display-4 fw-bold text-primary">My Satellites</h1>
            <p class="lead text-muted mb-4">
                View and manage your assigned satellite fleet.
            </p>
        </div>
    </div>

    <div class="row py-2">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-area="Operator" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Satellites</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row py-3">
        <div class="col-12">
            @if (Model.Any())
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>
                                        @Html.DisplayNameFor(model => model.Name)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.NoradId)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.Status)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.LaunchDate)
                                    </th>
                                    <th>
                                        Orbit
                                    </th>
                                    <th>
                                        Actions
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <strong>@Html.DisplayFor(modelItem => item.Name)</strong>
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.NoradId)
                                        </td>
                                        <td>
                                            <span class="badge bg-@item.Status.ToString().ToLower()">
                                                @Html.DisplayFor(modelItem => item.Status)
                                            </span>
                                        </td>
                                        <td>
                                            @item.LaunchDate.ToShortDateString()
                                        </td>
                                        <td>
                                            @if (item.Orbit != null)
                                            {
                                                <span class="text-muted">Orbit #@item.Orbit.Id</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            <a asp-area="Operator" asp-controller="Dashboard" asp-action="SatelliteDetails" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Details</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center py-5">
                        <h3 class="text-muted">No Satellites Found</h3>
                        <p class="text-muted">You don't have any satellites assigned to your operator account.</p>
                        <p class="text-muted">Contact your administrator to add satellites to your fleet.</p>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="row py-3">
        <div class="col-12">
            <a asp-area="Operator" asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">
                ← Back to Dashboard
            </a>
        </div>
    </div>
</div>

@model IEnumerable<App.Domain.Entities.ConjunctionEvent>

@{
    ViewData["Title"] = "Conjunction Events";
}

<div class="container">
    <div class="row py-4">
        <div class="col-12">
            <h1 class="display-4 fw-bold text-warning">Conjunction Events</h1>
            <p class="lead text-muted mb-4">
                Monitor potential close approaches involving your satellites.
            </p>
        </div>
    </div>

    <div class="row py-2">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-area="Operator" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Conjunctions</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row py-3">
        <div class="col-12">
            @if (Model.Any())
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>
                                        Time of Closest Approach
                                    </th>
                                    <th>
                                        Primary Object
                                    </th>
                                    <th>
                                        Secondary Object
                                    </th>
                                    <th>
                                        Miss Distance (m)
                                    </th>
                                    <th>
                                        Collision Probability
                                    </th>
                                    <th>
                                        Status
                                    </th>
                                    <th>
                                        Risk Level
                                    </th>
                                    <th>
                                        Actions
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderByDescending(c => c.TimeOfClosestApproach))
                                {
                                    <tr class="@(item.IsHighRisk() ? "table-danger" : "")">
                                        <td>
                                            @item.TimeOfClosestApproach.ToString("g")
                                        </td>
                                        <td>
                                            @(item.PrimaryObject.NoradId.ToString() ?? item.PrimaryObjectId.ToString())
                                        </td>
                                        <td>
                                            @(item.SecondaryObject.NoradId.ToString() ?? item.SecondaryObjectId.ToString())
                                        </td>
                                        <td>
                                            @item.MissDistance.ToString("N0")
                                        </td>
                                        <td>
                                            @(item.CollisionProbability * 100).ToString("F4")%
                                        </td>
                                        <td>
                                            <span class="badge bg-@item.Status.ToString().ToLower()">
                                                @item.Status
                                            </span>
                                        </td>
                                        <td>
                                            @if (item.IsHighRisk())
                                            {
                                                <span class="badge bg-danger">High</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Low</span>
                                            }
                                        </td>
                                        <td>
                                            <a asp-area="Operator" asp-controller="Dashboard" asp-action="ConjunctionDetails" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Details</a>
                                            @if (item.Status != App.Domain.Entities.Enums.EConjunctionEventStatus.Resolved && item.Status != App.Domain.Entities.Enums.EConjunctionEventStatus.AlreadyOccurred)
                                            {
                                                <form asp-area="Operator" asp-controller="Dashboard" asp-action="MarkConjunctionResolved" asp-route-id="@item.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-success">Resolve</button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center py-5">
                        <h3 class="text-muted">No Conjunction Events</h3>
                        <p class="text-muted">No conjunction events have been detected for your satellites.</p>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="row py-3">
        <div class="col-12">
            <a asp-area="Operator" asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">
                ← Back to Dashboard
            </a>
        </div>
    </div>
</div>

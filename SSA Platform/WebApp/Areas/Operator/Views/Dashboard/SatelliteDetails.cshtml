@model App.Domain.Entities.Satellite

@{
    ViewData["Title"] = "Satellite Details";
}

<div class="container">
    <div class="row py-4">
        <div class="col-12">
            <h1 class="display-4 fw-bold text-primary">Satellite Details</h1>
            <p class="lead text-muted mb-4">
                Detailed information about @Model.Name.
            </p>
        </div>
    </div>

    <div class="row py-2">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-area="Operator" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-area="Operator" asp-controller="Dashboard" asp-action="Satellites">Satellites</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Details</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row py-3">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Basic Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.Name)
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.Name)
                        </dd>
                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.NoradId)
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.NoradId)
                        </dd>
                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.Status)
                        </dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-@Model.Status.ToString().ToLower()">
                                @Html.DisplayFor(model => model.Status)
                            </span>
                        </dd>
                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.LaunchDate)
                        </dt>
                        <dd class="col-sm-8">
                            @Model.LaunchDate.ToShortDateString()
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">Operator Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">
                            Operator
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.Operator.Name)
                        </dd>
                        <dt class="col-sm-4">
                            Country
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.Operator.Country)
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Orbit != null)
    {
        <div class="row py-3">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">Orbital Information</h5>
                    </div>
                    <div class="card-body">
                        <dl class="row">
                            <dt class="col-sm-4">
                                Orbit ID
                            </dt>
                            <dd class="col-sm-8">
                                @Model.Orbit.Id
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row py-3">
        <div class="col-12">
            <a asp-area="Operator" asp-controller="Dashboard" asp-action="Satellites" class="btn btn-outline-secondary">
                ← Back to Satellites
            </a>
        </div>
    </div>
</div>

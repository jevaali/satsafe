@model App.Domain.Entities.Satellite

@{
    ViewData["Title"] = "Delete Satellite";
    var statusStr = Model.Status.ToString().ToLower();
}

<link rel="stylesheet" href="~/css/dashboard-ssa.css" asp-append-version="true" />

<div class="ssa-container">

    <div class="system-bar">
        <span class="status-dot"></span>
        SATELLITE MANAGEMENT | DELETE CONFIRMATION
    </div>

    <div class="header">
        <div>
            <h3>Delete Satellite</h3>
            <small>This action will soft-delete the satellite and remove it from your active fleet</small>
        </div>
        <div class="header-right">
            <span class="badge danger">Destructive Action</span>
        </div>
    </div>

    <div class="grid">

        <div class="card">
            <h5>Satellite Details</h5>
            <table class="table mb-0">
                <tr>
                    <td class="text-muted">Name</td>
                    <td><strong>@Model.Name</strong></td>
                </tr>
                <tr>
                    <td class="text-muted">NORAD ID</td>
                    <td class="font-monospace">@Model.NoradId</td>
                </tr>
                <tr>
                    <td class="text-muted">Status</td>
                    <td><span class="badge-status @statusStr">@Model.Status</span></td>
                </tr>
                <tr>
                    <td class="text-muted">Launch Date</td>
                    <td>@Model.LaunchDate.ToString("yyyy-MM-dd")</td>
                </tr>
                @if (Model.Orbit?.Parameters != null)
                {
                    var p = Model.Orbit.Parameters;
                    <tr>
                        <td class="text-muted">Inclination</td>
                        <td>@p.Inclination.ToString("F2")°</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Semi-Major Axis</td>
                        <td>@p.SemiMajorAxis.ToString("N0") km</td>
                    </tr>
                }
            </table>
        </div>

        <div class="card">
            <h5>What happens after deletion?</h5>
            <ul class="list-unstyled small mt-2">
                <li class="mb-2"><i class="bi bi-check text-warning me-2"></i>Satellite will be marked as deleted</li>
                <li class="mb-2"><i class="bi bi-check text-warning me-2"></i>Removed from active fleet view</li>
                <li class="mb-2"><i class="bi bi-check text-warning me-2"></i>Historical data preserved</li>
                <li class="mb-2"><i class="bi bi-x text-danger me-2"></i>Cannot be restored without admin</li>
            </ul>

            <hr />

            <form asp-action="Delete" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i> Confirm Delete
                    </button>
                    <a asp-area="Operator" asp-controller="Satellite" asp-action="Index" class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>

    </div>

</div>
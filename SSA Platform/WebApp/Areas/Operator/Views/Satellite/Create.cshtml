@model App.Application.Features.Satellites.DTOs.AddSatelliteRequest

@{
    ViewData["Title"] = "Add Satellite";
}

<link rel="stylesheet" href="~/css/dashboard-ssa.css" asp-append-version="true" />

<div class="ssa-container">

    <div class="system-bar">
        <span class="status-dot"></span>
        @App.Resources.Views.Operator.Satellite.Create.SystemBar_Label
        @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss") UTC
    </div>

    <div class="header">
        <div>
            <h3>@App.Resources.Views.Operator.Satellite.Create.Header</h3>
            <small>@App.Resources.Views.Operator.Satellite.Create.Header_Subtitle</small>
        </div>
        <div class="header-right">
            <a asp-area="Operator" asp-controller="Satellite" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> @App.Resources.Views.Operator.Satellite.Create.Btn_Back
            </a>
        </div>
    </div>

    <div class="grid">

        <div class="card">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <h5 class="mb-3 border-bottom pb-2" style="font-size:0.85rem;letter-spacing:0.05em;text-transform:uppercase;color:#6b7c93;">
                    <i class="bi bi-info-circle me-2"></i>@App.Resources.Views.Operator.Satellite.Create.Section_Basic
                </h5>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" placeholder="@App.Resources.Views.Operator.Satellite.Create.Placeholder_SatName" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="LaunchDate" class="form-label"></label>
                    <input asp-for="LaunchDate" type="date" class="form-control" />
                    <span asp-validation-for="LaunchDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NoradId" class="form-label"></label>
                    <input asp-for="NoradId" type="number" class="form-control" placeholder="e.g., 25544" min="1" />
                    <div class="form-text">@App.Resources.Views.Operator.Satellite.Create.Hint_NoradId</div>
                    <span asp-validation-for="NoradId" class="text-danger"></span>
                </div>

                <h5 class="mb-3 border-bottom pb-2 mt-4" style="font-size:0.85rem;letter-spacing:0.05em;text-transform:uppercase;color:#6b7c93;">
                    <i class="bi bi-arrow-repeat me-2"></i>@App.Resources.Views.Operator.Satellite.Create.Section_Orbital
                </h5>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="SemiMajorAxis" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="SemiMajorAxis" type="number" class="form-control" placeholder="e.g., 6778000" step="any" min="6500000" max="50000000" />
                            <span class="input-group-text">m</span>
                        </div>
                        <div class="form-text">@App.Resources.Views.Operator.Satellite.Create.Hint_SemiMajorAxis</div>
                        <span asp-validation-for="SemiMajorAxis" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Eccentricity" class="form-label"></label>
                        <input asp-for="Eccentricity" type="number" class="form-control" placeholder="e.g., 0.001" step="any" min="0" max="1" />
                        <div class="form-text">@App.Resources.Views.Operator.Satellite.Create.Hint_Eccentricity</div>
                        <span asp-validation-for="Eccentricity" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Inclination" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="Inclination" type="number" class="form-control" placeholder="e.g., 98.2" step="any" min="0" max="180" />
                            <span class="input-group-text">°</span>
                        </div>
                        <div class="form-text">@App.Resources.Views.Operator.Satellite.Create.Hint_Inclination</div>
                        <span asp-validation-for="Inclination" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="RAAN" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="RAAN" type="number" class="form-control" placeholder="e.g., 235.6" step="any" min="0" max="360" />
                            <span class="input-group-text">°</span>
                        </div>
                        <div class="form-text">@App.Resources.Views.Operator.Satellite.Create.Hint_Raan</div>
                        <span asp-validation-for="RAAN" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="ArgumentOfPerigee" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="ArgumentOfPerigee" type="number" class="form-control" placeholder="e.g., 90.0" step="any" min="0" max="360" />
                            <span class="input-group-text">°</span>
                        </div>
                        <div class="form-text">@App.Resources.Views.Operator.Satellite.Create.Hint_ArgOfPerigee</div>
                        <span asp-validation-for="ArgumentOfPerigee" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="MeanAnomaly" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="MeanAnomaly" type="number" class="form-control" placeholder="e.g., 0.0" step="any" min="0" max="360" />
                            <span class="input-group-text">°</span>
                        </div>
                        <div class="form-text">@App.Resources.Views.Operator.Satellite.Create.Hint_MeanAnomaly</div>
                        <span asp-validation-for="MeanAnomaly" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn-add">
                        <i class="bi bi-check-circle"></i> @App.Resources.Views.Operator.Satellite.Create.Btn_Register
                    </button>
                    <a asp-area="Operator" asp-controller="Satellite" asp-action="Index" class="btn btn-outline-secondary">
                        @App.Resources.Views.Operator.Satellite.Create.Btn_Cancel
                    </a>
                </div>
            </form>
        </div>

        <div class="card">
            <h5>@App.Resources.Views.Operator.Satellite.Create.Guide_Title</h5>
            <h6 class="mt-3" style="font-size:0.78rem;letter-spacing:0.06em;text-transform:uppercase;color:#8a9bb0;">@App.Resources.Views.Operator.Satellite.Create.Guide_OrbitTypes</h6>
            <table class="table table-sm mb-3">
                <tr><td>LEO</td><td class="font-monospace text-end">6,500,000 – 8,400,000 m</td></tr>
                <tr><td>MEO</td><td class="font-monospace text-end">~26,560,000 m</td></tr>
                <tr><td>GEO</td><td class="font-monospace text-end">42,164,000 m</td></tr>
            </table>
            <h6 style="font-size:0.78rem;letter-spacing:0.06em;text-transform:uppercase;color:#8a9bb0;">@App.Resources.Views.Operator.Satellite.Create.Guide_Inclinations</h6>
            <table class="table table-sm mb-0">
                <tr><td>@App.Resources.Views.Operator.Satellite.Create.Guide_Equatorial</td><td class="font-monospace text-end">0°</td></tr>
                <tr><td>@App.Resources.Views.Operator.Satellite.Create.Guide_Polar</td><td class="font-monospace text-end">~98°</td></tr>
                <tr><td>@App.Resources.Views.Operator.Satellite.Create.Guide_SunSync</td><td class="font-monospace text-end">~90°</td></tr>
            </table>
        </div>

    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
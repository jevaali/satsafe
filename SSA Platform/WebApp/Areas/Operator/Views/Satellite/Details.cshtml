@model App.Application.Features.Satellites.DTOs.SatelliteDetailDto

@{
    ViewData["Title"] = "Satellite Details";
    var statusStr = Model.Status.ToString().ToLower();
}

<link rel="stylesheet" href="~/css/dashboard-ssa.css" asp-append-version="true" />

<div class="ssa-container">

    <div class="system-bar">
        <span class="status-dot"></span>
        SATELLITE DETAIL | @Model.Name | NORAD #@Model.NoradId
    </div>

    <div class="header">
        <div>
            <h3>@Model.Name</h3>
            <small>Satellite Details &amp; Orbital Parameters</small>
        </div>
        <div class="header-right">
            <span class="badge-status @statusStr">@Model.Status</span>
            @if (User.IsInRole("Operator"))
            {
                <a asp-area="Operator" asp-controller="Satellite" asp-action="Edit" asp-route-id="@Model.Id" class="btn-sat btn-sat-edit">
                    <i class="bi bi-pencil"></i> Edit
                </a>
                <a asp-area="Operator" asp-controller="Satellite" asp-action="Delete" asp-route-id="@Model.Id" class="btn-sat btn-sat-delete">
                    <i class="bi bi-trash"></i> Delete
                </a>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="grid">

        <div class="card">
            <h5>Basic Information</h5>
            <table class="table mb-0">
                <tr>
                    <td class="text-muted">Name</td>
                    <td><strong>@Model.Name</strong></td>
                </tr>
                <tr>
                    <td class="text-muted">NORAD ID</td>
                    <td class="font-monospace">@Model.NoradId</td>
                </tr>
                <tr>
                    <td class="text-muted">Status</td>
                    <td><span class="badge-status @statusStr">@Model.Status</span></td>
                </tr>
                <tr>
                    <td class="text-muted">Launch Date</td>
                    <td>@Model.LaunchDate.ToString("yyyy-MM-dd")</td>
                </tr>
            </table>
        </div>

        <div class="card">
            <h5>Orbital Parameters</h5>
            @if (Model.Orbit != null)
            {
                var o = Model.Orbit;
                <table class="table mb-0">
                    <tr>
                        <td class="text-muted">Semi-Major Axis</td>
                        <td class="fw-bold">@o.SemiMajorAxis.ToString("N0") m</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Eccentricity</td>
                        <td class="font-monospace">@o.Eccentricity.ToString("F5")</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Inclination</td>
                        <td class="font-monospace">@o.Inclination.ToString("F2")°</td>
                    </tr>
                    <tr>
                        <td class="text-muted">RAAN</td>
                        <td class="font-monospace">@o.RAAN.ToString("F2")°</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Argument of Perigee</td>
                        <td class="font-monospace">@o.ArgumentOfPerigee.ToString("F2")°</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Mean Anomaly</td>
                        <td class="font-monospace">@o.MeanAnomaly.ToString("F2")°</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Orbital Period</td>
                        <td class="font-monospace">
                            @{
                                var periodSec = 2 * Math.PI * Math.Sqrt(Math.Pow(o.SemiMajorAxis, 3) / (3.986004418e14));
                                var periodMin = periodSec / 60;
                            }
                            @periodMin.ToString("F1") min
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted">Altitude (approx)</td>
                        <td class="font-monospace">@((o.SemiMajorAxis - 6_371_000).ToString("N0")) m</td>
                    </tr>
                </table>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <p>No orbital parameters available.</p>
                    @if (User.IsInRole("Operator"))
                    {
                        <a asp-area="Operator" asp-controller="Satellite" asp-action="Edit" asp-route-id="@Model.Id"
                           class="btn-sat btn-sat-edit"><i class="bi bi-pencil"></i> Add Orbit Data</a>
                    }
                </div>
            }
        </div>

    </div>

    <div class="card mt-3">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
            <h5 style="margin:0;"><i class="bi bi-shield-check me-2"></i>Orbit Risk Assessment</h5>
            <form asp-area="Operator" asp-controller="Satellite" asp-action="RegenerateRisk" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-sat btn-sat-edit" style="font-size:0.8rem;">
                    <i class="bi bi-arrow-clockwise"></i> Recalculate
                </button>
            </form>
        </div>
        @if (Model.RiskAssessment != null)
        {
            var ra = Model.RiskAssessment;
            var riskCss = ra.RiskLevel switch {
                "High"   => "text-danger fw-bold",
                "Medium" => "text-warning",
                _        => "text-success"
            };
            var badgeCss = ra.RiskLevel switch {
                "High"   => "bg-danger",
                "Medium" => "bg-warning text-dark",
                _        => "bg-success"
            };
            <table class="table mb-0">
                <tr>
                    <td class="text-muted">Risk Score</td>
                    <td>
                        <span class="@riskCss">@ra.RiskScore.ToString("F4")</span>
                        <span class="badge @badgeCss ms-2">@ra.RiskLevel</span>
                    </td>
                </tr>
                <tr>
                    <td class="text-muted">Model</td>
                    <td class="font-monospace">@ra.ModelVersion</td>
                </tr>
                <tr>
                    <td class="text-muted">Calculated At</td>
                    <td><small>@ra.CalculatedAt.ToString("yyyy-MM-dd HH:mm") UTC</small></td>
                </tr>
            </table>
        }
        else
        {
            <p class="text-muted mb-0">No risk assessment yet. Click <strong>Recalculate</strong> to generate one.</p>
        }
    </div>

    @* Orbit visualisation — only shown when orbital data exists *@
    @if (Model.Orbit != null)
    {
        var o = Model.Orbit;
        <div class="card mt-3 orbit-card">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                <h5 style="margin:0;">Orbital View</h5>
                <small style="color:#6c757d;">
                    @Model.Name &nbsp;·&nbsp;
                    Alt ~@(((o.SemiMajorAxis - 6_371_000) / 1000).ToString("N0")) km &nbsp;·&nbsp;
                    Inc @o.Inclination.ToString("F1")°
                </small>
            </div>
            <div class="orbit-visualization">
                <canvas id="orbitCanvas"></canvas>
            </div>
        </div>
        @await Html.PartialAsync("_GroundTrack", Model.Orbit)

        <script>
            var satelliteData = [@Html.Raw(Json.Serialize(new {
                id   = Model.Id,
                name = Model.Name,
                orbit = new {
                    semiMajorAxis     = o.SemiMajorAxis,
                    eccentricity      = o.Eccentricity,
                    inclination       = o.Inclination,
                    raan              = o.RAAN,
                    argumentOfPerigee = o.ArgumentOfPerigee,
                    meanAnomaly       = o.MeanAnomaly
                }
            }))];
        </script>

        <script src="~/js/orbitalMechanics.js"></script>
        <script src="~/js/orbitRenderer.js"></script>

        <script>
            OrbitRenderer.init({
                canvasId:   'orbitCanvas',
                satellites: satelliteData,
                timeScale:  300,
                showLabels: true,
            });
        </script>
    }

    @{
        var fetchEnabled = (bool)(ViewData["CelesTrakFetchEnabled"] ?? true);
    }

    <div class="card mt-3">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
            <h5 style="margin:0;"><i class="bi bi-broadcast-pin me-2"></i>TLE Records</h5>
            @if (User.IsInRole("Operator") && fetchEnabled)
            {
                <form asp-area="Operator" asp-controller="Satellite" asp-action="FetchTle" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-sat btn-sat-edit" style="font-size:0.8rem;">
                        <i class="bi bi-cloud-download"></i> Fetch from CelesTrak
                    </button>
                </form>
            }
        </div>
        @if (Model.TleRecords.Any())
        {
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>Epoch (UTC)</th>
                        <th>Added At (UTC)</th>
                        <th>Inclination (°)</th>
                        <th>Mean Motion (rev/day)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tle in Model.TleRecords)
                    {
                        <tr>
                            <td><small class="font-monospace">@tle.Epoch.ToString("yyyy-MM-dd HH:mm")</small></td>
                            <td><small class="text-muted">@tle.FetchedAt.ToString("yyyy-MM-dd HH:mm")</small></td>
                            <td class="font-monospace">@tle.Inclination.ToString("F4")</td>
                            <td class="font-monospace">@tle.MeanMotion.ToString("F8")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted mb-0" style="font-size:0.85rem;">No TLE records yet.</p>
        }
    </div>

    @* Manual TLE entry — Operator and OperatorHelper *@
    <div class="card mt-3">
        <h5 style="margin-bottom:12px;"><i class="bi bi-pencil-square me-2"></i>Add TLE Manually</h5>
        <p class="text-muted" style="font-size:0.82rem; margin-bottom:10px;">
            Paste TLE Line 1 and Line 2 (each exactly 69 characters). You can copy these from
            <a href="https://www.space-track.org" target="_blank" rel="noopener">Space-Track.org</a>
            or any other TLE source.
        </p>
        <form asp-area="Operator" asp-controller="Satellite" asp-action="AddTleManually" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="request.SatelliteId" value="@Model.Id" />
            <div class="mb-2">
                <label class="form-label" style="font-size:0.85rem;">TLE Line 1</label>
                <input type="text" name="request.RawLine1" class="form-control form-control-sm font-monospace"
                       placeholder="1 25544U 98067A   26097.50000000  .00007330  00000-0  49679-3 0  9999"
                       maxlength="69" required />
            </div>
            <div class="mb-3">
                <label class="form-label" style="font-size:0.85rem;">TLE Line 2</label>
                <input type="text" name="request.RawLine2" class="form-control form-control-sm font-monospace"
                       placeholder="2 25544  51.6416 208.7236 0007511 311.2271 134.3485 15.49557417447411"
                       maxlength="69" required />
            </div>
            <button type="submit" class="btn-sat btn-sat-edit" style="font-size:0.8rem;">
                <i class="bi bi-plus-lg"></i> Add TLE Record
            </button>
        </form>
    </div>

    <div class="card mt-3 p-3">
        <a asp-area="Operator" asp-controller="Satellite" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Satellites
        </a>
    </div>

</div>

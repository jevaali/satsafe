@model App.Domain.Entities.Satellite

@{
    ViewData["Title"] = "Satellite Details";
    var statusStr = Model.Status.ToString().ToLower();
}

<link rel="stylesheet" href="~/css/dashboard-ssa.css" asp-append-version="true" />

<div class="ssa-container">

    <div class="system-bar">
        <span class="status-dot"></span>
        SATELLITE DETAIL | @Model.Name | NORAD #@Model.NoradId
    </div>

    <div class="header">
        <div>
            <h3>@Model.Name</h3>
            <small>Satellite Details &amp; Orbital Parameters</small>
        </div>
        <div class="header-right">
            <span class="badge-status @statusStr">@Model.Status</span>
            <a asp-area="Operator" asp-controller="Satellite" asp-action="Edit" asp-route-id="@Model.Id" class="btn-sat btn-sat-edit">
                <i class="bi bi-pencil"></i> Edit
            </a>
            <a asp-area="Operator" asp-controller="Satellite" asp-action="Delete" asp-route-id="@Model.Id" class="btn-sat btn-sat-delete">
                <i class="bi bi-trash"></i> Delete
            </a>
        </div>
    </div>

    <div class="grid">

        <div class="card">
            <h5>Basic Information</h5>
            <table class="table mb-0">
                <tr>
                    <td class="text-muted">Name</td>
                    <td><strong>@Model.Name</strong></td>
                </tr>
                <tr>
                    <td class="text-muted">NORAD ID</td>
                    <td class="font-monospace">@Model.NoradId</td>
                </tr>
                <tr>
                    <td class="text-muted">Status</td>
                    <td><span class="badge-status @statusStr">@Model.Status</span></td>
                </tr>
                <tr>
                    <td class="text-muted">Launch Date</td>
                    <td>@Model.LaunchDate.ToString("yyyy-MM-dd")</td>
                </tr>
                <tr>
                    <td class="text-muted">Operator</td>
                    <td>@(Model.Operator?.Name.ToString() ?? Model.OperatorName ?? "—")</td>
                </tr>
                <tr>
                    <td class="text-muted">Created</td>
                    <td><small>@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm") by @Model.CreatedBy</small></td>
                </tr>
            </table>
        </div>

        <div class="card">
            <h5>Orbital Parameters</h5>
            @if (Model.Orbit?.Parameters != null)
            {
                var p = Model.Orbit.Parameters;
                <table class="table mb-0">
                    <tr>
                        <td class="text-muted">Semi-Major Axis</td>
                        <td class="fw-bold">@p.SemiMajorAxis.ToString("N0") m</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Eccentricity</td>
                        <td class="font-monospace">@p.Eccentricity.ToString("F5")</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Inclination</td>
                        <td class="font-monospace">@p.Inclination.ToString("F2")°</td>
                    </tr>
                    <tr>
                        <td class="text-muted">RAAN</td>
                        <td class="font-monospace">@p.RAAN.ToString("F2")°</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Argument of Perigee</td>
                        <td class="font-monospace">@p.ArgumentOfPerigee.ToString("F2")°</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Mean Anomaly</td>
                        <td class="font-monospace">@p.MeanAnomaly.ToString("F2")°</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Orbital Period</td>
                        <td class="font-monospace">
                            @{
                                var periodSec = 2 * Math.PI * Math.Sqrt(Math.Pow(p.SemiMajorAxis, 3) / (3.986004418e14));
                                var periodMin = periodSec / 60;
                            }
                            @periodMin.ToString("F1") min
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted">Altitude (approx)</td>
                        <td class="font-monospace">@((p.SemiMajorAxis - 6_371_000).ToString("N0")) m</td>
                    </tr>
                </table>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <p>No orbital parameters available.</p>
                    <a asp-area="Operator" asp-controller="Satellite" asp-action="Edit" asp-route-id="@Model.Id"
                       class="btn-sat btn-sat-edit"><i class="bi bi-pencil"></i> Add Orbit Data</a>
                </div>
            }
        </div>

    </div>

    @* Orbit visualisation — only shown when orbital data exists *@
    @if (Model.Orbit?.Parameters != null)
    {
        <div class="card mt-3 orbit-card">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                <h5 style="margin:0;">Orbital View</h5>
                <small style="color:#6c757d;">
                    @Model.Name &nbsp;·&nbsp;
                    Alt ~@(((Model.Orbit.Parameters.SemiMajorAxis - 6_371_000) / 1000).ToString("N0")) km &nbsp;·&nbsp;
                    Inc @Model.Orbit.Parameters.Inclination.ToString("F1")°
                </small>
            </div>
            <div class="orbit-visualization">
                <canvas id="orbitCanvas"></canvas>
            </div>
        </div>

        <script>
            var satelliteData = [@Html.Raw(Json.Serialize(new {
                id   = Model.Id,
                name = Model.Name.ToString(),
                orbit = new {
                    semiMajorAxis     = Model.Orbit.Parameters.SemiMajorAxis,
                    eccentricity      = Model.Orbit.Parameters.Eccentricity,
                    inclination       = Model.Orbit.Parameters.Inclination,
                    raan              = Model.Orbit.Parameters.RAAN,
                    argumentOfPerigee = Model.Orbit.Parameters.ArgumentOfPerigee,
                    meanAnomaly       = Model.Orbit.Parameters.MeanAnomaly
                }
            }))];
        </script>

        <script src="~/js/orbitalMechanics.js"></script>
        <script src="~/js/orbitRenderer.js"></script>

        <script>
            OrbitRenderer.init({
                canvasId:   'orbitCanvas',
                satellites: satelliteData,
                timeScale:  300,
                showLabels: true,
            });
        </script>
    }

    <div class="card mt-3 p-3">
        <a asp-area="Operator" asp-controller="Satellite" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Satellites
        </a>
    </div>

</div>

@model IEnumerable<App.Application.Features.Satellites.DTOs.SatelliteSummaryDto>
@using App.Domain.Entities.Enums

@{
ViewData["Title"] = "Satellite Management";
}

<link rel="stylesheet" href="~/css/dashboard-ssa.css" asp-append-version="true" />

<div class="ssa-container">

    <div class="system-bar">
        <span class="status-dot"></span>
        SATELLITE MANAGEMENT |
        @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss") UTC |
        @Model.Count() SATELLITES REGISTERED
    </div>

    <div class="header">
        <div>
            <h3>Satellite Fleet</h3>
            <small>Manage your registered satellites and orbital parameters</small>
        </div>
        <div class="header-right">
            <span class="op-badge resolved"><i class="bi bi-circle-fill" style="font-size:0.45rem;"></i>@Model.Count(s => s.Status == ESatelliteStatus.Active) Active</span>
            <span class="op-badge low">@Model.Count(s => s.Status == ESatelliteStatus.Inactive) Inactive</span>
            @if (User.IsInRole("Operator"))
            {
                <a asp-area="Operator" asp-controller="Satellite" asp-action="Create" class="btn-add">
                    <i class="bi bi-plus-lg"></i> Add Satellite
                </a>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    }

    <div class="sat-card-grid">
        @if (Model.Any())
        {
        @foreach (var sat in Model.OrderBy(s => s.Name))
        {
        var statusStr = sat.Status.ToString().ToLower();
        var orbit     = sat.Orbit;

        <div class="sat-card status-@statusStr">
            <div class="sat-card-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="sat-icon"><i class="bi bi-rocket-takeoff-fill"></i></div>
                    <div>
                        <div class="sat-name">@sat.Name</div>
                        <div class="sat-norad">NORAD #@sat.NoradId</div>
                        @if (sat.RiskLevel != null)
                        {
                            var riskCss = sat.RiskLevel switch {
                                "High"   => "bg-danger",
                                "Medium" => "bg-warning text-dark",
                                _        => "bg-success"
                            };
                            <span class="badge @riskCss mt-1" style="font-size:0.65rem;">
                                <i class="bi bi-shield-fill me-1"></i>@sat.RiskLevel Risk
                            </span>
                        }
                    </div>
                </div>
                <span class="badge-status @statusStr">@sat.Status</span>
            </div>

            <hr class="sat-divider" />

            <div class="sat-meta-grid">
                <div>
                    <div class="sat-meta-label">Launch Date</div>
                    <div class="sat-meta-value">@sat.LaunchDate.ToString("yyyy-MM-dd")</div>
                </div>
                @if (orbit != null)
                {
                <div>
                    <div class="sat-meta-label">Semi-Major Axis</div>
                    <div class="sat-meta-value highlight">@orbit.SemiMajorAxis.ToString("N0") m</div>
                </div>
                <div>
                    <div class="sat-meta-label">Inclination</div>
                    <div class="sat-meta-value">@orbit.Inclination.ToString("F2")°</div>
                </div>
                <div>
                    <div class="sat-meta-label">Eccentricity</div>
                    <div class="sat-meta-value">@orbit.Eccentricity.ToString("F5")</div>
                </div>
                }
                else
                {
                <div>
                    <div class="sat-meta-label">Orbit Data</div>
                    <div class="sat-meta-value muted">Not available</div>
                </div>
                }
            </div>

            @if (orbit != null)
            {
            <div class="sat-orbit-bar">
                <i class="bi bi-arrow-repeat sat-orbit-icon"></i>
                <span class="sat-orbit-text">
                    RAAN @orbit.RAAN.ToString("F2")° &nbsp;·&nbsp;
                    AoP @orbit.ArgumentOfPerigee.ToString("F2")° &nbsp;·&nbsp;
                    M₀ @orbit.MeanAnomaly.ToString("F2")°
                </span>
            </div>
            }

            <div class="sat-actions">
                <a asp-area="Operator" asp-controller="Satellite" asp-action="Details" asp-route-id="@sat.Id" class="btn-sat btn-sat-view">
                    <i class="bi bi-eye"></i> View
                </a>
                @if (User.IsInRole("Operator"))
                {
                <a asp-area="Operator" asp-controller="Satellite" asp-action="Edit" asp-route-id="@sat.Id" class="btn-sat btn-sat-edit">
                    <i class="bi bi-pencil"></i> Edit
                </a>
                <a asp-area="Operator" asp-controller="Satellite" asp-action="Delete" asp-route-id="@sat.Id" class="btn-sat btn-sat-delete">
                    <i class="bi bi-trash"></i> Delete
                </a>
                }
            </div>
        </div>
        }
        }
        else
        {
        <div class="empty-state">
            <p>No satellites registered to your operator account.</p>
            @if (User.IsInRole("Operator"))
            {
                <a asp-area="Operator" asp-controller="Satellite" asp-action="Create" class="btn-add">
                    <i class="bi bi-plus-lg"></i> Add Your First Satellite
                </a>
            }
        </div>
        }
    </div>

</div>

@model IEnumerable<App.Domain.Entities.Satellite>

@{
    ViewData["Title"] = "Satellite Management";
}

<div class="container">
    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Error Message -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row py-4">
        <div class="col-12">
            <h1 class="display-4 fw-bold text-primary">Satellite Management</h1>
            <p class="lead text-muted mb-4">
                Manage your satellite fleet. Add, edit, or remove satellites from your operator account.
            </p>
        </div>
    </div>

    <div class="row py-2">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-area="Operator" asp-controller="Home" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Satellites</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Add Button -->
    <div class="row py-3">
        <div class="col-12 d-flex justify-content-end">
            <a asp-area="Operator" asp-controller="Satellite" asp-action="Create" class="btn btn-primary btn-lg">
                <i class="bi bi-plus-circle me-2"></i>Add Satellite
            </a>
        </div>
    </div>

    <div class="row py-3">
        <div class="col-12">
            @if (Model.Any())
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>
                                            @Html.DisplayNameFor(model => model.Name)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.NoradId)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.Status)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.LaunchDate)
                                        </th>
                                        <th>
                                            Orbit
                                        </th>
                                        <th class="text-center">
                                            Actions
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@Html.DisplayFor(modelItem => item.Name)</strong>
                                            </td>
                                            <td>
                                                <span class="text-muted">@Html.DisplayFor(modelItem => item.NoradId)</span>
                                            </td>
                                            <td>
                                                <span class="badge bg-@(item.Status.ToString().ToLower())">
                                                    @Html.DisplayFor(modelItem => item.Status)
                                                </span>
                                            </td>
                                            <td>
                                                @item.LaunchDate.ToShortDateString()
                                            </td>
                                            <td>
                                                @if (item.Orbit?.Parameters != null)
                                                {
                                                    <span class="text-muted">@item.Orbit.Parameters.SemiMajorAxis.ToString("N0") km</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    <a asp-area="Operator" asp-controller="Satellite" asp-action="Details" asp-route-id="@item.Id" 
                                                       class="btn btn-sm btn-outline-info" title="Details">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                    <a asp-area="Operator" asp-controller="Satellite" asp-action="Edit" asp-route-id="@item.Id" 
                                                       class="btn btn-sm btn-outline-warning" title="Edit">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>
                                                    <a asp-area="Operator" asp-controller="Satellite" asp-action="Delete" asp-route-id="@item.Id" 
                                                       class="btn btn-sm btn-outline-danger" title="Delete">
                                                        <i class="bi bi-trash"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center py-5">
                        <div class="mb-3">
                            <i class="bi bi-satellite fs-1 text-muted"></i>
                        </div>
                        <h3 class="text-muted">No Satellites Found</h3>
                        <p class="text-muted mb-4">You don't have any satellites in your fleet yet.</p>
                        <a asp-area="Operator" asp-controller="Satellite" asp-action="Create" class="btn btn-primary">
                            <i class="bi bi-plus-circle me-2"></i>Add Your First Satellite
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="row py-3">
        <div class="col-12">
            <a asp-area="Operator" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-2"></i>Back to Dashboard
            </a>
        </div>
    </div>
</div>

<style>
    .btn-group .btn {
        border-radius: 0;
    }
    .btn-group .btn:first-child {
        border-top-left-radius: 0.375rem;
        border-bottom-left-radius: 0.375rem;
    }
    .btn-group .btn:last-child {
        border-top-right-radius: 0.375rem;
        border-bottom-right-radius: 0.375rem;
    }
    .badge.bg-active {
        background-color: #198754 !important;
    }
    .badge.bg-inactive {
        background-color: #6c757d !important;
    }
    .badge.bg-deleted {
        background-color: #dc3545 !important;
    }
</style>
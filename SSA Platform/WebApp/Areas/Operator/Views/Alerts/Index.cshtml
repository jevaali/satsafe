@model IEnumerable<App.Domain.Entities.Alert>
@using App.Domain.Entities.Enums

@{
    ViewData["Title"] = "Alerts";
}

<link rel="stylesheet" href="~/css/dashboard-ssa.css" asp-append-version="true" />

<div class="ssa-container">

    <div class="system-bar">
        <span class="status-dot"></span>
        ALERTS | @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss") UTC | @Model.Count() ALERTS LOADED
    </div>

    <div class="header">
        <div>
            <h3>Alerts</h3>
            <small>System-generated alerts for your conjunction events</small>
        </div>
        <div class="header-right">
            <span class="badge danger">@Model.Count(a => !a.IsAcknowledged) UNACKNOWLEDGED</span>
            <span class="badge bg-dark text-white">@Model.Count(a => a.Severity == EAlertSeverity.Critical) CRITICAL</span>
        </div>
    </div>

    <!-- FILTER BAR -->
    <div class="card mb-3 p-3">
        <div class="d-flex gap-3 align-items-center flex-wrap">
            <input type="text" id="searchInput" class="form-control w-auto"
                   placeholder="Search by message..." />
            <select id="severityFilter" class="form-select w-auto">
                <option value="">All Severities</option>
                @foreach (var sev in Enum.GetValues<EAlertSeverity>())
                {
                    <option value="@sev">@sev</option>
                }
            </select>
            <select id="statusFilter" class="form-select w-auto">
                <option value="">All Statuses</option>
                <option value="unacknowledged">Unacknowledged</option>
                <option value="acknowledged">Acknowledged</option>
            </select>
        </div>
    </div>

    <!-- TABLE -->
    <div class="card">
        <table class="table table-hover mb-0" id="alertTable">
            <thead>
                <tr>
                    <th>Severity</th>
                    <th>Message</th>
                    <th>Conjunction Event</th>
                    <th>Created</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var alert in Model.OrderByDescending(a => !a.IsAcknowledged)
                                            .ThenByDescending(a => a.Severity)
                                            .ThenByDescending(a => a.CreatedAt))
                {
                    var rowClass = alert.Severity switch {
                        EAlertSeverity.Critical => "table-danger",
                        EAlertSeverity.High     => "table-warning",
                        _                       => ""
                    };
                    var severityBadge = alert.Severity switch {
                        EAlertSeverity.Critical => "bg-danger",
                        EAlertSeverity.High     => "bg-warning text-dark",
                        EAlertSeverity.Medium   => "bg-info text-dark",
                        _                       => "bg-secondary"
                    };
                    var message = alert.Message?.ToString() ?? "—";
                    var ackStatus = alert.IsAcknowledged ? "acknowledged" : "unacknowledged";

                    <tr class="alert-row @rowClass"
                        data-message="@message.ToLower()"
                        data-severity="@alert.Severity"
                        data-status="@ackStatus">
                        <td>
                            <span class="badge @severityBadge">@alert.Severity</span>
                        </td>
                        <td>@message</td>
                        <td>
                            @if (alert.ConjunctionEvent != null)
                            {
                                <a asp-area="Operator" asp-controller="Conjunctions" asp-action="Details"
                                   asp-route-id="@alert.ConjunctionEventId"
                                   class="text-decoration-none">
                                    @alert.ConjunctionEventId.ToString()[..8]…
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">@alert.ConjunctionEventId.ToString()[..8]…</span>
                            }
                        </td>
                        <td>@alert.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            @if (alert.IsAcknowledged)
                            {
                                <span class="badge bg-success">Acknowledged</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@alert.Id"
                               class="btn btn-sm btn-outline-primary">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <p>No alerts found.</p>
            </div>
        }
    </div>

</div>

@section Scripts {
    <script>
        const searchInput    = document.getElementById('searchInput');
        const severityFilter = document.getElementById('severityFilter');
        const statusFilter   = document.getElementById('statusFilter');
        const rows           = document.querySelectorAll('.alert-row');

        function applyFilters() {
            const search   = searchInput.value.toLowerCase();
            const severity = severityFilter.value.toLowerCase();
            const status   = statusFilter.value.toLowerCase();

            rows.forEach(row => {
                const matchSearch   = !search   || row.dataset.message.includes(search);
                const matchSeverity = !severity || row.dataset.severity.toLowerCase() === severity;
                const matchStatus   = !status   || row.dataset.status === status;

                row.style.display = matchSearch && matchSeverity && matchStatus ? '' : 'none';
            });
        }

        searchInput.addEventListener('input', applyFilters);
        severityFilter.addEventListener('change', applyFilters);
        statusFilter.addEventListener('change', applyFilters);
    </script>
}
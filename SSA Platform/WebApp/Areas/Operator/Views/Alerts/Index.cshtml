@model IEnumerable<App.Application.Features.Alerts.DTOs.AlertSummaryDto>
@using App.Domain.Entities.Enums

@{
    ViewData["Title"] = "Alerts";
}

<link rel="stylesheet" href="~/css/dashboard-ssa.css" asp-append-version="true" />

<div class="ssa-container">

    <div class="system-bar">
        <span class="status-dot"></span>
        ALERTS | @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss") UTC | @Model.Count() ALERTS LOADED
    </div>

    <div class="header">
        <div>
            <h3>Alerts</h3>
            <small>System-generated alerts for your conjunction events</small>
        </div>
        <div class="header-right">
            <span class="op-badge high-risk"><i class="bi bi-bell-fill"></i>@Model.Count(a => !a.IsAcknowledged) Unacknowledged</span>
            <span class="op-badge critical">@Model.Count(a => a.Severity == EAlertSeverity.Critical) Critical</span>
        </div>
    </div>

    <!-- FILTER BAR -->
    <div class="op-filter-card">
        <div class="op-filter-bar">
            <div class="op-filter-search">
                <i class="bi bi-search"></i>
                <input type="text" id="searchInput" placeholder="Search by message…" />
            </div>
            <select id="severityFilter">
                <option value="">All Severities</option>
                @foreach (var sev in Enum.GetValues<EAlertSeverity>())
                {
                    <option value="@sev">@sev</option>
                }
            </select>
            <select id="statusFilter">
                <option value="">All Statuses</option>
                <option value="unacknowledged">Unacknowledged</option>
                <option value="acknowledged">Acknowledged</option>
            </select>
        </div>

        <table class="op-table" id="alertTable">
            <thead>
                <tr>
                    <th>Severity</th>
                    <th>Message</th>
                    <th>Conjunction</th>
                    <th>Created</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var alert in Model.OrderByDescending(a => !a.IsAcknowledged)
                                            .ThenByDescending(a => a.Severity)
                                            .ThenByDescending(a => a.CreatedAt))
                {
                    var severityClass = alert.Severity switch {
                        EAlertSeverity.Critical => "critical",
                        EAlertSeverity.High     => "high",
                        EAlertSeverity.Medium   => "medium",
                        _                       => "low"
                    };
                    var message = alert.Message ?? "—";
                    var ackStatus = alert.IsAcknowledged ? "acknowledged" : "unacknowledged";

                    <tr class="alert-row @(alert.Severity == EAlertSeverity.Critical ? "row-high-risk" : "")"
                        data-message="@message.ToLower()"
                        data-severity="@alert.Severity"
                        data-status="@ackStatus">
                        <td><span class="op-badge @severityClass">@alert.Severity</span></td>
                        <td style="font-size:0.85rem;color:#2c3e50;">@message</td>
                        <td>
                            @if (alert.HasConjunctionEvent)
                            {
                                <a asp-area="Operator" asp-controller="Conjunctions" asp-action="Details"
                                   asp-route-id="@alert.ConjunctionEventId"
                                   class="text-decoration-none" style="font-family:'Share Tech Mono',monospace;font-size:0.78rem;color:#1565c0;">
                                    @alert.ConjunctionEventId.ToString()[..8]…
                                </a>
                            }
                            else
                            {
                                <span style="font-family:'Share Tech Mono',monospace;font-size:0.78rem;color:#8a9bb0;">@alert.ConjunctionEventId.ToString()[..8]…</span>
                            }
                        </td>
                        <td style="font-family:'Share Tech Mono',monospace;font-size:0.78rem;color:#8a9bb0;">@alert.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td><span class="op-badge @(alert.IsAcknowledged ? "acked" : "pending")">@(alert.IsAcknowledged ? "Acknowledged" : "Pending")</span></td>
                        <td>
                            <a asp-action="Details" asp-route-id="@alert.Id" class="btn-sat btn-sat-view">
                                <i class="bi bi-eye"></i> Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <p>No alerts found.</p>
            </div>
        }
    </div>

</div>

@section Scripts {
    <script>
        const searchInput    = document.getElementById('searchInput');
        const severityFilter = document.getElementById('severityFilter');
        const statusFilter   = document.getElementById('statusFilter');
        const rows           = document.querySelectorAll('.alert-row');

        function applyFilters() {
            const search   = searchInput.value.toLowerCase();
            const severity = severityFilter.value.toLowerCase();
            const status   = statusFilter.value.toLowerCase();

            rows.forEach(row => {
                const matchSearch   = !search   || row.dataset.message.includes(search);
                const matchSeverity = !severity || row.dataset.severity.toLowerCase() === severity;
                const matchStatus   = !status   || row.dataset.status === status;

                row.style.display = matchSearch && matchSeverity && matchStatus ? '' : 'none';
            });
        }

        searchInput.addEventListener('input', applyFilters);
        severityFilter.addEventListener('change', applyFilters);
        statusFilter.addEventListener('change', applyFilters);
    </script>
}
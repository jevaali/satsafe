@page
@model WebApp.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Create Account</h4>
            </div>
            <div class="card-body">
                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    
                    <h5 class="mb-3">Personal Information</h5>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.FirstName" class="form-label"></label>
                            <input asp-for="Input.FirstName" class="form-control" autocomplete="given-name" />
                            <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.LastName" class="form-label"></label>
                            <input asp-for="Input.LastName" class="form-control" autocomplete="family-name" />
                            <span asp-validation-for="Input.LastName" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label"></label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label"></label>
                        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <hr />
                    
                    <div class="form-check mb-3">
                        <input asp-for="Input.RegisterAsOperator" class="form-check-input" id="registerAsOperator" />
                        <label asp-for="Input.RegisterAsOperator" class="form-check-label fw-bold"></label>
                    </div>
                    
                    <div id="operatorFields" class="border rounded p-3 mb-3 bg-light" style="display: none;">
                        <h5 class="mb-3">Operator Information</h5>
                        <div class="mb-3">
                            <label asp-for="Input.OperatorName" class="form-label"></label>
                            <input asp-for="Input.OperatorName" class="form-control" />
                            <span asp-validation-for="Input.OperatorName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.OperatorCountry" class="form-label"></label>
                            <input type="text" id="country-search" class="form-control mb-1" placeholder="Search country…" autocomplete="off" />
                            <select asp-for="Input.OperatorCountry" id="country-select"
                                    class="form-select" asp-items="Model.Countries">
                            </select>
                            <span asp-validation-for="Input.OperatorCountry" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.OperatorType" class="form-label"></label>
                            <select asp-for="Input.OperatorType" class="form-select"
                                    asp-items="Html.GetEnumSelectList<App.Domain.Entities.Enums.EOperatorType>()">
                                <option value="">— Select type —</option>
                            </select>
                            <span asp-validation-for="Input.OperatorType" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <button id="registerSubmit" type="submit" class="btn btn-primary w-100">Register</button>
                </form>
            </div>
            <div class="card-footer text-center">
                <p class="mb-0">Already have an account? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('registerAsOperator').addEventListener('change', function () {
            const operatorFields = document.getElementById('operatorFields');
            operatorFields.style.display = this.checked ? 'block' : 'none';
        });

        (function () {
            const search = document.getElementById('country-search');
            const select = document.getElementById('country-select');
            const allOptions = Array.from(select.options);

            search.addEventListener('input', function () {
                const q = this.value.toLowerCase();
                select.innerHTML = '';
                allOptions
                    .filter(o => o.text.toLowerCase().includes(q))
                    .forEach(o => select.appendChild(o));
            });
        })();
    </script>
}
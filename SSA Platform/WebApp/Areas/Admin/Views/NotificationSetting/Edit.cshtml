@model NotificationSettingFormViewModel

@{
    ViewData["Title"] = "Edit Notification Setting";
}

<div class="admin-page-header">
    <div>
        <div class="admin-page-title">Edit Notification Setting</div>
        <div class="admin-page-subtitle">Update user notification preferences</div>
    </div>
    <a asp-action="Index" class="btn-ssa-ghost"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="card admin-form">
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>
        <input type="hidden" asp-for="Id" />

        <div class="form-group mb-3">
            <label asp-for="AppUserId" class="form-label"></label>
            <select asp-for="AppUserId" class="form-select" asp-items="Model.UserOptions"></select>
            <span asp-validation-for="AppUserId" class="text-danger small"></span>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="ConjunctionThresholdKm" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="ConjunctionThresholdKm" class="form-control" />
                    <span class="input-group-text">km</span>
                </div>
                <span asp-validation-for="ConjunctionThresholdKm" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="AlertThresholdKm" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="AlertThresholdKm" class="form-control" />
                    <span class="input-group-text">km</span>
                </div>
                <span asp-validation-for="AlertThresholdKm" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-3">
            <div class="form-check form-switch">
                <input class="form-check-input" asp-for="EmailEnabled" role="switch" />
                <label class="form-check-label" asp-for="EmailEnabled">Enable email notifications</label>
            </div>
        </div>
        <div class="mb-3">
            <div class="form-check form-switch">
                <input class="form-check-input" asp-for="SmsEnabled" role="switch" />
                <label class="form-check-label" asp-for="SmsEnabled">Enable SMS notifications</label>
            </div>
        </div>

        <div class="admin-form-actions">
            <button type="submit" class="btn-ssa-primary"><i class="bi bi-check-lg"></i> Save Changes</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn-ssa-ghost">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

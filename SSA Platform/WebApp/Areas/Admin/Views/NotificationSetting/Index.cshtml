@model IEnumerable<App.Domain.Entities.NotificationSetting>

@{
    ViewData["Title"] = "Notification Settings";
}

<link rel="stylesheet" href="~/css/dashboard-ssa.css" asp-append-version="true" />

<div class="ssa-container">

    <div class="system-bar">
        <span class="status-dot"></span>
        ADMIN | NOTIFICATION SETTINGS |
        @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss") UTC |
        @Model.Count() SETTINGS
    </div>

    <div class="header">
        <div>
            <h3>Notification Settings</h3>
            <small>Per-user notification preferences and thresholds</small>
        </div>
        <div class="header-right">
            <a asp-action="Create" class="btn-add"><i class="bi bi-plus-lg"></i> Add Setting</a>
        </div>
    </div>

    <div class="card">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Threshold (km)</th>
                    <th>Email</th>
                    <th>SMS</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (item.AppUser != null)
                            {
                                <span>@($"{item.AppUser.FirstName} {item.AppUser.LastName}".Trim())</span>
                            }
                            else { <span class="text-muted">—</span> }
                        </td>
                        <td>@item.ConjunctionThresholdKm km</td>
                        <td>
                            @if (item.EmailEnabled)
                            { <span class="badge bg-success">On</span> }
                            else
                            { <span class="badge bg-secondary">Off</span> }
                        </td>
                        <td>
                            @if (item.SmsEnabled)
                            { <span class="badge bg-success">On</span> }
                            else
                            { <span class="badge bg-secondary">Off</span> }
                        </td>
                        <td class="tbl-actions">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-sat btn-sat-view"><i class="bi bi-eye"></i> View</a>
                            <a asp-action="Edit"    asp-route-id="@item.Id" class="btn-sat btn-sat-edit"><i class="bi bi-pencil"></i> Edit</a>
                            <a asp-action="Delete"  asp-route-id="@item.Id" class="btn-sat btn-sat-delete"><i class="bi bi-trash"></i> Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <p>No notification settings found.</p>
                <a asp-action="Create" class="btn-add"><i class="bi bi-plus-lg"></i> Add Setting</a>
            </div>
        }
    </div>

</div>

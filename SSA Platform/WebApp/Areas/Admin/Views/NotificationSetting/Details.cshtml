@model NotificationSettingDetailViewModel

@{
    ViewData["Title"] = "Notification Setting Details";
}

<div class="admin-page-header">
    <div>
        <div class="admin-page-title">Notification Setting</div>
        <div class="admin-page-subtitle">@Model.UserName</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-sat btn-sat-edit"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-action="Index" class="btn-ssa-ghost"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="admin-section-heading mb-3"><i class="bi bi-bell-fill"></i> Notification Preferences</div>
            <dl class="admin-detail-grid">
                <div class="admin-detail-item">
                    <dt>User</dt>
                    <dd><strong>@Model.UserName</strong></dd>
                </div>
                <div class="admin-detail-item">
                    <dt>Email</dt>
                    <dd>@Model.UserEmail</dd>
                </div>
                <div class="admin-detail-item">
                    <dt>Conjunction Threshold</dt>
                    <dd>@Model.ConjunctionThresholdKm km</dd>
                </div>
                <div class="admin-detail-item">
                    <dt>Alert Threshold</dt>
                    <dd>@Model.AlertThresholdKm km</dd>
                </div>
                <div class="admin-detail-item">
                    <dt>Email Notifications</dt>
                    <dd>
                        @if (Model.EmailEnabled)
                        { <span class="badge bg-success">Enabled</span> }
                        else
                        { <span class="badge bg-secondary">Disabled</span> }
                    </dd>
                </div>
                <div class="admin-detail-item">
                    <dt>SMS Notifications</dt>
                    <dd>
                        @if (Model.SmsEnabled)
                        { <span class="badge bg-success">Enabled</span> }
                        else
                        { <span class="badge bg-secondary">Disabled</span> }
                    </dd>
                </div>
            </dl>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="admin-section-heading mb-3"><i class="bi bi-clock-history"></i> Metadata</div>
            <dl class="admin-detail-grid" style="grid-template-columns:1fr;">
                <div class="admin-detail-item"><dt>Created By</dt><dd>@(Model.CreatedBy ?? "—")</dd></div>
                <div class="admin-detail-item"><dt>Created At</dt><dd>@(Model.CreatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd></div>
                <div class="admin-detail-item"><dt>Updated At</dt><dd>@(Model.UpdatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd></div>
            </dl>
        </div>
    </div>
</div>

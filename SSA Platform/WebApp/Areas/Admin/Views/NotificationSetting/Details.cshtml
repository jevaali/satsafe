@model App.Domain.Entities.NotificationSetting

@{
    ViewData["Title"] = "Notification Setting Details";
}

<link rel="stylesheet" href="~/css/dashboard-ssa.css" asp-append-version="true" />

<div class="ssa-container">

    <div class="system-bar">
        <span class="status-dot"></span>
        ADMIN | NOTIFICATION SETTINGS | DETAILS
    </div>

    <div class="header">
        <div>
            <h3>Notification Setting</h3>
            <small>@(Model.AppUser != null ? $"{Model.AppUser.FirstName} {Model.AppUser.LastName}".Trim() : "User setting")</small>
        </div>
        <div style="display:flex;gap:0.5rem;">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-sat btn-sat-edit"><i class="bi bi-pencil"></i> Edit</a>
            <a asp-action="Index" class="btn-ssa-ghost"><i class="bi bi-arrow-left"></i> Back</a>
        </div>
    </div>

    <div class="card">
        <dl class="admin-detail-grid">
            <div class="admin-detail-item">
                <dt>User</dt>
                <dd>@(Model.AppUser != null ? $"{Model.AppUser.FirstName} {Model.AppUser.LastName}".Trim() : "—")</dd>
            </div>
            <div class="admin-detail-item">
                <dt>@Html.DisplayNameFor(m => m.ConjunctionThresholdKm)</dt>
                <dd>@Model.ConjunctionThresholdKm km</dd>
            </div>
            <div class="admin-detail-item">
                <dt>@Html.DisplayNameFor(m => m.EmailEnabled)</dt>
                <dd>@(Model.EmailEnabled ? "Enabled" : "Disabled")</dd>
            </div>
            <div class="admin-detail-item">
                <dt>@Html.DisplayNameFor(m => m.SmsEnabled)</dt>
                <dd>@(Model.SmsEnabled ? "Enabled" : "Disabled")</dd>
            </div>
        </dl>
    </div>

</div>

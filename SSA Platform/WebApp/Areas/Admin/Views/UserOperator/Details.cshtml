@model UserOperatorDetailViewModel

@{
    ViewData["Title"] = "User–Operator Link Details";
}

<div class="admin-page-header">
    <div>
        <div class="admin-page-title">User–Operator Link</div>
        <div class="admin-page-subtitle">Association record</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-sat btn-sat-edit"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-action="Index" class="btn-ssa-ghost"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

<div class="card">
    <div class="admin-section-heading mb-3"><i class="bi bi-person-badge"></i> Link Details</div>
    <dl class="admin-detail-grid">
        <div class="admin-detail-item">
            <dt>User</dt>
            <dd><strong>@Model.UserName</strong></dd>
        </div>
        <div class="admin-detail-item">
            <dt>Email</dt>
            <dd>@Model.UserEmail</dd>
        </div>
        <div class="admin-detail-item">
            <dt>Operator</dt>
            <dd>
                <a asp-area="Admin" asp-controller="Operator" asp-action="Details"
                   asp-route-id="@Model.OperatorId" class="text-decoration-none">
                    @Model.OperatorName
                </a>
            </dd>
        </div>
    </dl>
</div>

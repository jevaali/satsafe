@model UserOperatorIndexViewModel

@{
    ViewData["Title"] = "User–Operator Links";
}

<div class="admin-page-header">
    <div>
        <div class="admin-page-title">User–Operator Links</div>
        <div class="admin-page-subtitle">Associations between platform users and operators</div>
    </div>
    <a asp-action="Create" class="btn-add"><i class="bi bi-plus-lg"></i> Add Link</a>
</div>

<div class="admin-stat-row mb-4" style="grid-template-columns:repeat(1,minmax(140px,200px));">
    <div class="admin-stat-card">
        <div class="admin-stat-icon blue"><i class="bi bi-people"></i></div>
        <div><div class="admin-stat-value">@Model.TotalCount</div><div class="admin-stat-label">Total Links</div></div>
    </div>
</div>

<div class="card">
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>User</th>
                <th>Operator</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Links)
            {
                <tr>
                    <td>
                        <strong>@item.UserName</strong>
                        <br /><small class="text-muted">@item.UserEmail</small>
                    </td>
                    <td><strong>@item.OperatorName</strong></td>
                    <td class="tbl-actions">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn-sat btn-sat-view"><i class="bi bi-eye"></i></a>
                        <a asp-action="Edit"    asp-route-id="@item.Id" class="btn-sat btn-sat-edit"><i class="bi bi-pencil"></i></a>
                        <a asp-action="Delete"  asp-route-id="@item.Id" class="btn-sat btn-sat-delete"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Links.Any())
    {
        <div class="empty-state"><p>No user–operator links found.</p></div>
    }
</div>

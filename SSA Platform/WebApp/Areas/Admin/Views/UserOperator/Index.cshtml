@model IEnumerable<App.Domain.Entities.UserOperator>

@{
    ViewData["Title"] = "User–Operator Links";
}

<link rel="stylesheet" href="~/css/dashboard-ssa.css" asp-append-version="true" />

<div class="ssa-container">

    <div class="system-bar">
        <span class="status-dot"></span>
        ADMIN | USER–OPERATOR LINKS |
        @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss") UTC |
        @Model.Count() LINKS
    </div>

    <div class="header">
        <div>
            <h3>User–Operator Links</h3>
            <small>Associations between platform users and operators</small>
        </div>
        <div class="header-right">
            <a asp-action="Create" class="btn-add"><i class="bi bi-plus-lg"></i> Add Link</a>
        </div>
    </div>

    <div class="card">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Operator</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (item.AppUser != null)
                            {
                                <span>@($"{item.AppUser.FirstName} {item.AppUser.LastName}".Trim())</span>
                                <br /><small class="text-muted">@item.AppUser.Email</small>
                            }
                            else { <span class="text-muted">—</span> }
                        </td>
                        <td><strong>@(item.Operator?.Name.ToString() ?? "—")</strong></td>
                        <td class="tbl-actions">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-sat btn-sat-view"><i class="bi bi-eye"></i> View</a>
                            <a asp-action="Edit"    asp-route-id="@item.Id" class="btn-sat btn-sat-edit"><i class="bi bi-pencil"></i> Edit</a>
                            <a asp-action="Delete"  asp-route-id="@item.Id" class="btn-sat btn-sat-delete"><i class="bi bi-trash"></i> Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <p>No user–operator links found.</p>
                <a asp-action="Create" class="btn-add"><i class="bi bi-plus-lg"></i> Add Link</a>
            </div>
        }
    </div>

</div>

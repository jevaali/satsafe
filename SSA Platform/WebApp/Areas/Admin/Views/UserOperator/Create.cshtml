@model UserOperatorFormViewModel

@{
    ViewData["Title"] = "Add User–Operator Link";
}

<div class="admin-page-header">
    <div>
        <div class="admin-page-title">Add User–Operator Link</div>
        <div class="admin-page-subtitle">Associate a user with an operator organisation</div>
    </div>
    <a asp-action="Index" class="btn-ssa-ghost"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="card admin-form">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

        <div class="form-group mb-3">
            <label asp-for="AppUserId" class="form-label"></label>
            <select asp-for="AppUserId" class="form-select" asp-items="Model.UserOptions">
                <option value="">— Select user —</option>
            </select>
            <span asp-validation-for="AppUserId" class="text-danger small"></span>
        </div>
        <div class="form-group mb-3">
            <label asp-for="OperatorId" class="form-label"></label>
            <select asp-for="OperatorId" class="form-select" asp-items="Model.OperatorOptions">
                <option value="">— Select operator —</option>
            </select>
            <span asp-validation-for="OperatorId" class="text-danger small"></span>
        </div>

        <div class="admin-form-actions">
            <button type="submit" class="btn-ssa-primary"><i class="bi bi-check-lg"></i> Create Link</button>
            <a asp-action="Index" class="btn-ssa-ghost">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

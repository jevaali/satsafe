@model App.Domain.Entities.UserOperator

@{
    ViewData["Title"] = "Add User–Operator Link";
}

<link rel="stylesheet" href="~/css/dashboard-ssa.css" asp-append-version="true" />

<div class="ssa-container">

    <div class="system-bar">
        <span class="status-dot"></span>
        ADMIN | USER–OPERATOR LINKS | NEW LINK
    </div>

    <div class="header">
        <div>
            <h3>Add User–Operator Link</h3>
            <small>Associate a user with an operator organisation</small>
        </div>
        <div>
            <a asp-action="Index" class="btn-ssa-ghost"><i class="bi bi-arrow-left"></i> Back</a>
        </div>
    </div>

    <div class="card admin-form">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group">
                <label asp-for="AppUserId" class="control-label"></label>
                <select asp-for="AppUserId" class="form-control" asp-items="ViewBag.AppUserId"></select>
            </div>
            <div class="form-group">
                <label asp-for="OperatorId" class="control-label"></label>
                <select asp-for="OperatorId" class="form-control" asp-items="ViewBag.OperatorId"></select>
            </div>

            <div class="admin-form-actions">
                <button type="submit" class="btn-ssa-primary"><i class="bi bi-check-lg"></i> Create Link</button>
                <a asp-action="Index" class="btn-ssa-ghost">Cancel</a>
            </div>
        </form>
    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

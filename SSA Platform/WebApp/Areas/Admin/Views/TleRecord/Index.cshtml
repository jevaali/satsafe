@model TleRecordIndexViewModel

@{
    ViewData["Title"] = "TLE Records";
}

<div class="admin-page-header">
    <div>
        <div class="admin-page-title">TLE Records</div>
        <div class="admin-page-subtitle">Two-Line Element sets for tracked space objects</div>
    </div>
    <a asp-action="Create" class="btn-add"><i class="bi bi-plus-lg"></i> Add TLE</a>
</div>

<div class="admin-stat-row mb-4" style="grid-template-columns:repeat(1,minmax(140px,200px));">
    <div class="admin-stat-card">
        <div class="admin-stat-icon teal"><i class="bi bi-database"></i></div>
        <div><div class="admin-stat-value">@Model.TotalCount</div><div class="admin-stat-label">Total Records</div></div>
    </div>
</div>

<div class="card">
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>Space Object (NORAD)</th>
                <th>Epoch (UTC)</th>
                <th>Inclination (°)</th>
                <th>RAAN (°)</th>
                <th>Eccentricity</th>
                <th>Mean Motion</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Records)
            {
                <tr>
                    <td><strong>@item.SpaceObjectNorad</strong></td>
                    <td><small>@item.Epoch.ToString("yyyy-MM-dd HH:mm")</small></td>
                    <td>@item.Inclination.ToString("F4")</td>
                    <td>@item.RAAN.ToString("F4")</td>
                    <td>@item.Eccentricity.ToString("F7")</td>
                    <td>@item.MeanMotion.ToString("F8")</td>
                    <td class="tbl-actions">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn-sat btn-sat-view"><i class="bi bi-eye"></i></a>
                        <a asp-action="Edit"    asp-route-id="@item.Id" class="btn-sat btn-sat-edit"><i class="bi bi-pencil"></i></a>
                        <a asp-action="Delete"  asp-route-id="@item.Id" class="btn-sat btn-sat-delete"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Records.Any())
    {
        <div class="empty-state"><p>No TLE records found.</p></div>
    }
</div>

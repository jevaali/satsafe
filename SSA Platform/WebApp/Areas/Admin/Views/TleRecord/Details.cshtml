@model TleRecordDetailViewModel

@{
    ViewData["Title"] = "TLE Record Details";
}

<div class="admin-page-header">
    <div>
        <div class="admin-page-title">TLE Record</div>
        <div class="admin-page-subtitle">@Model.SpaceObjectNorad — Epoch @Model.Epoch.ToString("yyyy-MM-dd HH:mm") UTC</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-sat btn-sat-edit"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-action="Index" class="btn-ssa-ghost"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="admin-section-heading mb-3"><i class="bi bi-globe2"></i> Orbital Parameters</div>
            <dl class="admin-detail-grid">
                <div class="admin-detail-item">
                    <dt>Space Object (NORAD)</dt>
                    <dd><strong>@Model.SpaceObjectNorad</strong></dd>
                </div>
                <div class="admin-detail-item">
                    <dt>Epoch</dt>
                    <dd>@Model.Epoch.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd>
                </div>
                <div class="admin-detail-item">
                    <dt>Inclination (°)</dt>
                    <dd>@Model.Inclination.ToString("F6")</dd>
                </div>
                <div class="admin-detail-item">
                    <dt>RAAN (°)</dt>
                    <dd>@Model.RAAN.ToString("F6")</dd>
                </div>
                <div class="admin-detail-item">
                    <dt>Eccentricity</dt>
                    <dd>@Model.Eccentricity.ToString("F7")</dd>
                </div>
                <div class="admin-detail-item">
                    <dt>Argument of Perigee (°)</dt>
                    <dd>@Model.ArgumentOfPerigee.ToString("F6")</dd>
                </div>
                <div class="admin-detail-item">
                    <dt>Mean Anomaly (°)</dt>
                    <dd>@Model.MeanAnomaly.ToString("F6")</dd>
                </div>
                <div class="admin-detail-item">
                    <dt>Mean Motion (rev/day)</dt>
                    <dd>@Model.MeanMotion.ToString("F8")</dd>
                </div>
                <div class="admin-detail-item">
                    <dt>Revolution Number</dt>
                    <dd>@Model.RevolutionNumber</dd>
                </div>
                <div class="admin-detail-item">
                    <dt>B* Drag Term</dt>
                    <dd>@Model.BSTar.ToString("F8")</dd>
                </div>
                <div class="admin-detail-item">
                    <dt>First Derivative</dt>
                    <dd>@Model.FirstDerivative.ToString("F8")</dd>
                </div>
                <div class="admin-detail-item">
                    <dt>Second Derivative</dt>
                    <dd>@Model.SecondDerivative.ToString("E3")</dd>
                </div>
            </dl>
        </div>

        @if (!string.IsNullOrEmpty(Model.RawLine1))
        {
            <div class="card mt-4">
                <div class="admin-section-heading mb-3"><i class="bi bi-code-square"></i> Raw TLE Data</div>
                <pre class="mb-1" style="font-family:monospace;font-size:0.85rem;background:#f8f9fa;padding:0.75rem;border-radius:6px;overflow-x:auto;">@Model.RawLine1
@Model.RawLine2</pre>
            </div>
        }
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="admin-section-heading mb-3"><i class="bi bi-clock-history"></i> Metadata</div>
            <dl class="admin-detail-grid" style="grid-template-columns:1fr;">
                <div class="admin-detail-item"><dt>Created By</dt><dd>@(Model.CreatedBy ?? "—")</dd></div>
                <div class="admin-detail-item"><dt>Created At</dt><dd>@(Model.CreatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd></div>
            </dl>
        </div>
    </div>
</div>

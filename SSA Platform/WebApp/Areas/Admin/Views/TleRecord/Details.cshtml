@model App.Domain.Entities.TleRecord

@{
    ViewData["Title"] = "TLE Record Details";
}

<link rel="stylesheet" href="~/css/dashboard-ssa.css" asp-append-version="true" />

<div class="ssa-container">

    <div class="system-bar">
        <span class="status-dot"></span>
        ADMIN | TLE RECORDS | DETAILS
    </div>

    <div class="header">
        <div>
            <h3>TLE Record</h3>
            <small>Epoch @Model.Epoch.ToString("yyyy-MM-dd HH:mm") UTC</small>
        </div>
        <div style="display:flex;gap:0.5rem;">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-sat btn-sat-edit"><i class="bi bi-pencil"></i> Edit</a>
            <a asp-action="Index" class="btn-ssa-ghost"><i class="bi bi-arrow-left"></i> Back</a>
        </div>
    </div>

    <div class="card">
        <dl class="admin-detail-grid">
            <div class="admin-detail-item">
                <dt>Space Object</dt>
                <dd>@(Model.SpaceObject?.NoradId.ToString() ?? "—")</dd>
            </div>
            <div class="admin-detail-item">
                <dt>@Html.DisplayNameFor(m => m.Epoch)</dt>
                <dd>@Model.Epoch.ToString("yyyy-MM-dd HH:mm:ss")</dd>
            </div>
            <div class="admin-detail-item">
                <dt>@Html.DisplayNameFor(m => m.Inclination)</dt>
                <dd>@Model.Inclination.ToString("F6")°</dd>
            </div>
            <div class="admin-detail-item">
                <dt>@Html.DisplayNameFor(m => m.RAAN)</dt>
                <dd>@Model.RAAN.ToString("F6")°</dd>
            </div>
            <div class="admin-detail-item">
                <dt>@Html.DisplayNameFor(m => m.Eccentricity)</dt>
                <dd>@Model.Eccentricity.ToString("F7")</dd>
            </div>
            <div class="admin-detail-item">
                <dt>@Html.DisplayNameFor(m => m.ArgumentOfPerigee)</dt>
                <dd>@Model.ArgumentOfPerigee.ToString("F6")°</dd>
            </div>
            <div class="admin-detail-item">
                <dt>@Html.DisplayNameFor(m => m.MeanAnomaly)</dt>
                <dd>@Model.MeanAnomaly.ToString("F6")°</dd>
            </div>
            <div class="admin-detail-item">
                <dt>@Html.DisplayNameFor(m => m.MeanMotion)</dt>
                <dd>@Model.MeanMotion.ToString("F8")</dd>
            </div>
            <div class="admin-detail-item">
                <dt>@Html.DisplayNameFor(m => m.RevolutionNumber)</dt>
                <dd>@Model.RevolutionNumber</dd>
            </div>
            <div class="admin-detail-item">
                <dt>@Html.DisplayNameFor(m => m.BSTar)</dt>
                <dd>@Model.BSTar.ToString("F8")</dd>
            </div>
            <div class="admin-detail-item">
                <dt>@Html.DisplayNameFor(m => m.FirstDerivative)</dt>
                <dd>@Model.FirstDerivative.ToString("F8")</dd>
            </div>
            <div class="admin-detail-item">
                <dt>@Html.DisplayNameFor(m => m.SecondDerivative)</dt>
                <dd>@Model.SecondDerivative.ToString("E3")</dd>
            </div>
        </dl>
        @if (!string.IsNullOrEmpty(Model.RawLine1))
        {
            <hr class="sat-divider mt-4 mb-3" />
            <div class="sat-orbit-bar" style="flex-direction:column;align-items:flex-start;gap:0.3rem;">
                <div class="sat-orbit-text">@Model.RawLine1</div>
                <div class="sat-orbit-text">@Model.RawLine2</div>
            </div>
        }
    </div>

</div>

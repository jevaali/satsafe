@model App.Domain.Entities.ConjunctionEvent

@{
    ViewData["Title"] = "Edit Conjunction Event";
}

<link rel="stylesheet" href="~/css/dashboard-ssa.css" asp-append-version="true" />

<div class="ssa-container">

    <div class="system-bar">
        <span class="status-dot"></span>
        ADMIN | CONJUNCTION EVENTS | EDIT
    </div>

    <div class="header">
        <div>
            <h3>Edit Conjunction Event</h3>
            <small>Update event details</small>
        </div>
        <div>
            <a asp-action="Index" class="btn-ssa-ghost"><i class="bi bi-arrow-left"></i> Back</a>
        </div>
    </div>

    <div class="card admin-form">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="admin-form-grid">
                <div class="form-group">
                    <label asp-for="PrimaryObjectId" class="control-label"></label>
                    <select asp-for="PrimaryObjectId" class="form-control" asp-items="ViewBag.PrimaryObjectId"></select>
                    <span asp-validation-for="PrimaryObjectId" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="SecondaryObjectId" class="control-label"></label>
                    <select asp-for="SecondaryObjectId" class="form-control" asp-items="ViewBag.SecondaryObjectId"></select>
                    <span asp-validation-for="SecondaryObjectId" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="TimeOfClosestApproach" class="control-label"></label>
                    <input asp-for="TimeOfClosestApproach" class="form-control" />
                    <span asp-validation-for="TimeOfClosestApproach" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="MissDistance" class="control-label"></label>
                    <input asp-for="MissDistance" class="form-control" />
                    <span asp-validation-for="MissDistance" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="CollisionProbability" class="control-label"></label>
                    <input asp-for="CollisionProbability" class="form-control" />
                    <span asp-validation-for="CollisionProbability" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Status" class="control-label"></label>
                    <input asp-for="Status" class="form-control" />
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="RiskAssessmentId" class="control-label"></label>
                    <input asp-for="RiskAssessmentId" class="form-control" />
                    <span asp-validation-for="RiskAssessmentId" class="text-danger"></span>
                </div>
            </div>

            <input type="hidden" asp-for="Id" />

            <div class="admin-form-actions">
                <button type="submit" class="btn-ssa-primary"><i class="bi bi-check-lg"></i> Save Changes</button>
                <a asp-action="Index" class="btn-ssa-ghost">Cancel</a>
            </div>
        </form>
    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@model ConjunctionEventDetailViewModel

@{
    ViewData["Title"] = "Conjunction Event Details";
}

<div class="admin-page-header">
    <div>
        <div class="admin-page-title">Conjunction Event</div>
        <div class="admin-page-subtitle">TCA @Model.Tca.ToString("yyyy-MM-dd HH:mm") UTC</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-sat btn-sat-edit"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-action="Index" class="btn-ssa-ghost"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="admin-section-heading mb-3"><i class="bi bi-arrow-left-right"></i> Event Details</div>
            <dl class="admin-detail-grid">
                <div class="admin-detail-item">
                    <dt>Primary Object</dt>
                    <dd><strong>@Model.PrimaryObjectName</strong></dd>
                </div>
                <div class="admin-detail-item">
                    <dt>Secondary Object</dt>
                    <dd><strong>@Model.SecondaryObjectName</strong></dd>
                </div>
                <div class="admin-detail-item">
                    <dt>Time of Closest Approach</dt>
                    <dd>@Model.Tca.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd>
                </div>
                <div class="admin-detail-item">
                    <dt>Miss Distance</dt>
                    <dd>
                        <span class="@(Model.MissDistance < 1000 ? "text-danger fw-bold" : Model.MissDistance < 5000 ? "text-warning" : "")">
                            @(Model.MissDistance < 1000 ? $"{Model.MissDistance:N0} m" : $"{Model.MissDistance / 1000:F2} km")
                        </span>
                    </dd>
                </div>
                <div class="admin-detail-item">
                    <dt>Collision Probability</dt>
                    <dd>@((Model.CollisionProbability * 100).ToString("F4"))%</dd>
                </div>
                <div class="admin-detail-item">
                    <dt>Status</dt>
                    <dd>
                        @{
                            var statusCss = Model.Status switch {
                                EConjunctionEventStatus.Pending  => "bg-warning text-dark",
                                EConjunctionEventStatus.Resolved => "bg-success",
                                EConjunctionEventStatus.Imminent => "bg-danger",
                                _                                => "bg-secondary"
                            };
                        }
                        <span class="badge @statusCss">@Model.Status</span>
                    </dd>
                </div>
                <div class="admin-detail-item">
                    <dt>Risk</dt>
                    <dd>
                        @if (Model.IsHighRisk)
                        { <span class="badge danger">HIGH</span> }
                        else
                        { <span class="badge bg-secondary">NORMAL</span> }
                    </dd>
                </div>
            </dl>
        </div>

        @if (Model.RiskScore.HasValue)
        {
            <div class="card mt-4">
                <div class="admin-section-heading mb-3"><i class="bi bi-graph-up"></i> Risk Assessment</div>
                <dl class="admin-detail-grid">
                    <div class="admin-detail-item">
                        <dt>Risk Score</dt>
                        <dd>
                            @{
                                var riskLevel = Model.RiskScore > 0.7 ? "High" : Model.RiskScore > 0.3 ? "Medium" : "Low";
                                var riskCss   = Model.RiskScore > 0.7 ? "text-danger fw-bold" : Model.RiskScore > 0.3 ? "text-warning" : "text-success";
                            }
                            <span class="@riskCss">@Model.RiskScore.Value.ToString("F4")</span>
                            <small class="text-muted ms-1">(@riskLevel)</small>
                        </dd>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.RiskModelVersion))
                    {
                        <div class="admin-detail-item">
                            <dt>Model Version</dt>
                            <dd><code>@Model.RiskModelVersion</code></dd>
                        </div>
                    }
                </dl>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="admin-section-heading mb-3"><i class="bi bi-clock-history"></i> Metadata</div>
            <dl class="admin-detail-grid" style="grid-template-columns:1fr;">
                <div class="admin-detail-item"><dt>Created By</dt><dd>@(Model.CreatedBy ?? "—")</dd></div>
                <div class="admin-detail-item"><dt>Created At</dt><dd>@(Model.CreatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd></div>
            </dl>
        </div>
    </div>
</div>

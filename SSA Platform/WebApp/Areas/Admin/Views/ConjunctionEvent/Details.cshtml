@model App.Domain.Entities.ConjunctionEvent

@{
    ViewData["Title"] = "Conjunction Event Details";
}

<link rel="stylesheet" href="~/css/dashboard-ssa.css" asp-append-version="true" />

<div class="ssa-container">

    <div class="system-bar">
        <span class="status-dot"></span>
        ADMIN | CONJUNCTION EVENTS | DETAILS
    </div>

    <div class="header">
        <div>
            <h3>Conjunction Event</h3>
            <small>TCA @Model.TimeOfClosestApproach.ToString("yyyy-MM-dd HH:mm") UTC</small>
        </div>
        <div style="display:flex;gap:0.5rem;">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-sat btn-sat-edit"><i class="bi bi-pencil"></i> Edit</a>
            <a asp-action="Index" class="btn-ssa-ghost"><i class="bi bi-arrow-left"></i> Back</a>
        </div>
    </div>

    <div class="card">
        <dl class="admin-detail-grid">
            <div class="admin-detail-item">
                <dt>Primary Object</dt>
                <dd>@(Model.PrimaryObject?.NoradId.ToString() ?? Model.PrimaryObjectId.ToString()[..8])</dd>
            </div>
            <div class="admin-detail-item">
                <dt>Secondary Object</dt>
                <dd>@(Model.SecondaryObject?.NoradId.ToString() ?? Model.SecondaryObjectId.ToString()[..8])</dd>
            </div>
            <div class="admin-detail-item">
                <dt>@Html.DisplayNameFor(m => m.TimeOfClosestApproach)</dt>
                <dd>@Model.TimeOfClosestApproach.ToString("yyyy-MM-dd HH:mm:ss")</dd>
            </div>
            <div class="admin-detail-item">
                <dt>@Html.DisplayNameFor(m => m.MissDistance)</dt>
                <dd>@(Model.MissDistance < 1000 ? $"{Model.MissDistance:N0} m" : $"{Model.MissDistance / 1000:F2} km")</dd>
            </div>
            <div class="admin-detail-item">
                <dt>@Html.DisplayNameFor(m => m.CollisionProbability)</dt>
                <dd>@((Model.CollisionProbability * 100).ToString("F4"))%</dd>
            </div>
            <div class="admin-detail-item">
                <dt>@Html.DisplayNameFor(m => m.Status)</dt>
                <dd>@Model.Status</dd>
            </div>
            <div class="admin-detail-item">
                <dt>Risk Assessment ID</dt>
                <dd>@(Model.RiskAssessmentId?.ToString()[..8] ?? "—")</dd>
            </div>
        </dl>
    </div>

</div>

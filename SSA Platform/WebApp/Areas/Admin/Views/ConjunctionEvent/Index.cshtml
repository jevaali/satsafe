@model ConjunctionEventIndexViewModel

@{
    ViewData["Title"] = "Conjunction Events";
}

<div class="admin-page-header">
    <div>
        <div class="admin-page-title">Conjunction Events</div>
        <div class="admin-page-subtitle">All detected conjunction events across the catalogue</div>
    </div>
    <a asp-action="Create" class="btn-add"><i class="bi bi-plus-lg"></i> Add Event</a>
</div>

<div class="admin-stat-row mb-4" style="grid-template-columns:repeat(3,minmax(140px,200px));">
    <div class="admin-stat-card">
        <div class="admin-stat-icon orange"><i class="bi bi-exclamation-triangle"></i></div>
        <div><div class="admin-stat-value">@Model.TotalCount</div><div class="admin-stat-label">Total Events</div></div>
    </div>
    <div class="admin-stat-card">
        <div class="admin-stat-icon red"><i class="bi bi-shield-exclamation"></i></div>
        <div><div class="admin-stat-value">@Model.HighRiskCount</div><div class="admin-stat-label">High Risk</div></div>
    </div>
    <div class="admin-stat-card">
        <div class="admin-stat-icon orange"><i class="bi bi-clock"></i></div>
        <div><div class="admin-stat-value">@Model.PendingCount</div><div class="admin-stat-label">Pending</div></div>
    </div>
</div>

<div class="card mb-3 p-3">
    <div class="d-flex gap-3 align-items-center flex-wrap">
        <input type="text" id="searchInput" class="form-control w-auto"
               placeholder="Search by object name…" />
        <select id="statusFilter" class="form-select w-auto">
            <option value="">All Statuses</option>
            @foreach (var status in Enum.GetValues<EConjunctionEventStatus>())
            {
                <option value="@status">@status</option>
            }
        </select>
        <select id="riskFilter" class="form-select w-auto">
            <option value="">All Risk Levels</option>
            <option value="high">High Risk</option>
            <option value="normal">Normal</option>
        </select>
    </div>
</div>

<div class="card">
    <table class="table table-hover mb-0" id="conjunctionTable">
        <thead>
            <tr>
                <th>Primary Object</th>
                <th>Secondary Object</th>
                <th>TCA (UTC)</th>
                <th>Miss Distance</th>
                <th>Collision Prob.</th>
                <th>Status</th>
                <th>Risk</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Events)
            {
                <tr class="conjunction-row @(c.IsHighRisk ? "table-danger" : "")"
                    data-primary="@c.PrimaryObjectName.ToLower()"
                    data-secondary="@c.SecondaryObjectName.ToLower()"
                    data-status="@c.Status"
                    data-risk="@(c.IsHighRisk ? "high" : "normal")">
                    <td><strong>@c.PrimaryObjectName</strong></td>
                    <td><strong>@c.SecondaryObjectName</strong></td>
                    <td>@c.Tca.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <span class="@(c.MissDistance < 1000 ? "text-danger fw-bold" : c.MissDistance < 5000 ? "text-warning" : "")">
                            @(c.MissDistance < 1000 ? $"{c.MissDistance:N0} m" : $"{c.MissDistance / 1000:F2} km")
                        </span>
                    </td>
                    <td>@((c.CollisionProbability * 100).ToString("F4"))%</td>
                    <td>
                        @{
                            var statusCss = c.Status switch {
                                EConjunctionEventStatus.Pending  => "bg-warning text-dark",
                                EConjunctionEventStatus.Resolved => "bg-success",
                                EConjunctionEventStatus.Imminent => "bg-danger",
                                _                                => "bg-secondary"
                            };
                        }
                        <span class="badge @statusCss">@c.Status</span>
                    </td>
                    <td>
                        @if (c.IsHighRisk)
                        { <span class="badge danger">HIGH</span> }
                        else
                        { <span class="badge bg-secondary">NORMAL</span> }
                    </td>
                    <td class="tbl-actions">
                        <a asp-action="Details" asp-route-id="@c.Id" class="btn-sat btn-sat-view"><i class="bi bi-eye"></i></a>
                        <a asp-action="Edit"    asp-route-id="@c.Id" class="btn-sat btn-sat-edit"><i class="bi bi-pencil"></i></a>
                        <a asp-action="Delete"  asp-route-id="@c.Id" class="btn-sat btn-sat-delete"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Events.Any())
    {
        <div class="empty-state"><p>No conjunction events found.</p></div>
    }
</div>

@section Scripts {
    <script>
        const searchInput  = document.getElementById('searchInput');
        const statusFilter = document.getElementById('statusFilter');
        const riskFilter   = document.getElementById('riskFilter');
        const rows         = document.querySelectorAll('.conjunction-row');
        function applyFilters() {
            const search = searchInput.value.toLowerCase();
            const status = statusFilter.value.toLowerCase();
            const risk   = riskFilter.value.toLowerCase();
            rows.forEach(row => {
                const matchSearch = !search || row.dataset.primary.includes(search) || row.dataset.secondary.includes(search);
                const matchStatus = !status || row.dataset.status.toLowerCase() === status;
                const matchRisk   = !risk   || row.dataset.risk === risk;
                row.style.display = matchSearch && matchStatus && matchRisk ? '' : 'none';
            });
        }
        searchInput.addEventListener('input', applyFilters);
        statusFilter.addEventListener('change', applyFilters);
        riskFilter.addEventListener('change', applyFilters);
    </script>
}

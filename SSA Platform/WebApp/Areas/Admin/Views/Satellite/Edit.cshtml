@model SatelliteFormViewModel

@{
    ViewData["Title"] = "Edit Satellite";
}

<div class="admin-page-header">
    <div>
        <div class="admin-page-title">Edit Satellite</div>
        <div class="admin-page-subtitle">Update satellite record — @Model.Name</div>
    </div>
    <a asp-action="Index" class="btn-ssa-ghost"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="card admin-form">
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>
        <input type="hidden" asp-for="Id" />

        <div class="admin-form-grid">
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="form-group">
                <label asp-for="NoradId" class="control-label"></label>
                <input asp-for="NoradId" class="form-control" />
                <span asp-validation-for="NoradId" class="text-danger small"></span>
            </div>
            <div class="form-group">
                <label asp-for="LaunchDate" class="control-label"></label>
                <input asp-for="LaunchDate" type="date" class="form-control" />
                <span asp-validation-for="LaunchDate" class="text-danger small"></span>
            </div>
            <div class="form-group">
                <label asp-for="Status" class="control-label"></label>
                <select asp-for="Status" class="form-select"
                        asp-items="Html.GetEnumSelectList<ESatelliteStatus>()"></select>
                <span asp-validation-for="Status" class="text-danger small"></span>
            </div>
        </div>

        <div class="form-group mt-3">
            <label asp-for="OperatorId" class="control-label"></label>
            <select asp-for="OperatorId" class="form-select" asp-items="Model.OperatorOptions"></select>
            <span asp-validation-for="OperatorId" class="text-danger small"></span>
        </div>

        <div class="admin-form-actions">
            <button type="submit" class="btn-ssa-primary"><i class="bi bi-check-lg"></i> Save Changes</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn-ssa-ghost">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

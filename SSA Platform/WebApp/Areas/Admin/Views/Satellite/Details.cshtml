@model SatelliteDetailViewModel

@{
    ViewData["Title"] = "Satellite Details";
}

<div class="admin-page-header">
    <div>
        <div class="admin-page-title">@Model.Name</div>
        <div class="admin-page-subtitle">NORAD #@Model.NoradId &nbsp;·&nbsp; <span class="badge-status @Model.Status.ToString().ToLower()">@Model.Status</span></div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-sat btn-sat-edit"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-action="Index" class="btn-ssa-ghost"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card">
            <div class="admin-section-heading mb-3"><i class="bi bi-info-circle"></i> Satellite Information</div>
            <dl class="admin-detail-grid">
                <div class="admin-detail-item">
                    <dt>Name</dt><dd>@Model.Name</dd>
                </div>
                <div class="admin-detail-item">
                    <dt>NORAD ID</dt><dd>@Model.NoradId</dd>
                </div>
                <div class="admin-detail-item">
                    <dt>Launch Date</dt><dd>@Model.LaunchDate.ToString("yyyy-MM-dd")</dd>
                </div>
                <div class="admin-detail-item">
                    <dt>Status</dt>
                    <dd><span class="badge-status @Model.Status.ToString().ToLower()">@Model.Status</span></dd>
                </div>
                <div class="admin-detail-item">
                    <dt>Operator</dt><dd>@Model.OperatorName</dd>
                </div>
            </dl>
        </div>
    </div>

    <div class="col-lg-5">
        @if (Model.SemiMajorAxis.HasValue)
        {
            <div class="card">
                <div class="admin-section-heading mb-3"><i class="bi bi-arrow-repeat"></i> Orbital Parameters</div>
                <dl class="admin-detail-grid" style="grid-template-columns:1fr 1fr;">
                    <div class="admin-detail-item">
                        <dt>Semi-Major Axis</dt><dd>@Model.SemiMajorAxis.Value.ToString("N0") m</dd>
                    </div>
                    <div class="admin-detail-item">
                        <dt>Eccentricity</dt><dd>@Model.Eccentricity?.ToString("F6")</dd>
                    </div>
                    <div class="admin-detail-item">
                        <dt>Inclination</dt><dd>@Model.Inclination?.ToString("F4")°</dd>
                    </div>
                    <div class="admin-detail-item">
                        <dt>RAAN</dt><dd>@Model.RAAN?.ToString("F4")°</dd>
                    </div>
                    <div class="admin-detail-item">
                        <dt>Arg. of Perigee</dt><dd>@Model.ArgumentOfPerigee?.ToString("F4")°</dd>
                    </div>
                    <div class="admin-detail-item">
                        <dt>Mean Anomaly</dt><dd>@Model.MeanAnomaly?.ToString("F4")°</dd>
                    </div>
                </dl>
            </div>
        }
        else
        {
            <div class="card">
                <div class="empty-state" style="padding:2rem;">
                    <i class="bi bi-circle-fill text-muted" style="font-size:1.5rem;"></i>
                    <p class="mt-2">No orbit data available</p>
                </div>
            </div>
        }

        <div class="card mt-3">
            <div class="admin-section-heading mb-3"><i class="bi bi-clock-history"></i> Metadata</div>
            <dl class="admin-detail-grid" style="grid-template-columns:1fr 1fr;">
                <div class="admin-detail-item">
                    <dt>Created By</dt><dd>@(Model.CreatedBy ?? "—")</dd>
                </div>
                <div class="admin-detail-item">
                    <dt>Created At</dt><dd>@(Model.CreatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>
                </div>
                <div class="admin-detail-item">
                    <dt>Updated By</dt><dd>@(Model.UpdatedBy ?? "—")</dd>
                </div>
                <div class="admin-detail-item">
                    <dt>Updated At</dt><dd>@(Model.UpdatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>
                </div>
            </dl>
        </div>
    </div>
</div>

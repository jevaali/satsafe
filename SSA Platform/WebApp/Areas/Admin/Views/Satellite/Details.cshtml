@model SatelliteDetailViewModel
@using WebApp.Areas.Admin.ViewModels

@{
    ViewData["Title"] = "Satellite Details";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="admin-page-header">
    <div>
        <div class="admin-page-title">@Model.Name</div>
        <div class="admin-page-subtitle">NORAD #@Model.NoradId &nbsp;·&nbsp; <span class="badge-status @Model.Status.ToString().ToLower()">@Model.Status</span></div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-sat btn-sat-edit"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-action="Index" class="btn-ssa-ghost"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card">
            <div class="admin-section-heading mb-3"><i class="bi bi-info-circle"></i> Satellite Information</div>
            <dl class="admin-detail-grid">
                <div class="admin-detail-item">
                    <dt>Name</dt><dd>@Model.Name</dd>
                </div>
                <div class="admin-detail-item">
                    <dt>NORAD ID</dt><dd>@Model.NoradId</dd>
                </div>
                <div class="admin-detail-item">
                    <dt>Launch Date</dt><dd>@Model.LaunchDate.ToString("yyyy-MM-dd")</dd>
                </div>
                <div class="admin-detail-item">
                    <dt>Status</dt>
                    <dd><span class="badge-status @Model.Status.ToString().ToLower()">@Model.Status</span></dd>
                </div>
                <div class="admin-detail-item">
                    <dt>Operator</dt><dd>@Model.OperatorName</dd>
                </div>
            </dl>
        </div>
    </div>

    <div class="col-lg-5">
        @if (Model.SemiMajorAxis.HasValue)
        {
            <div class="card">
                <div class="admin-section-heading mb-3"><i class="bi bi-arrow-repeat"></i> Orbital Parameters</div>
                <dl class="admin-detail-grid" style="grid-template-columns:1fr 1fr;">
                    <div class="admin-detail-item">
                        <dt>Semi-Major Axis</dt><dd>@Model.SemiMajorAxis.Value.ToString("N0") m</dd>
                    </div>
                    <div class="admin-detail-item">
                        <dt>Eccentricity</dt><dd>@Model.Eccentricity?.ToString("F6")</dd>
                    </div>
                    <div class="admin-detail-item">
                        <dt>Inclination</dt><dd>@Model.Inclination?.ToString("F4")°</dd>
                    </div>
                    <div class="admin-detail-item">
                        <dt>RAAN</dt><dd>@Model.RAAN?.ToString("F4")°</dd>
                    </div>
                    <div class="admin-detail-item">
                        <dt>Arg. of Perigee</dt><dd>@Model.ArgumentOfPerigee?.ToString("F4")°</dd>
                    </div>
                    <div class="admin-detail-item">
                        <dt>Mean Anomaly</dt><dd>@Model.MeanAnomaly?.ToString("F4")°</dd>
                    </div>
                </dl>
            </div>
        }
        else
        {
            <div class="card">
                <div class="empty-state" style="padding:2rem;">
                    <i class="bi bi-circle-fill text-muted" style="font-size:1.5rem;"></i>
                    <p class="mt-2">No orbit data available</p>
                </div>
            </div>
        }

        @{
            var fetchEnabled = (bool)(ViewData["CelesTrakFetchEnabled"] ?? true);
        }
        <div class="card mt-3">
            <div style="display:flex; justify-content:space-between; align-items:center;" class="mb-3">
                <div class="admin-section-heading mb-0"><i class="bi bi-broadcast-pin"></i> TLE Records</div>
                @if (fetchEnabled)
                {
                    <form asp-action="FetchTle" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-sat btn-sat-edit" style="font-size:0.8rem;">
                            <i class="bi bi-cloud-download"></i> Fetch from CelesTrak
                        </button>
                    </form>
                }
            </div>
            @if (Model.TleRecords.Any())
            {
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Epoch (UTC)</th>
                            <th>Fetched At (UTC)</th>
                            <th>Inclination (°)</th>
                            <th>Mean Motion</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tle in Model.TleRecords)
                        {
                            <tr>
                                <td><small class="font-monospace">@tle.Epoch.ToString("yyyy-MM-dd HH:mm")</small></td>
                                <td><small class="text-muted">@tle.FetchedAt.ToString("yyyy-MM-dd HH:mm")</small></td>
                                <td class="font-monospace">@tle.Inclination.ToString("F4")</td>
                                <td class="font-monospace">@tle.MeanMotion.ToString("F8")</td>
                                <td>
                                    <a asp-area="Admin" asp-controller="TleRecord" asp-action="Details" asp-route-id="@tle.Id"
                                       class="btn-sat btn-sat-view" style="font-size:0.75rem;"><i class="bi bi-eye"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted mb-0" style="font-size:0.85rem;">No TLE records yet. Click <strong>Fetch from CelesTrak</strong> to import the latest data.</p>
            }
        </div>

        <div class="card mt-3">
            <div class="admin-section-heading mb-3"><i class="bi bi-clock-history"></i> Metadata</div>
            <dl class="admin-detail-grid" style="grid-template-columns:1fr 1fr;">
                <div class="admin-detail-item">
                    <dt>Created By</dt><dd>@(Model.CreatedBy ?? "—")</dd>
                </div>
                <div class="admin-detail-item">
                    <dt>Created At</dt><dd>@(Model.CreatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>
                </div>
                <div class="admin-detail-item">
                    <dt>Updated By</dt><dd>@(Model.UpdatedBy ?? "—")</dd>
                </div>
                <div class="admin-detail-item">
                    <dt>Updated At</dt><dd>@(Model.UpdatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>
                </div>
            </dl>
        </div>
    </div>
</div>

@model SatelliteIndexViewModel

@{
    ViewData["Title"] = "Satellites";
}

<div class="admin-page-header">
    <div>
        <div class="admin-page-title">Satellite Registry</div>
        <div class="admin-page-subtitle">All registered satellites across all operators</div>
    </div>
    <a asp-action="Create" class="btn-add"><i class="bi bi-plus-lg"></i> Add Satellite</a>
</div>

<div class="admin-stat-row mb-4" style="grid-template-columns:repeat(3,minmax(140px,200px));">
    <div class="admin-stat-card">
        <div class="admin-stat-icon blue"><i class="bi bi-reception-4"></i></div>
        <div><div class="admin-stat-value">@Model.TotalCount</div><div class="admin-stat-label">Total</div></div>
    </div>
    <div class="admin-stat-card">
        <div class="admin-stat-icon green"><i class="bi bi-check-circle"></i></div>
        <div><div class="admin-stat-value">@Model.ActiveCount</div><div class="admin-stat-label">Active</div></div>
    </div>
    <div class="admin-stat-card">
        <div class="admin-stat-icon red"><i class="bi bi-x-circle"></i></div>
        <div><div class="admin-stat-value">@Model.DeletedCount</div><div class="admin-stat-label">Deleted</div></div>
    </div>
</div>

<div class="sat-card-grid">
    @if (Model.Satellites.Any())
    {
        @foreach (var sat in Model.Satellites)
        {
            var statusStr = sat.Status.ToString().ToLower();

            <div class="sat-card status-@statusStr">
                <div class="sat-card-header">
                    <div class="d-flex align-items-center gap-3">
                        <div class="sat-icon"><i class="bi bi-reception-4"></i></div>
                        <div>
                            <div class="sat-name">@sat.Name</div>
                            <div class="sat-norad">NORAD #@sat.NoradId</div>
                        </div>
                    </div>
                    <span class="badge-status @statusStr">@sat.Status</span>
                </div>

                <hr class="sat-divider" />

                <div class="sat-meta-grid">
                    <div>
                        <div class="sat-meta-label">Launch Date</div>
                        <div class="sat-meta-value">@sat.LaunchDate.ToString("yyyy-MM-dd")</div>
                    </div>
                    <div>
                        <div class="sat-meta-label">Operator</div>
                        <div class="sat-meta-value">@sat.OperatorName</div>
                    </div>
                    @if (sat.SemiMajorAxis.HasValue)
                    {
                        <div>
                            <div class="sat-meta-label">Semi-Major Axis</div>
                            <div class="sat-meta-value highlight">@sat.SemiMajorAxis.Value.ToString("N0") m</div>
                        </div>
                        <div>
                            <div class="sat-meta-label">Inclination</div>
                            <div class="sat-meta-value">@sat.Inclination?.ToString("F2")°</div>
                        </div>
                    }
                    else
                    {
                        <div>
                            <div class="sat-meta-label">Orbit Data</div>
                            <div class="sat-meta-value muted">Not available</div>
                        </div>
                    }
                </div>

                @if (sat.SemiMajorAxis.HasValue)
                {
                    <div class="sat-orbit-bar">
                        <i class="bi bi-arrow-repeat sat-orbit-icon"></i>
                        <span class="sat-orbit-text">
                            RAAN @sat.RAAN?.ToString("F2")° &nbsp;·&nbsp;
                            AoP @sat.ArgumentOfPerigee?.ToString("F2")° &nbsp;·&nbsp;
                            M₀ @sat.MeanAnomaly?.ToString("F2")°
                        </span>
                    </div>
                }

                <div class="sat-actions">
                    <a asp-action="Details" asp-route-id="@sat.Id" class="btn-sat btn-sat-view">
                        <i class="bi bi-eye"></i> View
                    </a>
                    <a asp-action="Edit" asp-route-id="@sat.Id" class="btn-sat btn-sat-edit">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                    <a asp-action="Delete" asp-route-id="@sat.Id" class="btn-sat btn-sat-delete">
                        <i class="bi bi-trash"></i> Delete
                    </a>
                </div>
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <p>No satellites registered yet.</p>
            <a asp-action="Create" class="btn-add"><i class="bi bi-plus-lg"></i> Add Satellite</a>
        </div>
    }
</div>

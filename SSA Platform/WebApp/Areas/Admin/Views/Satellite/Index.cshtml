@model IEnumerable<App.Domain.Entities.Satellite>
@using App.Domain.Entities
@using App.Domain.Entities.Enums

@{
    ViewData["Title"] = "Satellites";
}

<link rel="stylesheet" href="~/css/dashboard-ssa.css" asp-append-version="true" />

<div class="ssa-container">

    <div class="system-bar">
        <span class="status-dot"></span>
        ADMIN | SATELLITE REGISTRY |
        @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss") UTC |
        @Model.Count() SATELLITES
    </div>

    <div class="header">
        <div>
            <h3>Satellite Registry</h3>
            <small>All registered satellites across all operators</small>
        </div>
        <div class="header-right">
            <span class="badge warning">@Model.Count(s => s.Status == ESatelliteStatus.Active) Active</span>
            <span class="badge danger">@Model.Count(s => s.Status == ESatelliteStatus.Deleted) Deleted</span>
            <a asp-action="Create" class="btn-add"><i class="bi bi-plus-lg"></i> Add Satellite</a>
        </div>
    </div>

    <div class="sat-card-grid">
        @if (Model.Any())
        {
            @foreach (var sat in Model.OrderBy(s => s.Name.ToString()))
            {
                var statusStr   = sat.Status.ToString().ToLower();
                var orbitParams = sat.Orbit?.Parameters;

                <div class="sat-card status-@statusStr">
                    <div class="sat-card-header">
                        <div class="d-flex align-items-center gap-3">
                            <div class="sat-icon"><i class="bi bi-reception-4"></i></div>
                            <div>
                                <div class="sat-name">@sat.Name</div>
                                <div class="sat-norad">NORAD #@sat.NoradId</div>
                            </div>
                        </div>
                        <span class="badge-status @statusStr">@sat.Status</span>
                    </div>

                    <hr class="sat-divider" />

                    <div class="sat-meta-grid">
                        <div>
                            <div class="sat-meta-label">Launch Date</div>
                            <div class="sat-meta-value">@sat.LaunchDate.ToString("yyyy-MM-dd")</div>
                        </div>
                        <div>
                            <div class="sat-meta-label">Operator</div>
                            <div class="sat-meta-value">@(sat.Operator?.Name.ToString() ?? sat.OperatorName ?? "—")</div>
                        </div>
                        @if (orbitParams != null)
                        {
                            <div>
                                <div class="sat-meta-label">Semi-Major Axis</div>
                                <div class="sat-meta-value highlight">@orbitParams.SemiMajorAxis.ToString("N0") m</div>
                            </div>
                            <div>
                                <div class="sat-meta-label">Inclination</div>
                                <div class="sat-meta-value">@orbitParams.Inclination.ToString("F2")°</div>
                            </div>
                        }
                        else
                        {
                            <div>
                                <div class="sat-meta-label">Orbit Data</div>
                                <div class="sat-meta-value muted">Not available</div>
                            </div>
                        }
                    </div>

                    @if (orbitParams != null)
                    {
                        <div class="sat-orbit-bar">
                            <i class="bi bi-arrow-repeat sat-orbit-icon"></i>
                            <span class="sat-orbit-text">
                                RAAN @orbitParams.RAAN.ToString("F2")° &nbsp;·&nbsp;
                                AoP @orbitParams.ArgumentOfPerigee.ToString("F2")° &nbsp;·&nbsp;
                                M₀ @orbitParams.MeanAnomaly.ToString("F2")°
                            </span>
                        </div>
                    }

                    <div class="sat-actions">
                        <a asp-action="Details" asp-route-id="@sat.Id" class="btn-sat btn-sat-view">
                            <i class="bi bi-eye"></i> View
                        </a>
                        <a asp-action="Edit" asp-route-id="@sat.Id" class="btn-sat btn-sat-edit">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@sat.Id" class="btn-sat btn-sat-delete">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <p>No satellites registered yet.</p>
                <a asp-action="Create" class="btn-add"><i class="bi bi-plus-lg"></i> Add Satellite</a>
            </div>
        }
    </div>

</div>
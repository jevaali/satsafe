@model RiskAssessmentDeleteViewModel

@{
    ViewData["Title"] = "Delete Risk Assessment";
}

<div class="admin-page-header">
    <div>
        <div class="admin-page-title">Delete Risk Assessment</div>
        <div class="admin-page-subtitle">Confirm permanent removal</div>
    </div>
    <a asp-action="Index" class="btn-ssa-ghost"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="card admin-form">
    <div class="delete-warning">
        <i class="bi bi-exclamation-triangle-fill delete-warning-icon"></i>
        <div>
            <div class="delete-warning-title">This action cannot be undone</div>
            <div class="delete-warning-text">Deleting this risk assessment will remove the record permanently.</div>
        </div>
    </div>

    <dl class="admin-detail-grid mb-4">
        <div class="admin-detail-item"><dt>Risk Score</dt><dd>@Model.RiskScore.ToString("F4")</dd></div>
        <div class="admin-detail-item"><dt>Model Version</dt><dd>@(string.IsNullOrEmpty(Model.ModelVersion) ? "—" : Model.ModelVersion)</dd></div>
        <div class="admin-detail-item"><dt>Conjunction Event</dt><dd>@(Model.ConjunctionStatus ?? "—")</dd></div>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="admin-form-actions">
            <button type="submit" class="btn-ssa-danger"><i class="bi bi-trash"></i> Delete Assessment</button>
            <a asp-action="Index" class="btn-ssa-ghost">Cancel</a>
        </div>
    </form>
</div>

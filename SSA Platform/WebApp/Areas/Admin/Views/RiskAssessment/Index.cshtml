@model IEnumerable<App.Domain.Entities.RiskAssessment>

@{
    ViewData["Title"] = "Risk Assessments";
}

<link rel="stylesheet" href="~/css/dashboard-ssa.css" asp-append-version="true" />

<div class="ssa-container">

    <div class="system-bar">
        <span class="status-dot"></span>
        ADMIN | RISK ASSESSMENTS |
        @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss") UTC |
        @Model.Count() RECORDS
    </div>

    <div class="header">
        <div>
            <h3>Risk Assessments</h3>
            <small>Risk scores and model outputs for conjunction events</small>
        </div>
        <div class="header-right">
            <a asp-action="Create" class="btn-add"><i class="bi bi-plus-lg"></i> Add Assessment</a>
        </div>
    </div>

    <div class="card">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Risk Score</th>
                    <th>Model Version</th>
                    <th>Conjunction Event</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderByDescending(r => r.RiskScore))
                {
                    <tr>
                        <td>
                            <span class="@(item.RiskScore > 0.7 ? "text-danger fw-bold" : item.RiskScore > 0.3 ? "text-warning" : "text-success")">
                                @item.RiskScore.ToString("F4")
                            </span>
                        </td>
                        <td><code>@(item.ModelVersion ?? "—")</code></td>
                        <td>
                            @if (item.ConjunctionEvent != null)
                            {
                                <a asp-area="Admin" asp-controller="ConjunctionEvent" asp-action="Details"
                                   asp-route-id="@item.ConjunctionEventId" class="text-decoration-none">
                                    @item.ConjunctionEvent.Status
                                </a>
                            }
                            else { <span class="text-muted">—</span> }
                        </td>
                        <td class="tbl-actions">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-sat btn-sat-view"><i class="bi bi-eye"></i> View</a>
                            <a asp-action="Edit"    asp-route-id="@item.Id" class="btn-sat btn-sat-edit"><i class="bi bi-pencil"></i> Edit</a>
                            <a asp-action="Delete"  asp-route-id="@item.Id" class="btn-sat btn-sat-delete"><i class="bi bi-trash"></i> Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <p>No risk assessments found.</p>
                <a asp-action="Create" class="btn-add"><i class="bi bi-plus-lg"></i> Add Assessment</a>
            </div>
        }
    </div>

</div>

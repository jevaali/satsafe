@model RiskAssessmentDetailViewModel

@{
    ViewData["Title"] = "Risk Assessment Details";
}

<div class="admin-page-header">
    <div>
        <div class="admin-page-title">Risk Assessment</div>
        <div class="admin-page-subtitle">Score: @Model.RiskScore.ToString("F4") — @Model.RiskLevel risk</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-sat btn-sat-edit"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-action="Index" class="btn-ssa-ghost"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="admin-section-heading mb-3"><i class="bi bi-graph-up"></i> Assessment Details</div>
            <dl class="admin-detail-grid">
                <div class="admin-detail-item">
                    <dt>Risk Score</dt>
                    <dd>
                        @{
                            var scoreCss = Model.RiskScore > 0.7 ? "text-danger fw-bold" : Model.RiskScore > 0.3 ? "text-warning" : "text-success";
                            var lvlCss   = Model.RiskLevel switch { "High" => "bg-danger", "Medium" => "bg-warning text-dark", _ => "bg-success" };
                        }
                        <span class="@scoreCss">@Model.RiskScore.ToString("F4")</span>
                        <span class="badge @lvlCss ms-2">@Model.RiskLevel</span>
                    </dd>
                </div>
                <div class="admin-detail-item">
                    <dt>Model Version</dt>
                    <dd><code>@(string.IsNullOrEmpty(Model.ModelVersion) ? "—" : Model.ModelVersion)</code></dd>
                </div>
                <div class="admin-detail-item">
                    <dt>Conjunction Event</dt>
                    <dd>
                        @if (Model.ConjunctionEventId.HasValue)
                        {
                            <a asp-area="Admin" asp-controller="ConjunctionEvent" asp-action="Details"
                               asp-route-id="@Model.ConjunctionEventId" class="text-decoration-none">
                                @(Model.ConjunctionStatus ?? "View Event")
                            </a>
                        }
                        else { <span class="text-muted">—</span> }
                    </dd>
                </div>
            </dl>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="admin-section-heading mb-3"><i class="bi bi-clock-history"></i> Metadata</div>
            <dl class="admin-detail-grid" style="grid-template-columns:1fr;">
                <div class="admin-detail-item"><dt>Created By</dt><dd>@(Model.CreatedBy ?? "—")</dd></div>
                <div class="admin-detail-item"><dt>Created At</dt><dd>@(Model.CreatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd></div>
            </dl>
        </div>
    </div>
</div>

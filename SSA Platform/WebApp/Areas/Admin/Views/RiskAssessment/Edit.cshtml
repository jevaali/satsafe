@model RiskAssessmentFormViewModel

@{
    ViewData["Title"] = "Edit Risk Assessment";
}

<div class="admin-page-header">
    <div>
        <div class="admin-page-title">Edit Risk Assessment</div>
        <div class="admin-page-subtitle">Update risk score and model details</div>
    </div>
    <a asp-action="Index" class="btn-ssa-ghost"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="card admin-form">
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>
        <input type="hidden" asp-for="Id" />

        <div class="form-group mb-3">
            <label asp-for="ConjunctionEventId" class="form-label"></label>
            <select asp-for="ConjunctionEventId" class="form-select" asp-items="Model.ConjunctionOptions"></select>
            <span asp-validation-for="ConjunctionEventId" class="text-danger small"></span>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="RiskScore" class="form-label"></label>
                <input asp-for="RiskScore" class="form-control" placeholder="0.0 – 1.0" />
                <span asp-validation-for="RiskScore" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ModelVersion" class="form-label"></label>
                <input asp-for="ModelVersion" class="form-control" />
                <span asp-validation-for="ModelVersion" class="text-danger small"></span>
            </div>
        </div>

        <div class="admin-form-actions">
            <button type="submit" class="btn-ssa-primary"><i class="bi bi-check-lg"></i> Save Changes</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn-ssa-ghost">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

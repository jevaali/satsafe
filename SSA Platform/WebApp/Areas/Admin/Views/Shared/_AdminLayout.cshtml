<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] — Admin · SatSafe</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
    <link rel="stylesheet" href="~/css/dashboard-ssa.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/WebApp.styles.css" asp-append-version="true"/>
</head>
<body>
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction     = ViewContext.RouteData.Values["action"]?.ToString();
    string IsActive(string ctrl, string? action = null) =>
        currentController == ctrl && (action == null || currentAction == action) ? "active" : "";
}

<div class="admin-shell">

    <!-- ── Sidebar ─────────────────────────────────────────── -->
    <aside class="admin-sidebar">
        <div class="admin-brand">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="admin-brand-name">
                <i class="bi bi-reception-4"></i>
                SatSafe
                <span class="admin-brand-badge">Admin</span>
            </a>
        </div>

        <nav class="admin-nav">
            <div class="admin-nav-section">Overview</div>
            <a asp-area="Admin" asp-controller="Home" asp-action="Index"
               class="admin-nav-link @IsActive("Home")">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>

            <div class="admin-nav-section">Space Objects</div>
            <a asp-area="Admin" asp-controller="Satellite" asp-action="Index"
               class="admin-nav-link @IsActive("Satellite")">
                <i class="bi bi-reception-4"></i> Satellites
            </a>
            <a asp-area="Admin" asp-controller="Operator" asp-action="Index"
               class="admin-nav-link @IsActive("Operator")">
                <i class="bi bi-building"></i> Operators
            </a>
            <a asp-area="Admin" asp-controller="TleRecord" asp-action="Index"
               class="admin-nav-link @IsActive("TleRecord")">
                <i class="bi bi-file-earmark-code"></i> TLE Records
            </a>

            <div class="admin-nav-section">Events & Risk</div>
            <a asp-area="Admin" asp-controller="ConjunctionEvent" asp-action="Index"
               class="admin-nav-link @IsActive("ConjunctionEvent")">
                <i class="bi bi-exclamation-triangle"></i> Conjunction Events
            </a>
            <a asp-area="Admin" asp-controller="RiskAssessment" asp-action="Index"
               class="admin-nav-link @IsActive("RiskAssessment")">
                <i class="bi bi-bar-chart-line"></i> Risk Assessments
            </a>
            <a asp-area="Admin" asp-controller="Alert" asp-action="Index"
               class="admin-nav-link @IsActive("Alert")">
                <i class="bi bi-bell"></i> Alerts
            </a>

            <div class="admin-nav-section">Users</div>
            <a asp-area="Admin" asp-controller="UserOperator" asp-action="Index"
               class="admin-nav-link @IsActive("UserOperator")">
                <i class="bi bi-people"></i> User–Operator Links
            </a>
            <a asp-area="Admin" asp-controller="NotificationSetting" asp-action="Index"
               class="admin-nav-link @IsActive("NotificationSetting")">
                <i class="bi bi-sliders"></i> Notification Settings
            </a>
        </nav>

        <div class="admin-sidebar-footer">
            <div>Signed in as</div>
            <div><strong>@User.Identity?.Name</strong></div>
            <div class="mt-2">
                <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <button type="submit" class="nav-link btn btn-link text-dark">
                        Back to Platform
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <!-- ── Main area ────────────────────────────────────────── -->
    <div class="admin-main">

        <!-- Top bar -->
        <div class="admin-topbar">
            <nav class="admin-breadcrumb">
                <a asp-area="Admin" asp-controller="Home" asp-action="Index">Admin</a>
                @if (currentController != "Home")
                {
                    <span class="admin-breadcrumb-sep">›</span>
                    <a asp-area="Admin" asp-controller="@currentController" asp-action="Index">@currentController</a>
                }
                @if (currentAction != null && currentAction != "Index")
                {
                    <span class="admin-breadcrumb-sep">›</span>
                    <span class="admin-breadcrumb-current">@currentAction</span>
                }
            </nav>

            <div class="admin-topbar-right">
                <span class="admin-user-badge">
                    @(User.Identity?.Name?.FirstOrDefault().ToString().ToUpper() ?? "A")
                </span>
                <span>@User.Identity?.Name</span>
            </div>
        </div>

        <!-- Content -->
        <div class="admin-content">
            @RenderBody()
        </div>
    </div>

</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

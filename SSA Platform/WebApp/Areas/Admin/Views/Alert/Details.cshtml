@model AlertDetailViewModel

@{
    ViewData["Title"] = "Alert Details";
}

<div class="admin-page-header">
    <div>
        <div class="admin-page-title">Alert Details</div>
        <div class="admin-page-subtitle">@Model.Severity severity alert</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-sat btn-sat-edit"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-action="Index" class="btn-ssa-ghost"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="admin-section-heading mb-3"><i class="bi bi-bell"></i> Alert Information</div>
            <dl class="admin-detail-grid">
                <div class="admin-detail-item">
                    <dt>Severity</dt>
                    <dd>
                        @{
                            var sevCss = Model.Severity switch {
                                EAlertSeverity.Critical => "bg-danger",
                                EAlertSeverity.High     => "bg-warning text-dark",
                                EAlertSeverity.Medium   => "bg-info text-dark",
                                _                       => "bg-secondary"
                            };
                        }
                        <span class="badge @sevCss">@Model.Severity</span>
                    </dd>
                </div>
                <div class="admin-detail-item">
                    <dt>Acknowledged</dt>
                    <dd>
                        @if (Model.IsAcknowledged)
                        { <span class="badge bg-success">Yes</span> }
                        else
                        { <span class="badge bg-warning text-dark">No</span> }
                    </dd>
                </div>
                <div class="admin-detail-item">
                    <dt>User</dt><dd>@Model.UserName</dd>
                </div>
                <div class="admin-detail-item">
                    <dt>User Email</dt><dd>@Model.UserEmail</dd>
                </div>
                <div class="admin-detail-item">
                    <dt>Conjunction Event</dt>
                    <dd>
                        @if (Model.ConjunctionEventId.HasValue)
                        {
                            <a asp-area="Admin" asp-controller="ConjunctionEvent" asp-action="Details"
                               asp-route-id="@Model.ConjunctionEventId" class="text-decoration-none">
                                @(Model.ConjunctionStatus ?? "View")
                            </a>
                        }
                        else { <span class="text-muted">—</span> }
                    </dd>
                </div>
                <div class="admin-detail-item">
                    <dt>Created At</dt><dd>@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Message))
                {
                    <div class="admin-detail-item" style="grid-column:1/-1;">
                        <dt>Message</dt><dd>@Model.Message</dd>
                    </div>
                }
            </dl>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="admin-section-heading mb-3"><i class="bi bi-clock-history"></i> Metadata</div>
            <dl class="admin-detail-grid" style="grid-template-columns:1fr;">
                <div class="admin-detail-item"><dt>Created By</dt><dd>@(Model.CreatedBy ?? "—")</dd></div>
                <div class="admin-detail-item"><dt>Updated At</dt><dd>@(Model.UpdatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd></div>
            </dl>
        </div>
    </div>
</div>

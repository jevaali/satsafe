@model AlertIndexViewModel

@{
    ViewData["Title"] = "Alerts";
}

<div class="admin-page-header">
    <div>
        <div class="admin-page-title">Alerts</div>
        <div class="admin-page-subtitle">All system-generated alerts for conjunction events</div>
    </div>
    <a asp-action="Create" class="btn-add"><i class="bi bi-plus-lg"></i> Add Alert</a>
</div>

<div class="admin-stat-row mb-4" style="grid-template-columns:repeat(3,minmax(140px,200px));">
    <div class="admin-stat-card">
        <div class="admin-stat-icon blue"><i class="bi bi-bell"></i></div>
        <div><div class="admin-stat-value">@Model.TotalCount</div><div class="admin-stat-label">Total</div></div>
    </div>
    <div class="admin-stat-card">
        <div class="admin-stat-icon red"><i class="bi bi-bell-fill"></i></div>
        <div><div class="admin-stat-value">@Model.UnacknowledgedCount</div><div class="admin-stat-label">Unacknowledged</div></div>
    </div>
    <div class="admin-stat-card">
        <div class="admin-stat-icon orange"><i class="bi bi-exclamation-diamond"></i></div>
        <div><div class="admin-stat-value">@Model.CriticalCount</div><div class="admin-stat-label">Critical</div></div>
    </div>
</div>

<div class="card mb-3 p-3">
    <div class="d-flex gap-3 align-items-center flex-wrap">
        <select id="severityFilter" class="form-select w-auto">
            <option value="">All Severities</option>
            @foreach (var sev in Enum.GetValues<EAlertSeverity>())
            {
                <option value="@sev">@sev</option>
            }
        </select>
        <select id="ackFilter" class="form-select w-auto">
            <option value="">All</option>
            <option value="false">Unacknowledged</option>
            <option value="true">Acknowledged</option>
        </select>
    </div>
</div>

<div class="card">
    <table class="table table-hover mb-0" id="alertTable">
        <thead>
            <tr>
                <th>Severity</th>
                <th>Message</th>
                <th>User</th>
                <th>Conjunction</th>
                <th>Created</th>
                <th>Acked</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Alerts)
            {
                <tr data-severity="@item.Severity" data-ack="@item.IsAcknowledged.ToString().ToLower()">
                    <td>
                        @{
                            var sevCss = item.Severity switch {
                                EAlertSeverity.Critical => "bg-danger",
                                EAlertSeverity.High     => "bg-warning text-dark",
                                EAlertSeverity.Medium   => "bg-info text-dark",
                                _                       => "bg-secondary"
                            };
                        }
                        <span class="badge @sevCss">@item.Severity</span>
                    </td>
                    <td><small>@(item.Message.Length > 50 ? item.Message[..50] + "…" : item.Message)</small></td>
                    <td>@item.UserName</td>
                    <td>
                        @if (item.ConjunctionEventId.HasValue && item.ConjunctionStatus != null)
                        {
                            <a asp-area="Admin" asp-controller="ConjunctionEvent" asp-action="Details"
                               asp-route-id="@item.ConjunctionEventId" class="text-decoration-none">
                                @item.ConjunctionStatus
                            </a>
                        }
                        else { <span class="text-muted">—</span> }
                    </td>
                    <td><small>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small></td>
                    <td>
                        @if (item.IsAcknowledged)
                        { <span class="badge bg-success">Yes</span> }
                        else
                        { <span class="badge bg-warning text-dark">No</span> }
                    </td>
                    <td class="tbl-actions">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn-sat btn-sat-view"><i class="bi bi-eye"></i> View</a>
                        <a asp-action="Edit"    asp-route-id="@item.Id" class="btn-sat btn-sat-edit"><i class="bi bi-pencil"></i> Edit</a>
                        <a asp-action="Delete"  asp-route-id="@item.Id" class="btn-sat btn-sat-delete"><i class="bi bi-trash"></i> Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Alerts.Any())
    {
        <div class="empty-state"><p>No alerts found.</p></div>
    }
</div>

@section Scripts {
    <script>
        const sevFilter = document.getElementById('severityFilter');
        const ackFilter = document.getElementById('ackFilter');
        const rows = document.querySelectorAll('#alertTable tbody tr');
        function applyFilters() {
            const sev = sevFilter.value.toLowerCase();
            const ack = ackFilter.value.toLowerCase();
            rows.forEach(row => {
                const matchSev = !sev || row.dataset.severity.toLowerCase() === sev;
                const matchAck = !ack || row.dataset.ack === ack;
                row.style.display = matchSev && matchAck ? '' : 'none';
            });
        }
        sevFilter.addEventListener('change', applyFilters);
        ackFilter.addEventListener('change', applyFilters);
    </script>
}

@model App.Domain.Entities.Alert

@{
    ViewData["Title"] = "Delete Alert";
}

<link rel="stylesheet" href="~/css/dashboard-ssa.css" asp-append-version="true" />

<div class="ssa-container">

    <div class="system-bar">
        <span class="status-dot"></span>
        ADMIN | ALERTS | DELETE
    </div>

    <div class="header">
        <div>
            <h3>Delete Alert</h3>
            <small>Confirm permanent removal</small>
        </div>
        <div>
            <a asp-action="Index" class="btn-ssa-ghost"><i class="bi bi-arrow-left"></i> Back</a>
        </div>
    </div>

    <div class="card">
        <div class="delete-warning">
            <i class="bi bi-exclamation-triangle-fill delete-warning-icon"></i>
            <div>
                <div class="delete-warning-title">This action cannot be undone</div>
                <div class="delete-warning-text">Deleting this alert will remove the record permanently.</div>
            </div>
        </div>

        <dl class="admin-detail-grid" style="margin-bottom:1.5rem;">
            <div class="admin-detail-item">
                <dt>@Html.DisplayNameFor(m => m.Severity)</dt>
                <dd>@Model.Severity</dd>
            </div>
            <div class="admin-detail-item">
                <dt>@Html.DisplayNameFor(m => m.IsAcknowledged)</dt>
                <dd>@(Model.IsAcknowledged ? "Yes" : "No")</dd>
            </div>
            <div class="admin-detail-item">
                <dt>User</dt>
                <dd>@(Model.User != null ? $"{Model.User.FirstName} {Model.User.LastName}".Trim() : "—")</dd>
            </div>
            <div class="admin-detail-item">
                <dt>Conjunction Event</dt>
                <dd>@(Model.ConjunctionEvent?.Status.ToString() ?? "—")</dd>
            </div>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="admin-form-actions">
                <button type="submit" class="btn-ssa-danger"><i class="bi bi-trash"></i> Delete Alert</button>
                <a asp-action="Index" class="btn-ssa-ghost">Cancel</a>
            </div>
        </form>
    </div>

</div>

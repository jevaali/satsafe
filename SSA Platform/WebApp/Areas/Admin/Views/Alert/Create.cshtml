@model AlertFormViewModel

@{
    ViewData["Title"] = "Add Alert";
}

<div class="admin-page-header">
    <div>
        <div class="admin-page-title">Add Alert</div>
        <div class="admin-page-subtitle">Create a new alert record</div>
    </div>
    <a asp-action="Index" class="btn-ssa-ghost"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="card admin-form">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

        <div class="form-group mb-3">
            <label asp-for="Severity" class="control-label"></label>
            <select asp-for="Severity" class="form-select"
                    asp-items="Html.GetEnumSelectList<EAlertSeverity>()"></select>
            <span asp-validation-for="Severity" class="text-danger small"></span>
        </div>
        <div class="form-group mb-3">
            <label asp-for="UserId" class="control-label"></label>
            <select asp-for="UserId" class="form-select" asp-items="Model.UserOptions"></select>
            <span asp-validation-for="UserId" class="text-danger small"></span>
        </div>
        <div class="form-group mb-3">
            <label asp-for="ConjunctionEventId" class="control-label"></label>
            <select asp-for="ConjunctionEventId" class="form-select" asp-items="Model.ConjunctionOptions"></select>
            <span asp-validation-for="ConjunctionEventId" class="text-danger small"></span>
        </div>
        <div class="form-group mb-3">
            <div class="form-check">
                <input class="form-check-input" asp-for="IsAcknowledged" />
                <label class="form-check-label" asp-for="IsAcknowledged">Already acknowledged</label>
            </div>
        </div>

        <div class="admin-form-actions">
            <button type="submit" class="btn-ssa-primary"><i class="bi bi-check-lg"></i> Create Alert</button>
            <a asp-action="Index" class="btn-ssa-ghost">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

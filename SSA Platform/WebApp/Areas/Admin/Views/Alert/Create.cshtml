@model App.Domain.Entities.Alert

@{
    ViewData["Title"] = "Add Alert";
}

<link rel="stylesheet" href="~/css/dashboard-ssa.css" asp-append-version="true" />

<div class="ssa-container">

    <div class="system-bar">
        <span class="status-dot"></span>
        ADMIN | ALERTS | NEW ALERT
    </div>

    <div class="header">
        <div>
            <h3>Add Alert</h3>
            <small>Create a new alert record</small>
        </div>
        <div>
            <a asp-action="Index" class="btn-ssa-ghost"><i class="bi bi-arrow-left"></i> Back</a>
        </div>
    </div>

    <div class="card admin-form">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group">
                <label asp-for="Severity" class="control-label"></label>
                <input asp-for="Severity" class="form-control" />
                <span asp-validation-for="Severity" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="UserId" class="control-label"></label>
                <select asp-for="UserId" class="form-control" asp-items="ViewBag.UserId"></select>
            </div>
            <div class="form-group">
                <label asp-for="ConjunctionEventId" class="control-label"></label>
                <select asp-for="ConjunctionEventId" class="form-control" asp-items="ViewBag.ConjunctionEventId"></select>
            </div>
            <div class="form-group">
                <div class="form-check mt-1">
                    <input class="form-check-input" asp-for="IsAcknowledged" />
                    <label class="form-check-label" asp-for="IsAcknowledged">@Html.DisplayNameFor(m => m.IsAcknowledged)</label>
                </div>
            </div>

            <div class="admin-form-actions">
                <button type="submit" class="btn-ssa-primary"><i class="bi bi-check-lg"></i> Create Alert</button>
                <a asp-action="Index" class="btn-ssa-ghost">Cancel</a>
            </div>
        </form>
    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

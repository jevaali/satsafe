@model AdminDashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="admin-page-header">
    <div>
        <div class="admin-page-title">Platform Dashboard</div>
        <div class="admin-page-subtitle">
            <span class="status-dot"></span>
            Live data &mdash; @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm") UTC
        </div>
    </div>
</div>

<!-- ── Stat cards ─────────────────────────────────────── -->
<div class="admin-stat-row">
    <div class="admin-stat-card">
        <div class="admin-stat-icon blue"><i class="bi bi-reception-4"></i></div>
        <div>
            <div class="admin-stat-value">@Model.TotalSatellites</div>
            <div class="admin-stat-label">Total Satellites</div>
        </div>
    </div>
    <div class="admin-stat-card">
        <div class="admin-stat-icon green"><i class="bi bi-check-circle"></i></div>
        <div>
            <div class="admin-stat-value">@Model.ActiveSatellites</div>
            <div class="admin-stat-label">Active Satellites</div>
        </div>
    </div>
    <div class="admin-stat-card">
        <div class="admin-stat-icon teal"><i class="bi bi-building"></i></div>
        <div>
            <div class="admin-stat-value">@Model.TotalOperators</div>
            <div class="admin-stat-label">Operators</div>
        </div>
    </div>
    <div class="admin-stat-card">
        <div class="admin-stat-icon orange"><i class="bi bi-exclamation-triangle"></i></div>
        <div>
            <div class="admin-stat-value">@Model.TotalConjunctions</div>
            <div class="admin-stat-label">Conjunctions</div>
        </div>
    </div>
    <div class="admin-stat-card">
        <div class="admin-stat-icon red"><i class="bi bi-shield-exclamation"></i></div>
        <div>
            <div class="admin-stat-value">@Model.HighRiskEvents</div>
            <div class="admin-stat-label">High-Risk Events</div>
        </div>
    </div>
    <div class="admin-stat-card">
        <div class="admin-stat-icon red"><i class="bi bi-bell-fill"></i></div>
        <div>
            <div class="admin-stat-value">@Model.UnacknowledgedAlerts</div>
            <div class="admin-stat-label">Unacked Alerts</div>
        </div>
    </div>
    <div class="admin-stat-card">
        <div class="admin-stat-icon purple"><i class="bi bi-people"></i></div>
        <div>
            <div class="admin-stat-value">@Model.TotalUsers</div>
            <div class="admin-stat-label">Platform Users</div>
        </div>
    </div>
    <div class="admin-stat-card">
        <div class="admin-stat-icon blue"><i class="bi bi-file-earmark-code"></i></div>
        <div>
            <div class="admin-stat-value">@Model.TotalTleRecords</div>
            <div class="admin-stat-label">TLE Records</div>
        </div>
    </div>
</div>

<!-- ── Two-column lower section ───────────────────────── -->
<div class="row g-4">

    <!-- Recent Conjunction Events -->
    <div class="col-lg-7">
        <div class="admin-section-heading">
            <i class="bi bi-exclamation-triangle"></i> Recent Conjunction Events
            <a asp-area="Admin" asp-controller="ConjunctionEvent" asp-action="Index"
               class="ms-auto btn-sat btn-sat-view" style="font-size:0.7rem;">View all</a>
        </div>
        <div class="card">
            @if (Model.RecentEvents.Any())
            {
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Primary</th>
                            <th>Secondary</th>
                            <th>TCA</th>
                            <th>Miss Dist.</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model.RecentEvents)
                        {
                            <tr class="@(e.IsHighRisk ? "table-danger" : "")">
                                <td><strong>@e.PrimaryObject</strong></td>
                                <td><strong>@e.SecondaryObject</strong></td>
                                <td><small>@e.Tca.ToString("MM-dd HH:mm")</small></td>
                                <td>
                                    <span class="@(e.MissDistance < 1000 ? "text-danger fw-bold" : "")">
                                        @(e.MissDistance < 1000 ? $"{e.MissDistance:N0} m" : $"{e.MissDistance / 1000:F1} km")
                                    </span>
                                </td>
                                <td>
                                    @{
                                        var statusCss = e.Status switch {
                                            "Pending"  => "bg-warning text-dark",
                                            "Resolved" => "bg-success",
                                            "Imminent" => "bg-danger",
                                            _          => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @statusCss">@e.Status</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state"><p>No conjunction events found.</p></div>
            }
        </div>
    </div>

    <!-- Recent Alerts -->
    <div class="col-lg-5">
        <div class="admin-section-heading">
            <i class="bi bi-bell"></i> Recent Alerts
            <a asp-area="Admin" asp-controller="Alert" asp-action="Index"
               class="ms-auto btn-sat btn-sat-view" style="font-size:0.7rem;">View all</a>
        </div>
        <div class="card">
            @if (Model.RecentAlerts.Any())
            {
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Severity</th>
                            <th>Message</th>
                            <th>Acked</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.RecentAlerts)
                        {
                            <tr>
                                <td>
                                    @{
                                        var sevCss = a.Severity switch {
                                            "Critical" => "bg-danger",
                                            "High"     => "bg-warning text-dark",
                                            "Medium"   => "bg-info text-dark",
                                            _          => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @sevCss">@a.Severity</span>
                                </td>
                                <td><small>@(a.Message.Length > 40 ? a.Message[..40] + "…" : a.Message)</small></td>
                                <td>
                                    @if (a.IsAcknowledged)
                                    { <span class="badge bg-success">Yes</span> }
                                    else
                                    { <span class="badge bg-warning text-dark">No</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state"><p>No alerts found.</p></div>
            }
        </div>

        <!-- Quick stats summary -->
        <div class="mt-3 card p-3">
            <div class="admin-section-heading mb-2"><i class="bi bi-lightning"></i> Quick Links</div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-area="Admin" asp-controller="Satellite" asp-action="Create" class="btn-sat btn-sat-view">
                    <i class="bi bi-plus"></i> Add Satellite
                </a>
                <a asp-area="Admin" asp-controller="Operator" asp-action="Create" class="btn-sat btn-sat-view">
                    <i class="bi bi-plus"></i> Add Operator
                </a>
                <a asp-area="Admin" asp-controller="ConjunctionEvent" asp-action="Create" class="btn-sat btn-sat-view">
                    <i class="bi bi-plus"></i> Add Event
                </a>
                <a asp-area="Admin" asp-controller="UserOperator" asp-action="Create" class="btn-sat btn-sat-view">
                    <i class="bi bi-plus"></i> Link User
                </a>
            </div>
        </div>
    </div>

</div>

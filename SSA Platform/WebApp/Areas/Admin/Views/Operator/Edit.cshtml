@model OperatorFormViewModel
@using App.Domain.Entities.Enums

@{
    ViewData["Title"] = "Edit Operator";
}

<div class="admin-page-header">
    <div>
        <div class="admin-page-title">Edit Operator</div>
        <div class="admin-page-subtitle">Update record — @Model.Name</div>
    </div>
    <a asp-action="Index" class="btn-ssa-ghost"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="card admin-form">
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>
        <input type="hidden" asp-for="Id" />

        <div class="form-group mb-3">
            <label asp-for="Name" class="control-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="CountryCode" class="control-label"></label>
            <input id="country-search" type="text" class="form-control mb-1"
                   placeholder="Search country…" autocomplete="off" />
            <select asp-for="CountryCode" id="country-select" class="form-select"
                    asp-items="Model.CountryOptions"></select>
            <span asp-validation-for="CountryCode" class="text-danger small"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="OperatorType" class="control-label"></label>
            <select asp-for="OperatorType" class="form-select"
                    asp-items="Html.GetEnumSelectList<EOperatorType>()">
                <option value="">— Select type —</option>
            </select>
            <span asp-validation-for="OperatorType" class="text-danger small"></span>
        </div>

        <div class="admin-form-actions">
            <button type="submit" class="btn-ssa-primary"><i class="bi bi-check-lg"></i> Save Changes</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn-ssa-ghost">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            const search = document.getElementById('country-search');
            const select = document.getElementById('country-select');
            const allOptions = Array.from(select.options);
            search.addEventListener('input', function () {
                const q = this.value.toLowerCase();
                select.innerHTML = '';
                allOptions.filter(o => o.text.toLowerCase().includes(q))
                    .forEach(o => select.appendChild(o));
            });
        })();
    </script>
}

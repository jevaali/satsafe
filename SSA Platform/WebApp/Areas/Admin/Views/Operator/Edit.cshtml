@using App.Domain.Entities.Enums
@model App.Domain.Entities.Operator

@{
    ViewData["Title"] = "Edit Operator";
}

<link rel="stylesheet" href="~/css/dashboard-ssa.css" asp-append-version="true" />

<div class="ssa-container">

    <div class="system-bar">
        <span class="status-dot"></span>
        ADMIN | OPERATOR REGISTRY | EDIT
    </div>

    <div class="header">
        <div>
            <h3>Edit Operator</h3>
            <small>Update operator details</small>
        </div>
        <div>
            <a asp-action="Index" class="btn-ssa-ghost"><i class="bi bi-arrow-left"></i> Back</a>
        </div>
    </div>

    <div class="card admin-form">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CountryCode" class="control-label"></label>
                <input id="country-search" type="text" class="form-control mb-1"
                       placeholder="Search country…" autocomplete="off" />
                <select asp-for="CountryCode" id="country-select"
                        class="form-select" asp-items="ViewBag.Countries">
                </select>
                <span asp-validation-for="CountryCode" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="OperatorType" class="control-label"></label>
                <select asp-for="OperatorType" class="form-select"
                        asp-items="Html.GetEnumSelectList<EOperatorType>()">
                    <option value="">— Select type —</option>
                </select>
                <span asp-validation-for="OperatorType" class="text-danger"></span>
            </div>

            <input type="hidden" asp-for="Id" />

            <div class="admin-form-actions">
                <button type="submit" class="btn-ssa-primary"><i class="bi bi-check-lg"></i> Save Changes</button>
                <a asp-action="Index" class="btn-ssa-ghost">Cancel</a>
            </div>
        </form>
    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            const search = document.getElementById('country-search');
            const select = document.getElementById('country-select');
            const allOptions = Array.from(select.options);

            search.addEventListener('input', function () {
                const q = this.value.toLowerCase();
                select.innerHTML = '';
                allOptions
                    .filter(o => o.text.toLowerCase().includes(q))
                    .forEach(o => select.appendChild(o));
                if (select.options.length > 0 && !select.value)
                    select.selectedIndex = 0;
            });
        })();
    </script>
}

@model OperatorDetailViewModel

@{
    ViewData["Title"] = "Operator Details";
}

<div class="admin-page-header">
    <div>
        <div class="admin-page-title">@Model.Name</div>
        <div class="admin-page-subtitle">Space operator record</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-sat btn-sat-edit"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-action="Index" class="btn-ssa-ghost"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card">
            <div class="admin-section-heading mb-3"><i class="bi bi-building"></i> Organisation Details</div>
            <dl class="admin-detail-grid">
                <div class="admin-detail-item"><dt>Name</dt><dd>@Model.Name</dd></div>
                <div class="admin-detail-item"><dt>Country Code</dt><dd>@Model.CountryCode</dd></div>
                <div class="admin-detail-item"><dt>Operator Type</dt><dd>@(Model.OperatorType ?? "—")</dd></div>
                <div class="admin-detail-item"><dt>Satellites</dt><dd>@Model.SatelliteCount</dd></div>
                <div class="admin-detail-item"><dt>Linked Users</dt><dd>@Model.UserCount</dd></div>
            </dl>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card">
            <div class="admin-section-heading mb-3"><i class="bi bi-clock-history"></i> Metadata</div>
            <dl class="admin-detail-grid" style="grid-template-columns:1fr 1fr;">
                <div class="admin-detail-item"><dt>Created By</dt><dd>@(Model.CreatedBy ?? "—")</dd></div>
                <div class="admin-detail-item"><dt>Created At</dt><dd>@(Model.CreatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd></div>
                <div class="admin-detail-item"><dt>Updated By</dt><dd>@(Model.UpdatedBy ?? "—")</dd></div>
                <div class="admin-detail-item"><dt>Updated At</dt><dd>@(Model.UpdatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd></div>
            </dl>
        </div>
    </div>
</div>

@model App.Domain.Entities.Operator

@{
    ViewData["Title"] = "Operator Details";
}

<link rel="stylesheet" href="~/css/dashboard-ssa.css" asp-append-version="true" />

<div class="ssa-container">

    <div class="system-bar">
        <span class="status-dot"></span>
        ADMIN | OPERATOR REGISTRY | DETAILS
    </div>

    <div class="header">
        <div>
            <h3>@Model.Name</h3>
            <small>Operator record</small>
        </div>
        <div style="display:flex;gap:0.5rem;">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-sat btn-sat-edit"><i class="bi bi-pencil"></i> Edit</a>
            <a asp-action="Index" class="btn-ssa-ghost"><i class="bi bi-arrow-left"></i> Back</a>
        </div>
    </div>

    <div class="card">
        <dl class="admin-detail-grid">
            <div class="admin-detail-item">
                <dt>@Html.DisplayNameFor(m => m.Name)</dt>
                <dd>@Model.Name</dd>
            </div>
            <div class="admin-detail-item">
                <dt>@Html.DisplayNameFor(m => m.Country)</dt>
                <dd>@Model.Country</dd>
            </div>
            <div class="admin-detail-item">
                <dt>@Html.DisplayNameFor(m => m.OperatorType)</dt>
                <dd>@(Model.OperatorType?.ToString() ?? "—")</dd>
            </div>
            <div class="admin-detail-item">
                <dt>Satellites</dt>
                <dd>@Model.Satellites.Count</dd>
            </div>
            <div class="admin-detail-item">
                <dt>Users</dt>
                <dd>@Model.UserOperators.Count</dd>
            </div>
        </dl>
    </div>

</div>

@model IEnumerable<App.Domain.Entities.Operator>
@using App.Domain.Entities.Enums

@{
    ViewData["Title"] = "Operators";
}

<link rel="stylesheet" href="~/css/dashboard-ssa.css" asp-append-version="true" />

<div class="ssa-container">

    <div class="system-bar">
        <span class="status-dot"></span>
        ADMIN | OPERATOR REGISTRY |
        @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss") UTC |
        @Model.Count() OPERATORS
    </div>

    <div class="header">
        <div>
            <h3>Operator Registry</h3>
            <small>All registered space operators and their organisations</small>
        </div>
        <div class="header-right">
            <a asp-action="Create" class="btn-add"><i class="bi bi-plus-lg"></i> Add Operator</a>
        </div>
    </div>

    <div class="card">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Country</th>
                    <th>Type</th>
                    <th>Satellites</th>
                    <th>Users</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderBy(o => o.Name.ToString()))
                {
                    <tr>
                        <td><strong>@item.Name</strong></td>
                        <td>@item.CountryCode</td>
                        <td>
                            @if (item.OperatorType.HasValue)
                            {
                                <span class="badge bg-secondary">@item.OperatorType</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>@item.Satellites.Count</td>
                        <td>@item.UserOperators.Count</td>
                        <td class="text-nowrap">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Details</a>
                            <a asp-action="Edit"    asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <a asp-action="Delete"  asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <p>No operators registered yet.</p>
                <a asp-action="Create" class="btn-add"><i class="bi bi-plus-lg"></i> Add Operator</a>
            </div>
        }
    </div>

</div>
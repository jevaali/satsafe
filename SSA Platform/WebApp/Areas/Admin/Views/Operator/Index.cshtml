@model OperatorIndexViewModel

@{
    ViewData["Title"] = "Operators";
}

<div class="admin-page-header">
    <div>
        <div class="admin-page-title">Operator Registry</div>
        <div class="admin-page-subtitle">All registered space operators and organisations — @Model.TotalCount total</div>
    </div>
    <a asp-action="Create" class="btn-add"><i class="bi bi-plus-lg"></i> Add Operator</a>
</div>

<div class="card">
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>Name</th>
                <th>Country</th>
                <th>Type</th>
                <th>Satellites</th>
                <th>Users</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Operators)
            {
                <tr>
                    <td><strong>@item.Name</strong></td>
                    <td>@item.CountryCode</td>
                    <td>
                        @if (item.OperatorType != null)
                        {
                            <span class="badge bg-secondary">@item.OperatorType</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td>@item.SatelliteCount</td>
                    <td>@item.UserCount</td>
                    <td class="tbl-actions">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn-sat btn-sat-view"><i class="bi bi-eye"></i> View</a>
                        <a asp-action="Edit"    asp-route-id="@item.Id" class="btn-sat btn-sat-edit"><i class="bi bi-pencil"></i> Edit</a>
                        <a asp-action="Delete"  asp-route-id="@item.Id" class="btn-sat btn-sat-delete"><i class="bi bi-trash"></i> Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Operators.Any())
    {
        <div class="empty-state"><p>No operators registered yet.</p></div>
    }
</div>

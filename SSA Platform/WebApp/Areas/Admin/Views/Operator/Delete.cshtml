@model OperatorDeleteViewModel

@{
    ViewData["Title"] = "Delete Operator";
}

<div class="admin-page-header">
    <div>
        <div class="admin-page-title">Delete Operator</div>
        <div class="admin-page-subtitle">Confirm removal of @Model.Name</div>
    </div>
    <a asp-action="Index" class="btn-ssa-ghost"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="card admin-form">
    <div class="delete-warning">
        <i class="bi bi-exclamation-triangle-fill delete-warning-icon"></i>
        <div>
            <div class="delete-warning-title">This action cannot be undone</div>
            <div class="delete-warning-text">
                Deleting this operator will permanently remove the record.
                @if (Model.SatelliteCount > 0)
                {
                    <strong>Warning: this operator has @Model.SatelliteCount satellite(s).</strong>
                }
            </div>
        </div>
    </div>

    <dl class="admin-detail-grid mb-4">
        <div class="admin-detail-item"><dt>Name</dt><dd>@Model.Name</dd></div>
        <div class="admin-detail-item"><dt>Country</dt><dd>@Model.CountryCode</dd></div>
        <div class="admin-detail-item"><dt>Type</dt><dd>@(Model.OperatorType ?? "—")</dd></div>
        <div class="admin-detail-item"><dt>Satellites</dt><dd>@Model.SatelliteCount</dd></div>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="admin-form-actions">
            <button type="submit" class="btn-ssa-danger"><i class="bi bi-trash"></i> Delete Operator</button>
            <a asp-action="Index" class="btn-ssa-ghost">Cancel</a>
        </div>
    </form>
</div>

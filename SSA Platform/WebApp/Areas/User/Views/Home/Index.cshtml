@model List<App.Application.DTO.DraftSatelliteDto>
@{
    ViewData["Title"] = "My Drafts";
}

<link rel="stylesheet" href="~/css/dashboard-ssa.css" asp-append-version="true" />

<div class="ssa-container">

    <div class="system-bar">
        <span class="status-dot"></span>
        MY DRAFT SATELLITES — @Model.Count SAVED
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Header row -->
    <div class="header">
        <div>
            <h3><i class="bi bi-collection-fill me-2"></i>My Draft Satellites</h3>
            <small>Design orbits in the sandbox and save them here</small>
        </div>
        <div class="header-right">
            <a asp-area="" asp-controller="Sandbox" asp-action="Index" class="btn-ssa-primary">
                <i class="bi bi-diagram-3 me-1"></i> Open Orbital Designer
            </a>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="card">
            <div style="padding: 3rem; text-align: center; color: #5a7a9a;">
                <i class="bi bi-stars" style="font-size: 2.5rem; display: block; margin-bottom: 1rem; color: #2a4a6a;"></i>
                <div style="font-family: 'Share Tech Mono', monospace; font-size: 0.85rem; margin-bottom: 0.5rem; color: #8a9bb0;">
                    No drafts yet
                </div>
                <div style="font-size: 0.8rem; margin-bottom: 1.5rem;">
                    Head to the Orbital Designer to design your first satellite orbit and save it as a draft.
                </div>
                <a asp-area="" asp-controller="Sandbox" asp-action="Index" class="btn-ssa-primary">
                    <i class="bi bi-diagram-3 me-1"></i> Open Orbital Designer
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <table class="op-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Orbit Type</th>
                        <th>Altitude</th>
                        <th>Semi-Major Axis</th>
                        <th>Eccentricity</th>
                        <th>Inclination</th>
                        <th>Saved</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.OrderByDescending(d => d.CreatedAt))
                    {
                        <tr>
                            <td class="fw-semibold" style="font-family: 'Share Tech Mono', monospace; font-size: 0.85rem;">
                                <i class="bi bi-stars me-1" style="color: #4a90d9;"></i>@d.Name
                            </td>
                            <td>
                                <span class="op-badge @(d.OrbitType == "LEO" ? "resolved" : d.OrbitType == "MEO" ? "medium" : d.OrbitType == "GEO" ? "high" : "low")">
                                    @d.OrbitType
                                </span>
                            </td>
                            <td style="font-family: 'Share Tech Mono', monospace; font-size: 0.82rem;">
                                @d.AltitudeKm.ToString("N0") km
                            </td>
                            <td style="font-family: 'Share Tech Mono', monospace; font-size: 0.82rem; color: #8a9bb0;">
                                @d.SemiMajorAxis.ToString("N0") km
                            </td>
                            <td style="font-family: 'Share Tech Mono', monospace; font-size: 0.82rem; color: #8a9bb0;">
                                @d.Eccentricity.ToString("F4")
                            </td>
                            <td style="font-family: 'Share Tech Mono', monospace; font-size: 0.82rem; color: #8a9bb0;">
                                @d.Inclination.ToString("F1")°
                            </td>
                            <td style="font-size: 0.78rem; color: #5a7a9a;">
                                @d.CreatedAt.ToString("yyyy-MM-dd")
                            </td>
                            <td class="text-end" style="white-space: nowrap;">
                                <a asp-area="" asp-controller="Sandbox" asp-action="Index" asp-route-draftId="@d.Id"
                                   class="btn-sat btn-sat-view">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <form asp-area="User" asp-controller="Home" asp-action="Delete" method="post"
                                      style="display:inline;" onsubmit="return confirm('Delete this draft?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@d.Id" />
                                    <button type="submit" class="btn-sat btn-sat-delete">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Any(d => d.Notes != null))
        {
            <div style="margin-top: 0.5rem; font-size: 0.72rem; color: #3a5570; font-family: 'Share Tech Mono', monospace;">
                * Click <strong>Edit</strong> to open a draft in the Orbital Designer
            </div>
        }
    }

</div>
